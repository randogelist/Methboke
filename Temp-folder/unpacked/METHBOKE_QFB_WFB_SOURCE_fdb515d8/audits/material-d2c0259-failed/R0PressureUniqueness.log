  {u v : SingularClosure.Velocity} {p q : SingularClosure.Pressure} {I : Set.{0} ℝ},
  IsOpen.{0} I →
    (∀ (t : ℝ), Membership.mem.{0, 0} I t → Eq.{1} (u t) (v t)) →
      (∀ (t : ℝ),
          Membership.mem.{0, 0} I t →
            ∀ (x : SingularClosure.Vec),
              Eq.{1}
                (HAdd.hAdd.{0, 0, 0}
                  (HAdd.hAdd.{0, 0, 0} (SingularClosure.timeDerivative u t x) (SingularClosure.convection (u t) x))
                  (SingularClosure.gradient (p t) x))
                (HSMul.hSMul.{0, 0, 0} ν (SingularClosure.laplacian (u t) x))) →
        (∀ (t : ℝ),
            Membership.mem.{0, 0} I t →
              ∀ (x : SingularClosure.Vec),
                Eq.{1}
                  (HAdd.hAdd.{0, 0, 0}
                    (HAdd.hAdd.{0, 0, 0} (SingularClosure.timeDerivative v t x) (SingularClosure.convection (v t) x))
                    (SingularClosure.gradient (q t) x))
                  (HSMul.hSMul.{0, 0, 0} ν (SingularClosure.laplacian (v t) x))) →
          ContDiffOn.{0, 0, 0} ℝ ∞ (fun z => p z.1 z.2) (Set.ofPred.{0} fun z => Membership.mem.{0, 0} I z.1) →
            ContDiffOn.{0, 0, 0} ℝ ∞ (fun z => q z.1 z.2) (Set.ofPred.{0} fun z => Membership.mem.{0, 0} I z.1) →
              (∀ (t : ℝ), Membership.mem.{0, 0} I t → SingularClosure.PressureMeanZero (p t)) →
                (∀ (t : ℝ), Membership.mem.{0, 0} I t → SingularClosure.PressureMeanZero (q t)) →
                  ∀ (t : ℝ), Membership.mem.{0, 0} I t → Eq.{1} (p t) (q t)
TYPE_END:MethbokeAddon.WeakFouriermanB.normalized_pressure_eq_on_jointly_smooth_velocity_overlap
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.normalized_pressure_eq_on_jointly_smooth_velocity_overlap
'MethbokeAddon.WeakFouriermanB.normalized_pressure_eq_on_jointly_smooth_velocity_overlap' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
