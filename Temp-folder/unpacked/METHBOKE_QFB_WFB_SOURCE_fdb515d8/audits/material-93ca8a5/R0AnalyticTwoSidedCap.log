TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.analytic_two_sided_cap_admission
MethbokeAddon.WeakFouriermanB.analytic_two_sided_cap_admission : ∀ (ν ε T : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  LT.lt.{0} 0 ν →
    LT.lt.{0} 0 ε →
      LT.lt.{0} (QuasiFeffermanB.cutoff (SingularClosure.criticalL2Representative.{0} a) ν) T →
        MethbokeAddon.WeakFouriermanB.AnalyticTwoSidedNSECap ν ε T a u p →
          ∃ U P,
            SingularClosure.GlobalSmoothNSE ν a U P ∧
              ∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ico.{0} 0 T) r → Eq.{1} (U r) (u r) ∧ Eq.{1} (P r) (p r)
TYPE_END:MethbokeAddon.WeakFouriermanB.analytic_two_sided_cap_admission
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.analytic_two_sided_cap_admission
'MethbokeAddon.WeakFouriermanB.analytic_two_sided_cap_admission' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.analytic_two_sided_cap_admission
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.analytic_two_sided_cap_admission_physical_cutoff
MethbokeAddon.WeakFouriermanB.analytic_two_sided_cap_admission_physical_cutoff : ∀ (ν ε T : ℝ)
  (a : SingularClosure.Field) (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  LT.lt.{0} 0 ν →
    LT.lt.{0} 0 ε →
      LT.lt.{0}
          (HDiv.hDiv.{0, 0, 0} (HPow.hPow.{0, 0, 0} (SingularClosure.physicalEnergy a) 2)
            (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 8 (HPow.hPow.{0, 0, 0} Real.pi 2)) (HPow.hPow.{0, 0, 0} ν 5)))
          T →
        MethbokeAddon.WeakFouriermanB.AnalyticTwoSidedNSECap ν ε T a u p →
          ∃ U P,
            SingularClosure.GlobalSmoothNSE ν a U P ∧
              ∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ico.{0} 0 T) r → Eq.{1} (U r) (u r) ∧ Eq.{1} (P r) (p r)
TYPE_END:MethbokeAddon.WeakFouriermanB.analytic_two_sided_cap_admission_physical_cutoff
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.analytic_two_sided_cap_admission_physical_cutoff
