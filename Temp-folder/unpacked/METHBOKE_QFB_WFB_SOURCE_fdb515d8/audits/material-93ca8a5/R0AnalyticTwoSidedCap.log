TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.analytic_cap_forward_timeDerivative_eq_deriv
MethbokeAddon.WeakFouriermanB.analytic_cap_forward_timeDerivative_eq_deriv : ∀ (ε T : ℝ) (u : SingularClosure.Velocity),
  AnalyticOnNhd.{0, 0, 0} ℝ (fun z => u z.1 z.2) (MethbokeAddon.WeakFouriermanB.analyticCapSpacetime ε T) →
    ∀ (t : ℝ),
      Membership.mem.{0, 0} (Set.Ioo.{0} (Neg.neg.{0} ε) T) t →
        LE.le.{0} 0 t →
          ∀ (x : SingularClosure.Vec), Eq.{1} (SingularClosure.timeDerivative u t x) (deriv.{0, 0} (fun r => u r x) t)
TYPE_END:MethbokeAddon.WeakFouriermanB.analytic_cap_forward_timeDerivative_eq_deriv
