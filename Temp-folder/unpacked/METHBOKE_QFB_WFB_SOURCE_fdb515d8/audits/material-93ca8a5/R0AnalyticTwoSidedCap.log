TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.analytic_cap_time_differentiableAt
MethbokeAddon.WeakFouriermanB.analytic_cap_time_differentiableAt : ∀ (ε T : ℝ) (u : SingularClosure.Velocity),
  AnalyticOnNhd.{0, 0, 0} ℝ (fun z => u z.1 z.2) (MethbokeAddon.WeakFouriermanB.analyticCapSpacetime ε T) →
    ∀ (t : ℝ),
      Membership.mem.{0, 0} (Set.Ioo.{0} (Neg.neg.{0} ε) T) t →
        ∀ (x : SingularClosure.Vec), DifferentiableAt.{0, 0, 0} ℝ (fun r => u r x) t
TYPE_END:MethbokeAddon.WeakFouriermanB.analytic_cap_time_differentiableAt
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.analytic_cap_time_differentiableAt
