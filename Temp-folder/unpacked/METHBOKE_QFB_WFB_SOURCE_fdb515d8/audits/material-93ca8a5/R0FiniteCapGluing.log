TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.finiteCapSplice_eventually_left
@MethbokeAddon.WeakFouriermanB.finiteCapSplice_eventually_left.{u_1} : ∀ {E : Type u_1} (η : ℝ) (f g : ℝ → E) {t : ℝ},
  LT.lt.{0} t η →
    Filter.EventuallyEq.{0, u_1} (nhds.{0} t) (MethbokeAddon.WeakFouriermanB.finiteCapSplice.{u_1} η f g) f
TYPE_END:MethbokeAddon.WeakFouriermanB.finiteCapSplice_eventually_left
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.finiteCapSplice_eventually_left
'MethbokeAddon.WeakFouriermanB.finiteCapSplice_eventually_left' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.finiteCapSplice_eventually_left
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.finiteCapSplice_eventually_right
@MethbokeAddon.WeakFouriermanB.finiteCapSplice_eventually_right.{u_1} : ∀ {E : Type u_1} (δ T η : ℝ) (f g : ℝ → E),
  LT.lt.{0} η T →
    (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} δ T) r → Eq.{u_1 + 1} (f r) (g r)) →
      ∀ {t : ℝ},
        LT.lt.{0} δ t →
          Filter.EventuallyEq.{0, u_1} (nhds.{0} t) (MethbokeAddon.WeakFouriermanB.finiteCapSplice.{u_1} η f g) g
TYPE_END:MethbokeAddon.WeakFouriermanB.finiteCapSplice_eventually_right
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.finiteCapSplice_eventually_right
'MethbokeAddon.WeakFouriermanB.finiteCapSplice_eventually_right' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.finiteCapSplice_eventually_right
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.finiteCapSplice_contDiffOn
@MethbokeAddon.WeakFouriermanB.finiteCapSplice_contDiffOn.{u_1} : ∀ {E : Type u_1} [inst : NormedAddCommGroup.{u_1} E]
  [inst_1 : NormedSpace.{0, u_1} ℝ E] (δ T η : ℝ) (f g : ℝ → SingularClosure.Vec → E),
  LT.lt.{0} δ η →
    LT.lt.{0} η T →
      ContDiffOn.{0, 0, u_1} ℝ ∞ (fun z => f z.1 z.2) (MethbokeAddon.WeakFouriermanB.initialFrontSpacetime T) →
        ContDiffOn.{0, 0, u_1} ℝ ∞ (fun z => g z.1 z.2) (QuasiFeffermanB.tailSpacetime δ) →
          (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} δ T) r → Eq.{u_1 + 1} (f r) (g r)) →
            ContDiffOn.{0, 0, u_1} ℝ ∞ (fun z => MethbokeAddon.WeakFouriermanB.finiteCapSplice.{u_1} η f g z.1 z.2)
              SingularClosure.forwardSpacetime
TYPE_END:MethbokeAddon.WeakFouriermanB.finiteCapSplice_contDiffOn
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.finiteCapSplice_contDiffOn
'MethbokeAddon.WeakFouriermanB.finiteCapSplice_contDiffOn' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.finiteCapSplice_contDiffOn
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.finite_cap_splice_global_smooth
MethbokeAddon.WeakFouriermanB.finite_cap_splice_global_smooth : ∀ (ν T δ η : ℝ) (a : SingularClosure.Field)
  (u v : SingularClosure.Velocity) (p q : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    QuasiFeffermanB.ClassicalTail ν δ v q →
      LT.lt.{0} 0 η →
        LT.lt.{0} δ η →
          LT.lt.{0} η T →
            (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} δ T) r → Eq.{1} (u r) (v r)) →
              (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} δ T) r → Eq.{1} (p r) (q r)) →
                SingularClosure.GlobalSmoothNSE ν a (MethbokeAddon.WeakFouriermanB.finiteCapSplice.{0} η u v)
                  (MethbokeAddon.WeakFouriermanB.finiteCapSplice.{0} η p q)
TYPE_END:MethbokeAddon.WeakFouriermanB.finite_cap_splice_global_smooth
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.finite_cap_splice_global_smooth
'MethbokeAddon.WeakFouriermanB.finite_cap_splice_global_smooth' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.finite_cap_splice_global_smooth
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.finite_cap_gluing
MethbokeAddon.WeakFouriermanB.finite_cap_gluing : ∀ (ν T δ : ℝ) (a : SingularClosure.Field)
  (u v : SingularClosure.Velocity) (p q : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    QuasiFeffermanB.ClassicalTail ν δ v q →
      LE.le.{0} 0 δ →
        LT.lt.{0} δ T →
          (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} δ T) r → Eq.{1} (u r) (v r)) →
            (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} δ T) r → Eq.{1} (p r) (q r)) →
              ∃ U P,
                SingularClosure.GlobalSmoothNSE ν a U P ∧
                  (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ico.{0} 0 T) r → Eq.{1} (U r) (u r) ∧ Eq.{1} (P r) (p r)) ∧
                    ∀ (r : ℝ),
                      LE.le.{0} (HDiv.hDiv.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} δ T) 2) r →
                        Eq.{1} (U r) (v r) ∧ Eq.{1} (P r) (q r)
TYPE_END:MethbokeAddon.WeakFouriermanB.finite_cap_gluing
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.finite_cap_gluing
'MethbokeAddon.WeakFouriermanB.finite_cap_gluing' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.finite_cap_gluing
