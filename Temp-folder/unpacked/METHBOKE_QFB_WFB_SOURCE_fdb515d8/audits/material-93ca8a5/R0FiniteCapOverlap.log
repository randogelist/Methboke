TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.finite_cap_tail_overlap_of_same_path_ae
MethbokeAddon.WeakFouriermanB.finite_cap_tail_overlap_of_same_path_ae : ∀ (ν T δ : ℝ) (a : SingularClosure.Field)
  (u v w : SingularClosure.Velocity) (p q : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    QuasiFeffermanB.ClassicalTail ν δ v q →
      LE.le.{0} 0 δ →
        (∀ (r : ℝ),
            Membership.mem.{0, 0} (Set.Ioo.{0} δ T) r →
              w r =ᵐ[MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0} SingularClosure.unitCube]
                u r) →
          (∀ (r : ℝ),
              Membership.mem.{0, 0} (Set.Ioo.{0} δ T) r →
                w
                    r =ᵐ[MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0}
                    SingularClosure.unitCube]
                  v r) →
            (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} δ T) r → Eq.{1} (u r) (v r)) ∧
              ∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} δ T) r → Eq.{1} (p r) (q r)
TYPE_END:MethbokeAddon.WeakFouriermanB.finite_cap_tail_overlap_of_same_path_ae
