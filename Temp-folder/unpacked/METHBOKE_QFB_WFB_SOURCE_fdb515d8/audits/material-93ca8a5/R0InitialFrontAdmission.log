TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_real_cube_integral_continuousOn_Icc
MethbokeAddon.WeakFouriermanB.initial_real_cube_integral_continuousOn_Icc : ∀ (T : ℝ) (F : ℝ → SingularClosure.Vec → ℝ),
  ContinuousOn.{0, 0} (fun z => F z.1 z.2) (MethbokeAddon.WeakFouriermanB.initialFrontSpacetime T) →
    ∀ (τ : ℝ),
      LT.lt.{0} τ T →
        ContinuousOn.{0, 0} (fun r => ∫ (x : SingularClosure.Vec) in SingularClosure.unitCube, F r x) (Set.Icc.{0} 0 τ)
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_real_cube_integral_continuousOn_Icc
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.initial_real_cube_integral_continuousOn_Icc
