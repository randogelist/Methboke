TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_strong_initial_trace
MethbokeAddon.WeakFouriermanB.initial_front_strong_initial_trace : ∀ (ν T : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    LT.lt.{0} 0 T →
      Filter.Tendsto.{0, 0}
        (fun r =>
          MeasureTheory.eLpNorm.{0, 0} (HSub.hSub.{0, 0, 0} (u r) a) 2
            (MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0} SingularClosure.unitCube))
        (𝓝[>] 0) (nhds.{0} 0)
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_front_strong_initial_trace
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_strong_initial_trace
'MethbokeAddon.WeakFouriermanB.initial_front_strong_initial_trace' depends on axioms: [propext,
