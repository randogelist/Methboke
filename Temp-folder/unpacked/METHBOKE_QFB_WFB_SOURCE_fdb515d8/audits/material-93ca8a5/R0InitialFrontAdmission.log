TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_compact_serrin
MethbokeAddon.WeakFouriermanB.initial_front_compact_serrin : ∀ (ν T : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    LT.lt.{0} 0 ν →
      LT.lt.{0} 0 T →
        ∀ (τ : ℝ),
          LT.lt.{0} 0 τ →
            LT.lt.{0} τ T →
              MeasureTheory.MemLp.{0, 0} (fun r => SingularClosure.criticalSpatialNorm.{0} 6 (u r)) 4
                (MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0} (Set.Ioc.{0} 0 τ))
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_front_compact_serrin
