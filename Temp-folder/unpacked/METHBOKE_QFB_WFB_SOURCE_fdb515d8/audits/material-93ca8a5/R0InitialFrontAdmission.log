TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_compact_cylinder_continuous
MethbokeAddon.WeakFouriermanB.initial_front_compact_cylinder_continuous : ∀ (ν T : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    ∀ (τ : ℝ),
      LT.lt.{0} τ T →
        ContinuousOn.{0, 0} (fun z => u z.1 z.2) (SProd.sprod.{0, 0, 0} (Set.Icc.{0} 0 τ) SingularClosure.unitCube)
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_front_compact_cylinder_continuous
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_compact_cylinder_continuous
