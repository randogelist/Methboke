 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.initial_front_compact_serrin
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_leray_hopf_identification
MethbokeAddon.WeakFouriermanB.initial_front_leray_hopf_identification : ∀ (ν T : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure) (v : SingularClosure.Velocity)
  (G : QuasiFeffermanB.WeakGradientTrajectory),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    LT.lt.{0} 0 ν →
      LT.lt.{0} 0 T →
        SingularClosure.CriticalLerayHopf ν (SingularClosure.criticalL2Representative.{0} a) v G →
          ∀ (r : ℝ),
            Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) r →
              v r =ᵐ[MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0} SingularClosure.unitCube]
                u r
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_front_leray_hopf_identification
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_leray_hopf_identification
'MethbokeAddon.WeakFouriermanB.initial_front_leray_hopf_identification' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.initial_front_leray_hopf_identification
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_original_leray_hopf
MethbokeAddon.WeakFouriermanB.initial_front_original_leray_hopf : ∀ (ν T : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    LT.lt.{0} 0 ν →
      LT.lt.{0} 0 T →
        ∃ v G,
          SingularClosure.CriticalLerayHopf ν (SingularClosure.criticalL2Representative.{0} a) v G ∧
            v 0 =ᵐ[MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0} SingularClosure.unitCube]
                a ∧
              ∀ (r : ℝ),
                Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) r →
                  v
                      r =ᵐ[MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0}
                      SingularClosure.unitCube]
                    u r
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_front_original_leray_hopf
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_original_leray_hopf
'MethbokeAddon.WeakFouriermanB.initial_front_original_leray_hopf' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.initial_front_original_leray_hopf
