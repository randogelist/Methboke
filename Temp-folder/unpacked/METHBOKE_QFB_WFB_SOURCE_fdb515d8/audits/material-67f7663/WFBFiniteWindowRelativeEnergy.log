TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.finite_window_smooth_nse_energy_identity
MethbokeAddon.WeakFouriermanB.finite_window_smooth_nse_energy_identity : ∀ (ν : ℝ),
  LT.lt.{0} 0 ν →
    ∀ (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
      SingularClosure.CriticalPositiveSolenoidalTest u →
        ∀ (s t : ℝ),
          LT.lt.{0} 0 s →
            LE.le.{0} s t →
              (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} s t) r → ContDiff.{0, 0, 0} ℝ ∞ (p r)) →
                (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} s t) r → SingularClosure.SpatialPeriodic.{0} (p r)) →
                  (∀ (r : ℝ),
                      Membership.mem.{0, 0} (Set.Icc.{0} s t) r →
                        ∀ (x : SingularClosure.Vec),
                          Eq.{1}
                            (HAdd.hAdd.{0, 0, 0}
                              (HAdd.hAdd.{0, 0, 0} (SingularClosure.timeDerivative u r x)
                                (SingularClosure.convection (u r) x))
                              (SingularClosure.gradient (p r) x))
                            (HSMul.hSMul.{0, 0, 0} ν (SingularClosure.laplacian (u r) x))) →
                    IntervalIntegrable.{0} (fun r => SingularClosure.physicalDissipation (u r))
                        MeasureTheory.MeasureSpace.volume.{0} s t ∧
                      Eq.{1}
                        (HAdd.hAdd.{0, 0, 0} (SingularClosure.physicalEnergy (u t))
                          (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 ν)
                            (∫ (r : ℝ) in s..t, SingularClosure.physicalDissipation (u r))))
                        (SingularClosure.physicalEnergy (u s))
TYPE_END:MethbokeAddon.WeakFouriermanB.finite_window_smooth_nse_energy_identity
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.finite_window_smooth_nse_energy_identity
'MethbokeAddon.WeakFouriermanB.finite_window_smooth_nse_energy_identity' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.finite_window_smooth_nse_energy_identity
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.finite_window_lh_smooth_relative_energy_raw
MethbokeAddon.WeakFouriermanB.finite_window_lh_smooth_relative_energy_raw : ∀ (ν : ℝ),
  LT.lt.{0} 0 ν →
    ∀ (a₀ : ↥SingularClosure.CriticalPhysicalL2) (v u : SingularClosure.Velocity)
      (G :
        ℝ →
          SingularClosure.Vec →
            ContinuousLinearMap.{0, 0, 0, 0} (RingHom.id.{0} ℝ) SingularClosure.Vec SingularClosure.Vec)
      (p : SingularClosure.Pressure),
      SingularClosure.CriticalLerayHopf ν a₀ v G →
        SingularClosure.CriticalPositiveSolenoidalTest u →
          ∀ (s t : ℝ),
            LT.lt.{0} 0 s →
              LE.le.{0} s t →
                (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} s t) r → ContDiff.{0, 0, 0} ℝ ∞ (p r)) →
                  (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} s t) r → SingularClosure.SpatialPeriodic.{0} (p r)) →
                    (∀ (r : ℝ),
                        Membership.mem.{0, 0} (Set.Icc.{0} s t) r →
                          ∀ (x : SingularClosure.Vec),
                            Eq.{1}
                              (HAdd.hAdd.{0, 0, 0}
                                (HAdd.hAdd.{0, 0, 0} (SingularClosure.timeDerivative u r x)
                                  (SingularClosure.convection (u r) x))
                                (SingularClosure.gradient (p r) x))
                              (HSMul.hSMul.{0, 0, 0} ν (SingularClosure.laplacian (u r) x))) →
                      LE.le.{0}
                          (HAdd.hAdd.{0, 0, 0} (SingularClosure.physicalEnergy (v t))
                            (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 ν)
                              (∫ (r : ℝ) in s..t, SingularClosure.criticalGradientEnergy (G r))))
                          (SingularClosure.physicalEnergy (v s)) →
                        IntervalIntegrable.{0}
                            (fun r =>
                              SingularClosure.criticalGradientEnergy
                                (HSub.hSub.{0, 0, 0} (G r) (fderiv.{0, 0, 0} ℝ (u r))))
                            MeasureTheory.MeasureSpace.volume.{0} s t ∧
                          IntervalIntegrable.{0}
                              (fun r =>
                                HSub.hSub.{0, 0, 0} (SingularClosure.criticalWeakTransport (v r) (u r))
                                  (SingularClosure.physicalFieldInner (v r) (SingularClosure.convection (u r))))
                              MeasureTheory.MeasureSpace.volume.{0} s t ∧
                            LE.le.{0}
                              (HAdd.hAdd.{0, 0, 0} (SingularClosure.physicalEnergy (HSub.hSub.{0, 0, 0} (v t) (u t)))
                                (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 ν)
                                  (∫ (r : ℝ) in s..t,
                                    SingularClosure.criticalGradientEnergy
                                      (HSub.hSub.{0, 0, 0} (G r) (fderiv.{0, 0, 0} ℝ (u r))))))
                              (HSub.hSub.{0, 0, 0} (SingularClosure.physicalEnergy (HSub.hSub.{0, 0, 0} (v s) (u s)))
                                (HMul.hMul.{0, 0, 0} 2
                                  (∫ (r : ℝ) in s..t,
                                    HSub.hSub.{0, 0, 0} (SingularClosure.criticalWeakTransport (v r) (u r))
                                      (SingularClosure.physicalFieldInner (v r) (SingularClosure.convection (u r))))))
TYPE_END:MethbokeAddon.WeakFouriermanB.finite_window_lh_smooth_relative_energy_raw
