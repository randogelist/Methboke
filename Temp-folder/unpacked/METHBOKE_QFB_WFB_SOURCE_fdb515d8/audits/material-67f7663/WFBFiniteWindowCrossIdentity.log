MethbokeAddon.WeakFouriermanB.finite_window_weak_classical_cross_identity : ∀ (ν : ℝ) (v φ : SingularClosure.Velocity)
  (p : SingularClosure.Pressure),
  SingularClosure.CriticalIntegratedWeakMomentum ν v →
    SingularClosure.CriticalPositiveSolenoidalTest φ →
      ∀ (s t : ℝ),
        LT.lt.{0} 0 s →
          LE.le.{0} s t →
            (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} s t) r → ContDiff.{0, 0, 0} ℝ ∞ (p r)) →
              (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} s t) r → SingularClosure.SpatialPeriodic.{0} (p r)) →
                (∀ (r : ℝ),
                    Membership.mem.{0, 0} (Set.Icc.{0} s t) r →
                      ∀ (x : SingularClosure.Vec),
                        Eq.{1}
                          (HAdd.hAdd.{0, 0, 0}
                            (HAdd.hAdd.{0, 0, 0} (SingularClosure.timeDerivative φ r x)
                              (SingularClosure.convection (φ r) x))
                            (SingularClosure.gradient (p r) x))
                          (HSMul.hSMul.{0, 0, 0} ν (SingularClosure.laplacian (φ r) x))) →
                  IntervalIntegrable.{0}
                      (fun r =>
                        HAdd.hAdd.{0, 0, 0}
                          (HSub.hSub.{0, 0, 0}
                            (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 ν)
                              (SingularClosure.physicalFieldInner (v r) (SingularClosure.laplacian (φ r))))
                            (SingularClosure.physicalFieldInner (v r) (SingularClosure.convection (φ r))))
                          (SingularClosure.criticalWeakTransport (v r) (φ r)))
                      MeasureTheory.MeasureSpace.volume.{0} s t ∧
                    Eq.{1}
                      (HSub.hSub.{0, 0, 0} (SingularClosure.physicalFieldInner (v t) (φ t))
                        (SingularClosure.physicalFieldInner (v s) (φ s)))
                      (∫ (r : ℝ) in s..t,
                        HAdd.hAdd.{0, 0, 0}
                          (HSub.hSub.{0, 0, 0}
                            (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 ν)
                              (SingularClosure.physicalFieldInner (v r) (SingularClosure.laplacian (φ r))))
                            (SingularClosure.physicalFieldInner (v r) (SingularClosure.convection (φ r))))
                          (SingularClosure.criticalWeakTransport (v r) (φ r)))
