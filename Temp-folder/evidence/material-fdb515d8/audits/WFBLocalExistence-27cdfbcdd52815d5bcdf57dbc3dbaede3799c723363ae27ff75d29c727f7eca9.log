TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.local_initial_classical_front_exists
MethbokeAddon.WeakFouriermanB.local_initial_classical_front_exists : ∀ (ν R : ℝ),
  LT.lt.{0} 0 ν →
    LE.le.{0} 0 R →
      ∀ (a : SingularClosure.Field),
        SingularClosure.SmoothSigmaZero a →
          LE.le.{0} (SingularClosure.physicalDissipation a) R →
            ∃ u p,
              MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν
                (MethbokeAddon.WeakFouriermanB.localGalerkinTime ν R) a u p
TYPE_END:MethbokeAddon.WeakFouriermanB.local_initial_classical_front_exists
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.local_initial_classical_front_exists
'MethbokeAddon.WeakFouriermanB.local_initial_classical_front_exists' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.local_initial_classical_front_exists
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.uniform_H1_local_initial_classical_front_exists
MethbokeAddon.WeakFouriermanB.uniform_H1_local_initial_classical_front_exists : ∀ (ν R : ℝ),
  LT.lt.{0} 0 ν →
    LE.le.{0} 0 R →
      ∃ T,
        LT.lt.{0} 0 T ∧
          ∀ (a : SingularClosure.Field),
            SingularClosure.SmoothSigmaZero a →
              LE.le.{0} (SingularClosure.physicalH1Square a) R →
                ∃ u p, MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p
TYPE_END:MethbokeAddon.WeakFouriermanB.uniform_H1_local_initial_classical_front_exists
