TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.maximal_front_leray_hopf_identification
MethbokeAddon.WeakFouriermanB.maximal_front_leray_hopf_identification : ∀ (ν : ℝ) (a : SingularClosure.Field)
  (u v : SingularClosure.Velocity) (p : SingularClosure.Pressure) (G : QuasiFeffermanB.WeakGradientTrajectory)
  (Tmax : ℝ≥0∞),
  LT.lt.{0} 0 ν →
    SingularClosure.SmoothSigmaZero a →
      MethbokeAddon.WeakFouriermanB.MaximalClassicalFront ν a u p Tmax →
        SingularClosure.CriticalLerayHopf ν (SingularClosure.criticalL2Representative.{0} a) v G →
          ∀ (t : ℝ),
            LE.le.{0} 0 t →
              LT.lt.{0} (ENNReal.ofReal t) Tmax →
                v
                    t =ᵐ[MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0}
                    SingularClosure.unitCube]
                  u t
TYPE_END:MethbokeAddon.WeakFouriermanB.maximal_front_leray_hopf_identification
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.maximal_front_leray_hopf_identification
'MethbokeAddon.WeakFouriermanB.maximal_front_leray_hopf_identification' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
