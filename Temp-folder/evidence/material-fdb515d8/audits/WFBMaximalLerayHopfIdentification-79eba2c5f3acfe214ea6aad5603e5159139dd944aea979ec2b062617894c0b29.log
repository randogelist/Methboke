TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.maximal_front_original_leray_hopf
MethbokeAddon.WeakFouriermanB.maximal_front_original_leray_hopf : ∀ (ν : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure) (Tmax : ℝ≥0∞),
  LT.lt.{0} 0 ν →
    SingularClosure.SmoothSigmaZero a →
      MethbokeAddon.WeakFouriermanB.MaximalClassicalFront ν a u p Tmax →
        ∃ v G,
          SingularClosure.CriticalLerayHopf ν (SingularClosure.criticalL2Representative.{0} a) v G ∧
            v 0 =ᵐ[MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0} SingularClosure.unitCube]
                a ∧
              ∀ (t : ℝ),
                LE.le.{0} 0 t →
                  LT.lt.{0} (ENNReal.ofReal t) Tmax →
                    v
                        t =ᵐ[MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0}
                        SingularClosure.unitCube]
                      u t
TYPE_END:MethbokeAddon.WeakFouriermanB.maximal_front_original_leray_hopf
