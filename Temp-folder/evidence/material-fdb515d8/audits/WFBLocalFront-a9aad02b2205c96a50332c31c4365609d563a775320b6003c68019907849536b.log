MethbokeAddon.WeakFouriermanB.local_smooth_energy_pairing : ∀ (ν T : ℝ) (u : SingularClosure.Velocity)
  (p : SingularClosure.Pressure),
  ContDiffOn.{0, 0, 0} ℝ ∞ (fun z => u z.1 z.2) (MethbokeAddon.WeakFouriermanB.localFrontSpacetime T) →
    (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) r → SingularClosure.SpatialPeriodic.{0} (u r)) →
      (∀ (r : ℝ),
          Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) r →
            ∀ (x : SingularClosure.Vec), Eq.{1} (SingularClosure.divergence (u r) x) 0) →
        (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) r → ContDiff.{0, 0, 0} ℝ ∞ (p r)) →
          (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) r → SingularClosure.SpatialPeriodic.{0} (p r)) →
            (∀ (r : ℝ),
                Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) r →
                  ∀ (x : SingularClosure.Vec),
                    Eq.{1}
                      (HAdd.hAdd.{0, 0, 0}
                        (HAdd.hAdd.{0, 0, 0} (SingularClosure.timeDerivative u r x)
                          (SingularClosure.convection (u r) x))
                        (SingularClosure.gradient (p r) x))
                      (HSMul.hSMul.{0, 0, 0} ν (SingularClosure.laplacian (u r) x))) →
              ∀ (t : ℝ),
                Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) t →
                  Eq.{1} (SingularClosure.physicalFieldInner (u t) (SingularClosure.timeDerivative u t))
                    (HMul.hMul.{0, 0, 0} (Neg.neg.{0} ν) (SingularClosure.physicalDissipation (u t)))
