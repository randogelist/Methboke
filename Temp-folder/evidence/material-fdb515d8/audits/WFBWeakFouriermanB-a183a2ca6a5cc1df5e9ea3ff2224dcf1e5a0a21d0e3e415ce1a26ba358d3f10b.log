TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.Weak_Fourierman_B
MethbokeAddon.WeakFouriermanB.Weak_Fourierman_B : ∀ (ν : ℝ),
  LT.lt.{0} 0 ν →
    ∀ (a : SingularClosure.Field),
      SingularClosure.SmoothSigmaZero a →
        ∀ (u : SingularClosure.Velocity) (p : SingularClosure.Pressure) (Tmax : ℝ≥0∞),
          MethbokeAddon.WeakFouriermanB.MaximalClassicalFront ν a u p Tmax →
            MethbokeAddon.WeakFouriermanB.FourierBudgetFinite (fun t => SingularClosure.datumFourierCoeff (u t))
                (Min.min.{0} Tmax
                    (ENNReal.ofReal
                      (QuasiFeffermanB.cutoff (SingularClosure.criticalL2Representative.{0} a) ν))).toReal →
              Eq.{1} Tmax ∞ ∧
                ∃ U P,
                  SingularClosure.GlobalSmoothNSE ν a U P ∧
                    ∀ (t : ℝ),
                      LE.le.{0} 0 t → LT.lt.{0} (ENNReal.ofReal t) Tmax → Eq.{1} (U t) (u t) ∧ Eq.{1} (P t) (p t)
TYPE_END:MethbokeAddon.WeakFouriermanB.Weak_Fourierman_B
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.Weak_Fourierman_B
'MethbokeAddon.WeakFouriermanB.Weak_Fourierman_B' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.Weak_Fourierman_B
