  [inst_1 : NormedSpace.{0, u_1} ℝ E] {v : ℝ → E → E} {s : ℝ → Set.{u_1} E} {K : NNReal} {f g : ℝ → E} {a b t₀ : ℝ},
  (∀ (t : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} a b) t → LipschitzOnWith.{u_1, u_1} K (v t) (s t)) →
    Membership.mem.{0, 0} (Set.Ioo.{0} a b) t₀ →
      (∀ (t : ℝ),
          Membership.mem.{0, 0} (Set.Ioo.{0} a b) t →
            HasDerivAt.{0, u_1} f (v t (f t)) t ∧ Membership.mem.{u_1, u_1} (s t) (f t)) →
        (∀ (t : ℝ),
            Membership.mem.{0, 0} (Set.Ioo.{0} a b) t →
              HasDerivAt.{0, u_1} g (v t (g t)) t ∧ Membership.mem.{u_1, u_1} (s t) (g t)) →
          Eq.{u_1 + 1} (f t₀) (g t₀) → Set.EqOn.{0, u_1} f g (Set.Ioo.{0} a b)
