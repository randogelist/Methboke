TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.analytic_forward_cap_to_initial_classical
MethbokeAddon.WeakFouriermanB.analytic_forward_cap_to_initial_classical : ∀ (ν ε T : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  LT.lt.{0} 0 ε →
