@MethbokeAddon.WeakFouriermanB.smooth_datum_cutoff : ∀ {a : SingularClosure.Field},
  SingularClosure.SmoothSigmaZero a →
    ∀ (ν : ℝ),
      Eq.{1} (QuasiFeffermanB.cutoff (SingularClosure.criticalL2Representative.{0} a) ν)
        (HDiv.hDiv.{0, 0, 0} (HPow.hPow.{0, 0, 0} (SingularClosure.physicalEnergy a) 2)
          (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 8 (HPow.hPow.{0, 0, 0} Real.pi 2)) (HPow.hPow.{0, 0, 0} ν 5)))
