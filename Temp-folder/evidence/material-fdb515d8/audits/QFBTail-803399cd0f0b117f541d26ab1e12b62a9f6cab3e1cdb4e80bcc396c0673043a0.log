TYPE_BEGIN:QuasiFeffermanB.Q09_POST_CUTOFF_SMOOTHNESS
@QuasiFeffermanB.Q09_POST_CUTOFF_SMOOTHNESS : ∀ {ν : ℝ},
  LT.lt.{0} 0 ν →
    ∀ {a : ↥SingularClosure.CriticalPhysicalL2},
      QuasiFeffermanB.EnergySigmaZero a →
        ∀ {u : SingularClosure.Velocity} {G : QuasiFeffermanB.WeakGradientTrajectory},
          SingularClosure.CriticalLerayHopf ν a u G →
            ∀ {δ : ℝ}, LT.lt.{0} (QuasiFeffermanB.cutoff a ν) δ → QuasiFeffermanB.HasSmoothTail ν u δ
TYPE_END:QuasiFeffermanB.Q09_POST_CUTOFF_SMOOTHNESS
