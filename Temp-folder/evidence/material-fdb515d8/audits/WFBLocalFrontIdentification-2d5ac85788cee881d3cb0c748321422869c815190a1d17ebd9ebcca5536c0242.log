TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.local_front_leray_hopf_identification_on
MethbokeAddon.WeakFouriermanB.local_front_leray_hopf_identification_on : ∀ (ν T : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure) (v : SingularClosure.Velocity)
  (G : QuasiFeffermanB.WeakGradientTrajectory),
  MethbokeAddon.WeakFouriermanB.LocalPhysicalNSEFront ν T a u p →
    SingularClosure.CriticalLerayHopf ν (SingularClosure.criticalL2Representative.{0} a) v G →
      ∀ (τ : ℝ),
        LT.lt.{0} 0 τ →
          LT.lt.{0} τ T →
            MeasureTheory.MemLp.{0, 0} (fun r => SingularClosure.criticalSpatialNorm.{0} 6 (u r)) 4
                (MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0} (Set.Ioc.{0} 0 τ)) →
              ∀ (r : ℝ),
                Membership.mem.{0, 0} (Set.Ioc.{0} 0 τ) r →
                  v
                      r =ᵐ[MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0}
                      SingularClosure.unitCube]
                    u r
TYPE_END:MethbokeAddon.WeakFouriermanB.local_front_leray_hopf_identification_on
