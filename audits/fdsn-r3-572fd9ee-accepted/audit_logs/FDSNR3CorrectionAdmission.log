TYPE_BEGIN:MethbokeAddon.FDSNR3.exactRealizationAndAgreement_of_schwartz_residual
@MethbokeAddon.FDSNR3.exactRealizationAndAgreement_of_schwartz_residual : ∀ {ν T a b ε : ℝ}
  {u F : SingularClosure.Velocity} {p : SingularClosure.Pressure},
  MethbokeAddon.FDSNR3.Seed ν T u p F →
    LT.lt.{0} 0 a →
      LT.lt.{0} a b →
        LT.lt.{0} b T →
          ∀ (H J : SchwartzMap.{0, 0} MethbokeAddon.FDSNR3.FamilySpacetime SingularClosure.Vec) (S : Set.{0} ℝ),
            IsCompact.{0} S →
              S ⊆ Set.Ioo.{0} a b →
                (∀ (lam : ℝ), tsupport.{0, 0} (MethbokeAddon.FDSNR3.schwartzFamilyVelocity H lam) ⊆ S) →
                  (∀ (lam t : ℝ) (x : SingularClosure.Vec),
                      Eq.{1} (J (Prod.mk.{0, 0} lam (Prod.mk.{0, 0} t x)))
                        (MethbokeAddon.FDSN.residualForce ν u 0 (MethbokeAddon.FDSNR3.schwartzFamilyVelocity H lam) t
                          x)) →
                    (∀ (lam : ℝ),
                        LT.lt.{0} (abs.{0} lam) ε →
                          ∀ (t : ℝ),
                            Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
                              ∀ (x : SingularClosure.Vec),
                                Eq.{1} (SingularClosure.divergence (MethbokeAddon.FDSNR3.correctedVelocity u H lam t) x)
                                  0) →
                      (∀ (lam : ℝ),
                          LT.lt.{0} (abs.{0} lam) ε →
                            ∀ (t : ℝ),
                              Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
                                MeasureTheory.Integrable.{0, 0}
                                  (fun x =>
                                    HPow.hPow.{0, 0, 0}
                                      (Norm.norm.{0} (MethbokeAddon.FDSNR3.correctedVelocity u H lam t x)) 2)
                                  MeasureTheory.MeasureSpace.volume.{0}) →
                        (∀ (lam : ℝ),
                            LT.lt.{0} (abs.{0} lam) ε →
                              ∀ (t : ℝ),
                                Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
                                  MeasureTheory.Integrable.{0, 0}
                                    (MethbokeAddon.FDSNR3.gradientSquare
                                      (MethbokeAddon.FDSNR3.correctedVelocity u H lam t))
                                    MeasureTheory.MeasureSpace.volume.{0}) →
                          MethbokeAddon.FDSNR3.EnergyDissipationPreservation T ε u
                              (MethbokeAddon.FDSNR3.correctedVelocity u H) →
                            MethbokeAddon.FDSNR3.ExactRealizationAndAgreement ν T a b ε u p F
                              (MethbokeAddon.FDSNR3.correctedVelocity u H) (MethbokeAddon.FDSNR3.correctedForce F J)
TYPE_END:MethbokeAddon.FDSNR3.exactRealizationAndAgreement_of_schwartz_residual
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.exactRealizationAndAgreement_of_schwartz_residual
'MethbokeAddon.FDSNR3.exactRealizationAndAgreement_of_schwartz_residual' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.exactRealizationAndAgreement_of_schwartz_residual
