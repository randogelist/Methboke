TYPE_BEGIN:MethbokeAddon.FDSN.coordinateObservation
MethbokeAddon.FDSN.coordinateObservation : Fin 3 → LinearMap.{0, 0, 0, 0} (RingHom.id.{0} ℂ) (Fin 3 → ℂ) ℂ
TYPE_END:MethbokeAddon.FDSN.coordinateObservation
AXIOMS_BEGIN:MethbokeAddon.FDSN.coordinateObservation
'MethbokeAddon.FDSN.coordinateObservation' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.coordinateObservation
TYPE_BEGIN:MethbokeAddon.FDSN.exists_nonzero_coordinate
@MethbokeAddon.FDSN.exists_nonzero_coordinate : ∀ {v : Fin 3 → ℂ}, Ne.{1} v 0 → ∃ i, Ne.{1} (v i) 0
TYPE_END:MethbokeAddon.FDSN.exists_nonzero_coordinate
AXIOMS_BEGIN:MethbokeAddon.FDSN.exists_nonzero_coordinate
'MethbokeAddon.FDSN.exists_nonzero_coordinate' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.exists_nonzero_coordinate
TYPE_BEGIN:MethbokeAddon.FDSN.noncollinear_triad_inputs_off_output
MethbokeAddon.FDSN.noncollinear_triad_inputs_off_output : ∀ (p q : SingularClosure.Frequency),
  Ne.{1} p 0 →
    Ne.{1} q 0 →
      ¬MethbokeAddon.FDSN.FrequencyParallel p q →
        Ne.{1} p (HAdd.hAdd.{0, 0, 0} p q) ∧
          Ne.{1} p (Neg.neg.{0} (HAdd.hAdd.{0, 0, 0} p q)) ∧
            Ne.{1} q (HAdd.hAdd.{0, 0, 0} p q) ∧ Ne.{1} q (Neg.neg.{0} (HAdd.hAdd.{0, 0, 0} p q))
TYPE_END:MethbokeAddon.FDSN.noncollinear_triad_inputs_off_output
AXIOMS_BEGIN:MethbokeAddon.FDSN.noncollinear_triad_inputs_off_output
'MethbokeAddon.FDSN.noncollinear_triad_inputs_off_output' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.noncollinear_triad_inputs_off_output
TYPE_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_coeff
@MethbokeAddon.FDSN.localizedPairVelocity_coeff : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSN.Seed ν T u p F →
    ∀ {a : SingularClosure.Frequency},
      Ne.{1} a 0 →
        ∀ (β : ℝ → ℝ) (lambda t : ℝ),
          Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
            Eq.{1} (SingularClosure.datumFourierCoeff (MethbokeAddon.FDSN.localizedPairVelocity a β u lambda t))
              (MethbokeAddon.FDSN.pairRotate a (MethbokeAddon.FDSN.timePhase β lambda t)
                (SingularClosure.datumFourierCoeff (u t)))
TYPE_END:MethbokeAddon.FDSN.localizedPairVelocity_coeff
AXIOMS_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_coeff
'MethbokeAddon.FDSN.localizedPairVelocity_coeff' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.localizedPairVelocity_coeff
TYPE_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_coeff_at
@MethbokeAddon.FDSN.localizedPairVelocity_coeff_at : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSN.Seed ν T u p F →
    ∀ {a : SingularClosure.Frequency},
      Ne.{1} a 0 →
        ∀ (β : ℝ → ℝ) (lambda t : ℝ),
          Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
            ∀ (i : Fin 3),
              Eq.{1} (SingularClosure.datumFourierCoeff (MethbokeAddon.FDSN.localizedPairVelocity a β u lambda t) a i)
                (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.timePhase β lambda t)
                  (SingularClosure.datumFourierCoeff (u t) a i))
TYPE_END:MethbokeAddon.FDSN.localizedPairVelocity_coeff_at
AXIOMS_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_coeff_at
'MethbokeAddon.FDSN.localizedPairVelocity_coeff_at' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.localizedPairVelocity_coeff_at
TYPE_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_coeff_off
@MethbokeAddon.FDSN.localizedPairVelocity_coeff_off : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSN.Seed ν T u p F →
    ∀ {a k : SingularClosure.Frequency},
      Ne.{1} a 0 →
        ∀ (β : ℝ → ℝ) (lambda t : ℝ),
          Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
            Ne.{1} k a →
              Ne.{1} k (Neg.neg.{0} a) →
                Eq.{1} (SingularClosure.datumFourierCoeff (MethbokeAddon.FDSN.localizedPairVelocity a β u lambda t) k)
                  (SingularClosure.datumFourierCoeff (u t) k)
TYPE_END:MethbokeAddon.FDSN.localizedPairVelocity_coeff_off
AXIOMS_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_coeff_off
'MethbokeAddon.FDSN.localizedPairVelocity_coeff_off' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.localizedPairVelocity_coeff_off
TYPE_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_difference_pairSupported
@MethbokeAddon.FDSN.localizedPairVelocity_difference_pairSupported : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSN.Seed ν T u p F →
    ∀ {a : SingularClosure.Frequency},
      Ne.{1} a 0 →
        ∀ (β : ℝ → ℝ) (lambda eta t : ℝ),
          Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
            MethbokeAddon.FDSN.PairSupported a
              (HSub.hSub.{0, 0, 0}
                (SingularClosure.datumFourierCoeff (MethbokeAddon.FDSN.localizedPairVelocity a β u eta t))
                (SingularClosure.datumFourierCoeff (MethbokeAddon.FDSN.localizedPairVelocity a β u lambda t)))
TYPE_END:MethbokeAddon.FDSN.localizedPairVelocity_difference_pairSupported
AXIOMS_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_difference_pairSupported
'MethbokeAddon.FDSN.localizedPairVelocity_difference_pairSupported' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.localizedPairVelocity_difference_pairSupported
TYPE_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_coeff_ne_of_parameter_ne
@MethbokeAddon.FDSN.localizedPairVelocity_coeff_ne_of_parameter_ne : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSN.Seed ν T u p F →
    ∀ {a : SingularClosure.Frequency},
      Ne.{1} a 0 →
        ∀ {β : ℝ → ℝ} {t : ℝ},
          Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
            Eq.{1} (β t) 1 →
              ∀ (i : Fin 3),
                Ne.{1} (SingularClosure.datumFourierCoeff (u t) a i) 0 →
                  ∀ {lambda eta : ℝ},
                    LT.lt.{0} (abs.{0} lambda) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
                      LT.lt.{0} (abs.{0} eta) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
                        Ne.{1} lambda eta →
                          Ne.{1}
                            (SingularClosure.datumFourierCoeff (MethbokeAddon.FDSN.localizedPairVelocity a β u lambda t)
                              a i)
                            (SingularClosure.datumFourierCoeff (MethbokeAddon.FDSN.localizedPairVelocity a β u eta t) a
                              i)
TYPE_END:MethbokeAddon.FDSN.localizedPairVelocity_coeff_ne_of_parameter_ne
AXIOMS_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_coeff_ne_of_parameter_ne
'MethbokeAddon.FDSN.localizedPairVelocity_coeff_ne_of_parameter_ne' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.localizedPairVelocity_coeff_ne_of_parameter_ne
TYPE_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_coordinate_triadCorrelation
@MethbokeAddon.FDSN.localizedPairVelocity_coordinate_triadCorrelation : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSN.Seed ν T u p F →
    ∀ {a k1 k2 : SingularClosure.Frequency},
      Ne.{1} a 0 →
        Ne.{1} k1 a →
          Ne.{1} k1 (Neg.neg.{0} a) →
            Ne.{1} k2 a →
              Ne.{1} k2 (Neg.neg.{0} a) →
                ∀ (i1 i2 i3 : Fin 3) (β : ℝ → ℝ) (lambda t : ℝ),
                  Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
                    Eq.{1}
                      (MethbokeAddon.FDSN.fieldTriadCorrelation k1 k2 a (MethbokeAddon.FDSN.coordinateObservation i1)
                        (MethbokeAddon.FDSN.coordinateObservation i2) (MethbokeAddon.FDSN.coordinateObservation i3)
                        (MethbokeAddon.FDSN.localizedPairVelocity a β u lambda t))
                      (MethbokeAddon.FDSN.triadCorrelation (SingularClosure.datumFourierCoeff (u t) k1 i1)
                        (SingularClosure.datumFourierCoeff (u t) k2 i2)
                        (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.timePhase β lambda t)
                          (SingularClosure.datumFourierCoeff (u t) a i3)))
TYPE_END:MethbokeAddon.FDSN.localizedPairVelocity_coordinate_triadCorrelation
AXIOMS_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_coordinate_triadCorrelation
'MethbokeAddon.FDSN.localizedPairVelocity_coordinate_triadCorrelation' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.localizedPairVelocity_coordinate_triadCorrelation
TYPE_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_not_translation
@MethbokeAddon.FDSN.localizedPairVelocity_not_translation : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSN.Seed ν T u p F →
    ∀ {a k1 k2 : SingularClosure.Frequency},
      Ne.{1} a 0 →
        Eq.{1} (HAdd.hAdd.{0, 0, 0} k1 k2) a →
          Ne.{1} k1 a →
            Ne.{1} k1 (Neg.neg.{0} a) →
              Ne.{1} k2 a →
                Ne.{1} k2 (Neg.neg.{0} a) →
                  ∀ (i1 i2 i3 : Fin 3) {β : ℝ → ℝ} {t : ℝ},
                    Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
                      Eq.{1} (β t) 1 →
                        Ne.{1}
                            (MethbokeAddon.FDSN.triadCorrelation (SingularClosure.datumFourierCoeff (u t) k1 i1)
                              (SingularClosure.datumFourierCoeff (u t) k2 i2)
                              (SingularClosure.datumFourierCoeff (u t) a i3))
                            0 →
                          ∀ {lambda eta : ℝ},
                            LT.lt.{0} (abs.{0} lambda) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
                              LT.lt.{0} (abs.{0} eta) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
                                Ne.{1} lambda eta →
                                  ¬∃ y,
                                      ∀ (x : SingularClosure.Vec),
                                        Eq.{1} (MethbokeAddon.FDSN.localizedPairVelocity a β u lambda t x)
                                          (MethbokeAddon.FDSN.localizedPairVelocity a β u eta t
                                            (HAdd.hAdd.{0, 0, 0} x y))
TYPE_END:MethbokeAddon.FDSN.localizedPairVelocity_not_translation
AXIOMS_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_not_translation
'MethbokeAddon.FDSN.localizedPairVelocity_not_translation' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.localizedPairVelocity_not_translation
TYPE_BEGIN:MethbokeAddon.FDSN.Seed.active_triad_separation_data
@MethbokeAddon.FDSN.Seed.active_triad_separation_data : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSN.Seed ν T u p F →
    ∀ (t : ℝ),
      Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
        MethbokeAddon.FDSN.HasActiveNoncollinearTriad (SingularClosure.datumFourierCoeff (u t)) →
          ∃ a,
            Ne.{1} a 0 ∧
              ∃ i,
                Ne.{1} (SingularClosure.datumFourierCoeff (u t) a i) 0 ∧
                  ∀ (β : ℝ → ℝ),
                    Eq.{1} (β t) 1 →
                      ∀ (lambda eta : ℝ),
                        LT.lt.{0} (abs.{0} lambda) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
                          LT.lt.{0} (abs.{0} eta) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
                            Ne.{1} lambda eta →
                              Ne.{1}
                                  (SingularClosure.datumFourierCoeff
                                    (MethbokeAddon.FDSN.localizedPairVelocity a β u lambda t) a i)
                                  (SingularClosure.datumFourierCoeff
                                    (MethbokeAddon.FDSN.localizedPairVelocity a β u eta t) a i) ∧
                                ¬∃ y,
                                    ∀ (x : SingularClosure.Vec),
                                      Eq.{1} (MethbokeAddon.FDSN.localizedPairVelocity a β u lambda t x)
                                        (MethbokeAddon.FDSN.localizedPairVelocity a β u eta t (HAdd.hAdd.{0, 0, 0} x y))
TYPE_END:MethbokeAddon.FDSN.Seed.active_triad_separation_data
AXIOMS_BEGIN:MethbokeAddon.FDSN.Seed.active_triad_separation_data
'MethbokeAddon.FDSN.Seed.active_triad_separation_data' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.Seed.active_triad_separation_data
