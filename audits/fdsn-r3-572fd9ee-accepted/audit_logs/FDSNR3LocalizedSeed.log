TYPE_BEGIN:MethbokeAddon.FDSNR3.exists_timeCutoff_for_interval
@MethbokeAddon.FDSNR3.exists_timeCutoff_for_interval : ∀ {a b T : ℝ},
  LT.lt.{0} 0 a →
    LT.lt.{0} a b →
      LT.lt.{0} b T →
        ∃ χ,
          ContDiff.{0, 0, 0} ℝ ∞ χ ∧
            HasCompactSupport.{0, 0} χ ∧
              tsupport.{0, 0} χ ⊆ Set.Ioo.{0} 0 T ∧
                ∀ (t : ℝ),
                  Membership.mem.{0, 0} (Set.Icc.{0} a b) t → Filter.EventuallyEq.{0, 0} (nhds.{0} t) χ fun x => 1
TYPE_END:MethbokeAddon.FDSNR3.exists_timeCutoff_for_interval
