MethbokeAddon.WeakFouriermanB.maximal_classical_front_no_finite_dissipation_square : ∀ (ν : ℝ)
  (a : SingularClosure.Field) (u : SingularClosure.Velocity) (p : SingularClosure.Pressure) (Tmax : ℝ≥0∞),
  LT.lt.{0} 0 ν →
    MethbokeAddon.WeakFouriermanB.MaximalClassicalFront ν a u p Tmax →
      Ne.{1} Tmax ∞ →
        MeasureTheory.Integrable.{0, 0} (fun t => HPow.hPow.{0, 0, 0} (SingularClosure.physicalDissipation (u t)) 2)
            (MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0} (Set.Ioo.{0} 0 Tmax.toReal)) →
          False
