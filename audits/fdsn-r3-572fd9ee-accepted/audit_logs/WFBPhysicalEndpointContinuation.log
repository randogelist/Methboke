TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_extends_of_dissipation_square
MethbokeAddon.WeakFouriermanB.initial_front_extends_of_dissipation_square : ∀ (ν T : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  LT.lt.{0} 0 ν →
    LT.lt.{0} 0 T →
      MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
        MeasureTheory.Integrable.{0, 0} (fun t => HPow.hPow.{0, 0, 0} (SingularClosure.physicalDissipation (u t)) 2)
            (MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0} (Set.Ioo.{0} 0 T)) →
          ∃ S,
            LT.lt.{0} T S ∧
              ∃ U P,
                MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν S a U P ∧
                  ∀ (t : ℝ), Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t → Eq.{1} (U t) (u t) ∧ Eq.{1} (P t) (p t)
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_front_extends_of_dissipation_square
