TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.finite_front_splice_contDiffOn
@MethbokeAddon.WeakFouriermanB.finite_front_splice_contDiffOn.{u_1} : ∀ {E : Type u_1}
  [inst : NormedAddCommGroup.{u_1} E] [inst_1 : NormedSpace.{0, u_1} ℝ E] (δ T S η : ℝ)
  (f g : ℝ → SingularClosure.Vec → E),
  LT.lt.{0} δ η →
    LT.lt.{0} η T →
      ContDiffOn.{0, 0, u_1} ℝ ∞ (fun z => f z.1 z.2) (MethbokeAddon.WeakFouriermanB.initialFrontSpacetime T) →
        ContDiffOn.{0, 0, u_1} ℝ ∞ (fun z => g z.1 z.2)
            (Set.ofPred.{0} fun z => Membership.mem.{0, 0} (Set.Ioo.{0} δ S) z.1) →
          (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} δ T) r → Eq.{u_1 + 1} (f r) (g r)) →
            ContDiffOn.{0, 0, u_1} ℝ ∞ (fun z => MethbokeAddon.WeakFouriermanB.finiteCapSplice.{u_1} η f g z.1 z.2)
              (MethbokeAddon.WeakFouriermanB.initialFrontSpacetime S)
