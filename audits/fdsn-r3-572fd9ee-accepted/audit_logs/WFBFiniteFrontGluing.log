MethbokeAddon.WeakFouriermanB.initial_front_extend_from_restart : ∀ (ν T s h : ℝ) (a : SingularClosure.Field)
  (u v : SingularClosure.Velocity) (p q : SingularClosure.Pressure),
  LT.lt.{0} 0 ν →
    MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
      Membership.mem.{0, 0} (Set.Ico.{0} 0 T) s →
        LT.lt.{0} 0 h →
          MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν h (u s) v q →
            LT.lt.{0} T (HAdd.hAdd.{0, 0, 0} s h) →
              ∃ U P,
                MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν (HAdd.hAdd.{0, 0, 0} s h) a U P ∧
                  (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ico.{0} 0 T) r → Eq.{1} (U r) (u r) ∧ Eq.{1} (P r) (p r)) ∧
                    ∀ (r : ℝ),
                      Membership.mem.{0, 0}
                          (Set.Ico.{0} (HDiv.hDiv.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} s T) 2) (HAdd.hAdd.{0, 0, 0} s h)) r →
                        Eq.{1} (U r) (v (HSub.hSub.{0, 0, 0} r s)) ∧ Eq.{1} (P r) (q (HSub.hSub.{0, 0, 0} r s))
