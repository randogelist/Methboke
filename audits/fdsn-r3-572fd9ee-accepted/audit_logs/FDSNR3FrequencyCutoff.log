TYPE_BEGIN:MethbokeAddon.FDSNR3.exists_odd_frequency_cutoff
@MethbokeAddon.FDSNR3.exists_odd_frequency_cutoff : ∀ {c : SingularClosure.Vec} {r : ℝ},
  LT.lt.{0} 0 r →
    LT.lt.{0} r (Norm.norm.{0} c) →
      ∃ ψ b δ ρ,
        LT.lt.{0} 0 δ ∧
          LT.lt.{0} 0 ρ ∧
            ContDiff.{0, 0, 0} ℝ ∞ ψ ∧
              HasCompactSupport.{0, 0} ψ ∧
                (∀ (ξ : SingularClosure.Vec), Eq.{1} (ψ (Neg.neg.{0} ξ)) (Neg.neg.{0} (ψ ξ))) ∧
                  (∀ (ξ : SingularClosure.Vec), LE.le.{0} (abs.{0} (ψ ξ)) 1) ∧
                    Metric.closedBall.{0} c δ ⊆ Metric.ball.{0} c r ∧
                      Metric.closedBall.{0} b δ ⊆ Metric.ball.{0} c r ∧
                        Disjoint.{0} (Metric.closedBall.{0} c δ) (Metric.closedBall.{0} b δ) ∧
                          (∀ (ξ : SingularClosure.Vec),
                              Membership.mem.{0, 0} (Metric.closedBall.{0} c δ) ξ → Eq.{1} (ψ ξ) 1) ∧
                            (∀ (ξ : SingularClosure.Vec),
                                Membership.mem.{0, 0} (Metric.closedBall.{0} b δ) ξ → Eq.{1} (ψ ξ) 0) ∧
                              (∀ (ξ : SingularClosure.Vec), LT.lt.{0} (Norm.norm.{0} ξ) ρ → Eq.{1} (ψ ξ) 0) ∧
                                0 ∉ tsupport.{0, 0} ψ
TYPE_END:MethbokeAddon.FDSNR3.exists_odd_frequency_cutoff
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.exists_odd_frequency_cutoff
'MethbokeAddon.FDSNR3.exists_odd_frequency_cutoff' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.exists_odd_frequency_cutoff
