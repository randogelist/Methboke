MethbokeAddon.FDSN.native_timeDerivative_add : ∀ (U h : SingularClosure.Velocity) (t : ℝ) (x : SingularClosure.Vec),
  DifferentiableWithinAt.{0, 0, 0} ℝ (fun r => U r x) (Set.Ici.{0} 0) t →
