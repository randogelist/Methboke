TYPE_BEGIN:MethbokeAddon.FDSN.native_residual_momentum_on_open_slab
MethbokeAddon.FDSN.native_residual_momentum_on_open_slab : ∀ (ν : ℝ) (U F h : SingularClosure.Velocity)
  (p : SingularClosure.Pressure) (s T : ℝ),
  ContDiffOn.{0, 0, 0} ℝ ∞ (fun z => U z.1 z.2) (Set.ofPred.{0} fun z => Membership.mem.{0, 0} (Set.Ioo.{0} s T) z.1) →
    ContDiffOn.{0, 0, 0} ℝ ∞ (fun z => h z.1 z.2)
        (Set.ofPred.{0} fun z => Membership.mem.{0, 0} (Set.Ioo.{0} s T) z.1) →
      (∀ (t : ℝ),
          Membership.mem.{0, 0} (Set.Ioo.{0} s T) t →
            ∀ (x : SingularClosure.Vec),
              Eq.{1}
                (HAdd.hAdd.{0, 0, 0}
                  (HAdd.hAdd.{0, 0, 0} (SingularClosure.timeDerivative U t x) (SingularClosure.convection (U t) x))
                  (SingularClosure.gradient (p t) x))
                (HAdd.hAdd.{0, 0, 0} (HSMul.hSMul.{0, 0, 0} ν (SingularClosure.laplacian (U t) x)) (F t x))) →
        ∀ (t : ℝ),
          Membership.mem.{0, 0} (Set.Ioo.{0} s T) t →
            ∀ (x : SingularClosure.Vec),
              Eq.{1}
                (HAdd.hAdd.{0, 0, 0}
                  (HAdd.hAdd.{0, 0, 0} (SingularClosure.timeDerivative (HAdd.hAdd.{0, 0, 0} U h) t x)
                    (SingularClosure.convection (HAdd.hAdd.{0, 0, 0} U h t) x))
                  (SingularClosure.gradient (p t) x))
                (HAdd.hAdd.{0, 0, 0} (HSMul.hSMul.{0, 0, 0} ν (SingularClosure.laplacian (HAdd.hAdd.{0, 0, 0} U h t) x))
                  (MethbokeAddon.FDSN.residualForce ν U F h t x))
TYPE_END:MethbokeAddon.FDSN.native_residual_momentum_on_open_slab
AXIOMS_BEGIN:MethbokeAddon.FDSN.native_residual_momentum_on_open_slab
'MethbokeAddon.FDSN.native_residual_momentum_on_open_slab' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.native_residual_momentum_on_open_slab
