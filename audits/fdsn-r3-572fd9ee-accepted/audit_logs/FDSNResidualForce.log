TYPE_BEGIN:MethbokeAddon.FDSN.native_residual_momentum_at
MethbokeAddon.FDSN.native_residual_momentum_at : ∀ (ν : ℝ) (U F h : SingularClosure.Velocity)
  (p : SingularClosure.Pressure) (t : ℝ) (x : SingularClosure.Vec),
  ContDiff.{0, 0, 0} ℝ ∞ (U t) →
    ContDiff.{0, 0, 0} ℝ ∞ (h t) →
      DifferentiableWithinAt.{0, 0, 0} ℝ (fun r => U r x) (Set.Ici.{0} 0) t →
        DifferentiableWithinAt.{0, 0, 0} ℝ (fun r => h r x) (Set.Ici.{0} 0) t →
          Eq.{1}
              (HAdd.hAdd.{0, 0, 0}
                (HAdd.hAdd.{0, 0, 0} (SingularClosure.timeDerivative U t x) (SingularClosure.convection (U t) x))
                (SingularClosure.gradient (p t) x))
              (HAdd.hAdd.{0, 0, 0} (HSMul.hSMul.{0, 0, 0} ν (SingularClosure.laplacian (U t) x)) (F t x)) →
            Eq.{1}
              (HAdd.hAdd.{0, 0, 0}
                (HAdd.hAdd.{0, 0, 0} (SingularClosure.timeDerivative (HAdd.hAdd.{0, 0, 0} U h) t x)
                  (SingularClosure.convection (HAdd.hAdd.{0, 0, 0} U h t) x))
                (SingularClosure.gradient (p t) x))
              (HAdd.hAdd.{0, 0, 0} (HSMul.hSMul.{0, 0, 0} ν (SingularClosure.laplacian (HAdd.hAdd.{0, 0, 0} U h t) x))
                (MethbokeAddon.FDSN.residualForce ν U F h t x))
TYPE_END:MethbokeAddon.FDSN.native_residual_momentum_at
AXIOMS_BEGIN:MethbokeAddon.FDSN.native_residual_momentum_at
'MethbokeAddon.FDSN.native_residual_momentum_at' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.native_residual_momentum_at
