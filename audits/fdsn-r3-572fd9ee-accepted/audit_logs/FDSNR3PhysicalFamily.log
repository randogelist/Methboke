TYPE_BEGIN:MethbokeAddon.FDSNR3.jointPhysicalCorrection
@MethbokeAddon.FDSNR3.jointPhysicalCorrection : {T : ℝ} →
  {u : SingularClosure.Velocity} →
    MethbokeAddon.FDSNR3.LocalSchwartz T u →
      {β : ℝ → ℝ} →
        {ψ : SingularClosure.Vec → ℝ} →
          ContDiff.{0, 0, 0} ℝ ∞ β →
            HasCompactSupport.{0, 0} β →
              tsupport.{0, 0} β ⊆ Set.Ioo.{0} 0 T →
                ContDiff.{0, 0, 0} ℝ ∞ ψ →
                  HasCompactSupport.{0, 0} ψ →
                    SchwartzMap.{0, 0} (Prod.{0, 0} ℝ (Prod.{0, 0} ℝ SingularClosure.Vec)) SingularClosure.Vec
TYPE_END:MethbokeAddon.FDSNR3.jointPhysicalCorrection
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.jointPhysicalCorrection
'MethbokeAddon.FDSNR3.jointPhysicalCorrection' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.jointPhysicalCorrection
TYPE_BEGIN:MethbokeAddon.FDSNR3.jointPhysicalCorrection_apply
@MethbokeAddon.FDSNR3.jointPhysicalCorrection_apply : ∀ {T : ℝ} {u : SingularClosure.Velocity}
  (hu : MethbokeAddon.FDSNR3.LocalSchwartz T u) {β : ℝ → ℝ} {ψ : SingularClosure.Vec → ℝ}
  (hβ : ContDiff.{0, 0, 0} ℝ ∞ β) (hcβ : HasCompactSupport.{0, 0} β) (hβsupport : tsupport.{0, 0} β ⊆ Set.Ioo.{0} 0 T)
  (hψ : ContDiff.{0, 0, 0} ℝ ∞ ψ) (hcψ : HasCompactSupport.{0, 0} ψ) (lam t : ℝ) (x : SingularClosure.Vec),
  Eq.{1}
    ((MethbokeAddon.FDSNR3.jointPhysicalCorrection hu hβ hcβ hβsupport hψ hcψ)
      (Prod.mk.{0, 0} lam (Prod.mk.{0, 0} t x)))
    (MethbokeAddon.FDSNR3.realify
      (FourierTransformInv.fourierInv.{0, 0}
        (fun ξ => MethbokeAddon.FDSNR3.jointSpectralCorrection β ψ u (Prod.mk.{0, 0} (Prod.mk.{0, 0} lam t) ξ)) x))
TYPE_END:MethbokeAddon.FDSNR3.jointPhysicalCorrection_apply
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.jointPhysicalCorrection_apply
'MethbokeAddon.FDSNR3.jointPhysicalCorrection_apply' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.jointPhysicalCorrection_apply
