TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.maximal_classical_lifetime_strictly_exceeds_cutoff
MethbokeAddon.WeakFouriermanB.maximal_classical_lifetime_strictly_exceeds_cutoff : ∀ (ν cutoff : ℝ)
  (a : SingularClosure.Field) (u : SingularClosure.Velocity) (p : SingularClosure.Pressure) (Tmax : ℝ≥0∞),
  LT.lt.{0} 0 ν →
    MethbokeAddon.WeakFouriermanB.MaximalClassicalFront ν a u p Tmax →
      MethbokeAddon.WeakFouriermanB.MaximalFourierBudgetFinite u Tmax cutoff → LT.lt.{0} (ENNReal.ofReal cutoff) Tmax
TYPE_END:MethbokeAddon.WeakFouriermanB.maximal_classical_lifetime_strictly_exceeds_cutoff
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.maximal_classical_lifetime_strictly_exceeds_cutoff
'MethbokeAddon.WeakFouriermanB.maximal_classical_lifetime_strictly_exceeds_cutoff' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.maximal_classical_lifetime_strictly_exceeds_cutoff
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.maximal_front_exists_strictly_after_cutoff
MethbokeAddon.WeakFouriermanB.maximal_front_exists_strictly_after_cutoff : ∀ (ν cutoff : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure) (Tmax : ℝ≥0∞),
  LT.lt.{0} 0 ν →
    LE.le.{0} 0 cutoff →
      MethbokeAddon.WeakFouriermanB.MaximalClassicalFront ν a u p Tmax →
        MethbokeAddon.WeakFouriermanB.MaximalFourierBudgetFinite u Tmax cutoff →
          ∃ T,
            LT.lt.{0} 0 T ∧
              LT.lt.{0} cutoff T ∧
                LT.lt.{0} (ENNReal.ofReal T) Tmax ∧ MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p
TYPE_END:MethbokeAddon.WeakFouriermanB.maximal_front_exists_strictly_after_cutoff
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.maximal_front_exists_strictly_after_cutoff
'MethbokeAddon.WeakFouriermanB.maximal_front_exists_strictly_after_cutoff' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.maximal_front_exists_strictly_after_cutoff
