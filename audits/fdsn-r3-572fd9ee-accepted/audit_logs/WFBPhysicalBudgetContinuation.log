TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_dissipation_square_integrable_of_fourier_budget
MethbokeAddon.WeakFouriermanB.initial_front_dissipation_square_integrable_of_fourier_budget : ∀ (ν T : ℝ)
  (a : SingularClosure.Field) (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    MethbokeAddon.WeakFouriermanB.FourierBudgetFinite (fun t => SingularClosure.datumFourierCoeff (u t)) T →
      MeasureTheory.Integrable.{0, 0} (fun t => HPow.hPow.{0, 0, 0} (SingularClosure.physicalDissipation (u t)) 2)
        (MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0} (Set.Ioo.{0} 0 T))
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_front_dissipation_square_integrable_of_fourier_budget
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_dissipation_square_integrable_of_fourier_budget
'MethbokeAddon.WeakFouriermanB.initial_front_dissipation_square_integrable_of_fourier_budget' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.initial_front_dissipation_square_integrable_of_fourier_budget
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_enstrophy_accumulation_of_dissipation_square
MethbokeAddon.WeakFouriermanB.initial_front_enstrophy_accumulation_of_dissipation_square : ∀ (ν T : ℝ)
  (a : SingularClosure.Field) (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  LT.lt.{0} 0 ν →
    LT.lt.{0} 0 T →
      MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
        MeasureTheory.Integrable.{0, 0} (fun t => HPow.hPow.{0, 0, 0} (SingularClosure.physicalDissipation (u t)) 2)
            (MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0} (Set.Ioo.{0} 0 T)) →
          ∃ B,
            LE.le.{0} 0 B ∧
              ∀ (t : ℝ),
                Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
                  LE.le.{0}
                    (HAdd.hAdd.{0, 0, 0} (SingularClosure.physicalDissipation (u t))
                      (HMul.hMul.{0, 0, 0} ν
                        (∫ (s : ℝ) in 0..t, MethbokeAddon.WeakFouriermanB.physicalLaplacianSquare (u s))))
                    B
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_front_enstrophy_accumulation_of_dissipation_square
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_enstrophy_accumulation_of_dissipation_square
