TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.maximal_front_uniform_H1_before_budget_cap
MethbokeAddon.WeakFouriermanB.maximal_front_uniform_H1_before_budget_cap : ∀ (ν cutoff : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure) (Tmax : ℝ≥0∞),
  LT.lt.{0} 0 ν →
    MethbokeAddon.WeakFouriermanB.MaximalClassicalFront ν a u p Tmax →
      MethbokeAddon.WeakFouriermanB.MaximalFourierBudgetFinite u Tmax cutoff →
        ∃ R,
          LE.le.{0} 0 R ∧
            ∀ (t : ℝ),
              LE.le.{0} 0 t →
                LT.lt.{0} (ENNReal.ofReal t) (Min.min.{0} Tmax (ENNReal.ofReal cutoff)) →
                  LE.le.{0} (SingularClosure.physicalH1Square (u t)) R
TYPE_END:MethbokeAddon.WeakFouriermanB.maximal_front_uniform_H1_before_budget_cap
