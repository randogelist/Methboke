TYPE_BEGIN:MethbokeAddon.FeffermanFamily.nativeForcedEquation_congr
MethbokeAddon.FeffermanFamily.nativeForcedEquation_congr : ∀ (ν : ℝ) {u v F G : SingularClosure.Velocity}
  {p q : SingularClosure.Pressure} {t : ℝ} {x : SingularClosure.Vec},
  (Filter.EventuallyEq.{0, 0} (nhds.{0} (Prod.mk.{0, 0} t x)) (fun z => u z.1 z.2) fun z => v z.1 z.2) →
    (Filter.EventuallyEq.{0, 0} (nhds.{0} (Prod.mk.{0, 0} t x)) (fun z => p z.1 z.2) fun z => q z.1 z.2) →
      (Filter.EventuallyEq.{0, 0} (nhds.{0} (Prod.mk.{0, 0} t x)) (fun z => F z.1 z.2) fun z => G z.1 z.2) →
        (Eq.{1}
            (HAdd.hAdd.{0, 0, 0}
              (HAdd.hAdd.{0, 0, 0} (SingularClosure.timeDerivative u t x) (SingularClosure.convection (u t) x))
              (SingularClosure.gradient (p t) x))
            (HAdd.hAdd.{0, 0, 0} (HSMul.hSMul.{0, 0, 0} ν (SingularClosure.laplacian (u t) x)) (F t x)) ↔
          Eq.{1}
            (HAdd.hAdd.{0, 0, 0}
              (HAdd.hAdd.{0, 0, 0} (SingularClosure.timeDerivative v t x) (SingularClosure.convection (v t) x))
              (SingularClosure.gradient (q t) x))
            (HAdd.hAdd.{0, 0, 0} (HSMul.hSMul.{0, 0, 0} ν (SingularClosure.laplacian (v t) x)) (G t x)))
