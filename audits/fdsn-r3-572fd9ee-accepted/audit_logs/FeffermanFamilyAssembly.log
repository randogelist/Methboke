  {times : Set.{0} ℝ} (ν : ℝ),
  (∀ (i : ι), IsClosed.{0} (K i)) →
    (Pairwise.{u_1} fun i j => Disjoint.{0} (K i) (K j)) →
      (∀ (i : ι) (t : ℝ), ∀ x ∉ K i, Eq.{1} (u i t x) 0) →
