TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.local_sobolev_flow_of_uniform_H2
MethbokeAddon.WeakFouriermanB.local_sobolev_flow_of_uniform_H2 : ∀ (ν : ℝ),
  LT.lt.{0} 0 ν →
    ∀ (a : SingularClosure.Field),
      SingularClosure.SmoothSigmaZero a →
        ∀ (T : ℝ),
          LT.lt.{0} 0 T →
            ∀ (S : ℝ),
              LE.le.{0} 0 S →
                (∀ (N : ℕ),
                    LE.le.{0} 1 N →
                      ∀ (g : SingularClosure.GalerkinSolution ν a N),
                        LE.le.{0} (∫ (t : ℝ) in 0..T, HPow.hPow.{0, 0, 0} (Norm.norm.{0} (g.sobolevState 2 t)) 2) S) →
                  ∃ L, Eq.{1} (↑(L.state 0 0)) (SingularClosure.datumFourierCoeff a)
TYPE_END:MethbokeAddon.WeakFouriermanB.local_sobolev_flow_of_uniform_H2
