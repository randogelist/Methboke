TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.local_sobolev_flow_of_galerkin_limit
MethbokeAddon.WeakFouriermanB.local_sobolev_flow_of_galerkin_limit : ∀ (ν : ℝ) (a : SingularClosure.Field) (φ : ℕ → ℕ),
  StrictMono.{0, 0} φ →
    ∀ (g : (n : ℕ) → SingularClosure.GalerkinSolution ν a (HAdd.hAdd.{0, 0, 0} (φ n) 1)) (T : ℝ),
      LT.lt.{0} 0 T →
        ∀ (u : ℝ → SingularClosure.TorusSobolev 0),
          ContinuousOn.{0, 0} u (Set.Icc.{0} 0 T) →
            TendstoUniformlyOn.{0, 0, 0} (fun n t => (g n).sobolevState 0 t) u Filter.atTop.{0} (Set.Icc.{0} 0 T) →
              (∀ (s : ℕ),
                  ∃ B,
                    LE.le.{0} 0 B ∧
                      ∀ (n : ℕ) (t : ℝ),
                        Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                          LE.le.{0} (Norm.norm.{0} ((g n).sobolevState s t)) B) →
                ∃ L, ∀ (t : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t → Eq.{1} (L.state 0 t) (u t)
TYPE_END:MethbokeAddon.WeakFouriermanB.local_sobolev_flow_of_galerkin_limit
