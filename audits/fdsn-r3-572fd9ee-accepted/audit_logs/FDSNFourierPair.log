AXIOMS_END:MethbokeAddon.FDSN.pairRotate_weighted_power_sum
TYPE_BEGIN:MethbokeAddon.FDSN.PAIR_ROTATION_PRESERVES_PERIODIC_SPECTRAL_CONSTRAINTS
@MethbokeAddon.FDSN.PAIR_ROTATION_PRESERVES_PERIODIC_SPECTRAL_CONSTRAINTS : ∀ {a : SingularClosure.Frequency},
  Ne.{1} a 0 →
    ∀ {z : ℂ},
      Eq.{1} (Norm.norm.{0} z) 1 →
        ∀ (c : SingularClosure.FourierCoeff),
          SingularClosure.SpectralReality c →
            SingularClosure.SpectralSolenoidal c →
              SingularClosure.SpectralReality (MethbokeAddon.FDSN.pairRotate a z c) ∧
                SingularClosure.SpectralSolenoidal (MethbokeAddon.FDSN.pairRotate a z c) ∧
                  Eq.{1} (MethbokeAddon.FDSN.pairRotate a z c 0) (c 0) ∧
                    ∀ (k : SingularClosure.Frequency) (L : LinearMap.{0, 0, 0, 0} (RingHom.id.{0} ℂ) (Fin 3 → ℂ) ℂ),
                      Eq.{1} (Norm.norm.{0} (L (MethbokeAddon.FDSN.pairRotate a z c k))) (Norm.norm.{0} (L (c k)))
TYPE_END:MethbokeAddon.FDSN.PAIR_ROTATION_PRESERVES_PERIODIC_SPECTRAL_CONSTRAINTS
AXIOMS_BEGIN:MethbokeAddon.FDSN.PAIR_ROTATION_PRESERVES_PERIODIC_SPECTRAL_CONSTRAINTS
'MethbokeAddon.FDSN.PAIR_ROTATION_PRESERVES_PERIODIC_SPECTRAL_CONSTRAINTS' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.PAIR_ROTATION_PRESERVES_PERIODIC_SPECTRAL_CONSTRAINTS
