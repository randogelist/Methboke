TYPE_BEGIN:MethbokeAddon.FDSN.pairRotate_observable_norm
MethbokeAddon.FDSN.pairRotate_observable_norm : ∀ (a : SingularClosure.Frequency) {z : ℂ},
  Eq.{1} (Norm.norm.{0} z) 1 →
    ∀ (c : SingularClosure.FourierCoeff) (k : SingularClosure.Frequency)
      (L : LinearMap.{0, 0, 0, 0} (RingHom.id.{0} ℂ) (Fin 3 → ℂ) ℂ),
      Eq.{1} (Norm.norm.{0} (L (MethbokeAddon.FDSN.pairRotate a z c k))) (Norm.norm.{0} (L (c k)))
