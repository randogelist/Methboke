TYPE_BEGIN:MethbokeAddon.FDSN.pairRotate_weighted_power_sum
MethbokeAddon.FDSN.pairRotate_weighted_power_sum : ∀ (a : SingularClosure.Frequency) {z : ℂ},
  Eq.{1} (Norm.norm.{0} z) 1 →
    ∀ (c : SingularClosure.FourierCoeff) (w : SingularClosure.Frequency → ℝ),
      Eq.{1}
        (∑' (k : SingularClosure.Frequency),
          HMul.hMul.{0, 0, 0} (w k)
            (∑ i, HPow.hPow.{0, 0, 0} (Norm.norm.{0} (MethbokeAddon.FDSN.pairRotate a z c k i)) 2))
        (∑' (k : SingularClosure.Frequency),
          HMul.hMul.{0, 0, 0} (w k) (∑ i, HPow.hPow.{0, 0, 0} (Norm.norm.{0} (c k i)) 2))
TYPE_END:MethbokeAddon.FDSN.pairRotate_weighted_power_sum
AXIOMS_BEGIN:MethbokeAddon.FDSN.pairRotate_weighted_power_sum
