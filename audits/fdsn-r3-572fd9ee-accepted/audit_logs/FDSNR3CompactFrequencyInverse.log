TYPE_BEGIN:MethbokeAddon.FDSNR3.schwartzRightSlice_uniform_weighted_jets
@MethbokeAddon.FDSNR3.schwartzRightSlice_uniform_weighted_jets.{u_1, u_2,
    u_3} : ∀ {P : Type u_1} {X : Type u_2} [inst : NormedAddCommGroup.{u_1} P] [inst_1 : NormedSpace.{0, u_1} ℝ P]
  [inst_2 : NormedAddCommGroup.{u_2} X] [inst_3 : NormedSpace.{0, u_2} ℝ X] {E : Type u_3}
  [inst_4 : NormedAddCommGroup.{u_3} E] [inst_5 : NormedSpace.{0, u_3} ℝ E]
  (A : SchwartzMap.{max u_2 u_1, u_3} (Prod.{u_1, u_2} P X) E) (a b n : ℕ),
  ∃ C,
    LE.le.{0} 0 C ∧
      ∀ (p : P) (x : X),
        LE.le.{0}
          (HMul.hMul.{0, 0, 0}
            (HMul.hMul.{0, 0, 0} (HPow.hPow.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} 1 (Norm.norm.{u_1} p)) a)
              (HPow.hPow.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} 1 (Norm.norm.{u_2} x)) b))
            (Norm.norm.{max u_3 u_2}
              (iteratedFDeriv.{0, u_2, u_3} ℝ n (⇑(MethbokeAddon.FDSNR3.schwartzRightSlice.{u_1, u_2, u_3} A p)) x)))
          C
