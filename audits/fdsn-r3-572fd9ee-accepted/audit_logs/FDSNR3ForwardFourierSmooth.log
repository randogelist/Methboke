TYPE_BEGIN:MethbokeAddon.FDSNR3.LocalSchwartz.norm_fourier_source_jet_le
@MethbokeAddon.FDSNR3.LocalSchwartz.norm_fourier_source_jet_le : ∀ {T b R : ℝ} {u : SingularClosure.Velocity},
  MethbokeAddon.FDSNR3.LocalSchwartz T u →
    Membership.mem.{0, 0} (Set.Ico.{0} 0 T) b →
      ∀ {q : Prod.{0, 0} ℝ SingularClosure.Vec},
        Membership.mem.{0, 0} (MethbokeAddon.FDSNR3.fourierParameterBox b R) q →
          ∀ (x : SingularClosure.Vec) (n : ℕ),
            LE.le.{0}
              (Norm.norm.{0}
                (iteratedFDerivWithin.{0, 0, 0} ℝ n (fun z => MethbokeAddon.FDSNR3.complexify (u z.1.1 z.2))
                  (SProd.sprod.{0, 0, 0} (MethbokeAddon.FDSNR3.fourierParameterBox b R) Set.univ.{0})
                  (Prod.mk.{0, 0} q x)))
              (HMul.hMul.{0, 0, 0}
                (HMul.hMul.{0, 0, 0} (Norm.norm.{0} MethbokeAddon.FDSNR3.complexifyCLM)
                  (HPow.hPow.{0, 0, 0} (Norm.norm.{0} MethbokeAddon.FDSNR3.fourierSourceCLM) n))
                (Norm.norm.{0}
                  (iteratedFDerivWithin.{0, 0, 0} ℝ n (fun z => u z.1 z.2) (MethbokeAddon.FDSNR3.preterminalSpacetime T)
                    (Prod.mk.{0, 0} q.1 x))))
