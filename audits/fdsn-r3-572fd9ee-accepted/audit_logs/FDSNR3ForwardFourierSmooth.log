TYPE_BEGIN:MethbokeAddon.FDSNR3.LocalSchwartz.jointFourierIntegrand_jet_bound
@MethbokeAddon.FDSNR3.LocalSchwartz.jointFourierIntegrand_jet_bound : ∀ {T b R : ℝ} {u : SingularClosure.Velocity},
  MethbokeAddon.FDSNR3.LocalSchwartz T u →
    Membership.mem.{0, 0} (Set.Ico.{0} 0 T) b →
      LT.lt.{0} 0 R →
        ∀ (n : ℕ),
          ∃ C,
            LE.le.{0} 0 C ∧
              ∀ (q : Prod.{0, 0} ℝ SingularClosure.Vec),
                Membership.mem.{0, 0} (MethbokeAddon.FDSNR3.fourierParameterBox b R) q →
                  ∀ (x : SingularClosure.Vec),
                    LE.le.{0}
                      (Norm.norm.{0}
                        (iteratedFDerivWithin.{0, 0, 0} ℝ n (MethbokeAddon.FDSNR3.jointFourierIntegrand u)
                          (SProd.sprod.{0, 0, 0} (MethbokeAddon.FDSNR3.fourierParameterBox b R) Set.univ.{0})
