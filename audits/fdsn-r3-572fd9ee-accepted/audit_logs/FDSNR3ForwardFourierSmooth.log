                        (HPow.hPow.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} 1 (Norm.norm.{0} x))
                          (Neg.neg.{0}
                            ↑(MeasureTheory.Measure.integrablePower.{0} MeasureTheory.MeasureSpace.volume.{0}))))
