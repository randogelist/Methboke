TYPE_BEGIN:MethbokeAddon.FDSNR3.hasCompactSupport_of_frequency_carrier
@MethbokeAddon.FDSNR3.hasCompactSupport_of_frequency_carrier : ∀ {K : Set.{0} SingularClosure.Vec},
  IsCompact.{0} K →
    ∀ (f : SingularClosure.Vec → MethbokeAddon.FDSNR3.CVec), (∀ ξ ∉ K, Eq.{1} (f ξ) 0) → HasCompactSupport.{0, 0} f
TYPE_END:MethbokeAddon.FDSNR3.hasCompactSupport_of_frequency_carrier
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.hasCompactSupport_of_frequency_carrier
'MethbokeAddon.FDSNR3.hasCompactSupport_of_frequency_carrier' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.hasCompactSupport_of_frequency_carrier
TYPE_BEGIN:MethbokeAddon.FDSNR3.hasDerivAt_spectrum_time_of_joint_smooth
@MethbokeAddon.FDSNR3.hasDerivAt_spectrum_time_of_joint_smooth : ∀ {a b t : ℝ}
  {g : Prod.{0, 0} ℝ SingularClosure.Vec → MethbokeAddon.FDSNR3.CVec},
  ContDiffOn.{0, 0, 0} ℝ ∞ g (Set.ofPred.{0} fun q => Membership.mem.{0, 0} (Set.Ioo.{0} a b) q.1) →
    Membership.mem.{0, 0} (Set.Ioo.{0} a b) t →
      ∀ (ξ : SingularClosure.Vec),
        HasDerivAt.{0, 0} (fun r => g (Prod.mk.{0, 0} r ξ))
          ((fderiv.{0, 0, 0} ℝ g (Prod.mk.{0, 0} t ξ)) (Prod.mk.{0, 0} 1 0)) t
TYPE_END:MethbokeAddon.FDSNR3.hasDerivAt_spectrum_time_of_joint_smooth
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.hasDerivAt_spectrum_time_of_joint_smooth
'MethbokeAddon.FDSNR3.hasDerivAt_spectrum_time_of_joint_smooth' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.hasDerivAt_spectrum_time_of_joint_smooth
TYPE_BEGIN:MethbokeAddon.FDSNR3.inverseFourier_hasDerivAt_of_commonCompactSupport
@MethbokeAddon.FDSNR3.inverseFourier_hasDerivAt_of_commonCompactSupport : ∀ {a b t : ℝ}
  {K : Set.{0} SingularClosure.Vec} {g : Prod.{0, 0} ℝ SingularClosure.Vec → MethbokeAddon.FDSNR3.CVec},
  IsCompact.{0} K →
    ContDiffOn.{0, 0, 0} ℝ ∞ g (Set.ofPred.{0} fun q => Membership.mem.{0, 0} (Set.Ioo.{0} a b) q.1) →
      (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} a b) r → ∀ ξ ∉ K, Eq.{1} (g (Prod.mk.{0, 0} r ξ)) 0) →
        Membership.mem.{0, 0} (Set.Ioo.{0} a b) t →
          ∀ (x : SingularClosure.Vec),
            HasDerivAt.{0, 0} (fun r => FourierTransformInv.fourierInv.{0, 0} (fun ξ => g (Prod.mk.{0, 0} r ξ)) x)
              (FourierTransformInv.fourierInv.{0, 0}
                (fun ξ => (fderiv.{0, 0, 0} ℝ g (Prod.mk.{0, 0} t ξ)) (Prod.mk.{0, 0} 1 0)) x)
              t
TYPE_END:MethbokeAddon.FDSNR3.inverseFourier_hasDerivAt_of_commonCompactSupport
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.inverseFourier_hasDerivAt_of_commonCompactSupport
'MethbokeAddon.FDSNR3.inverseFourier_hasDerivAt_of_commonCompactSupport' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.inverseFourier_hasDerivAt_of_commonCompactSupport
