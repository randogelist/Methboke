TYPE_BEGIN:MethbokeAddon.FDSNR3.hasDerivAt_packetPhaseIncrement_at_crossing
@MethbokeAddon.FDSNR3.hasDerivAt_packetPhaseIncrement_at_crossing : ∀ {β : ℝ → ℝ} (ψ : SingularClosure.Vec → ℝ)
  (lam : ℝ) {t slope : ℝ},
  HasDerivAt.{0, 0} β slope t →
    Eq.{1} (β t) 0 →
      ∀ (ξ : SingularClosure.Vec),
        HasDerivAt.{0, 0} (fun r => MethbokeAddon.FDSNR3.packetPhaseIncrement.{0} β ψ lam r ξ)
          (HMul.hMul.{0, 0, 0} (↑(HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} lam slope) (ψ ξ))) Complex.I) t
TYPE_END:MethbokeAddon.FDSNR3.hasDerivAt_packetPhaseIncrement_at_crossing
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.hasDerivAt_packetPhaseIncrement_at_crossing
'MethbokeAddon.FDSNR3.hasDerivAt_packetPhaseIncrement_at_crossing' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.hasDerivAt_packetPhaseIncrement_at_crossing
TYPE_BEGIN:MethbokeAddon.FDSNR3.LocalSchwartz.hasDerivAt_inversePhaseCorrection_at_crossing
@MethbokeAddon.FDSNR3.LocalSchwartz.hasDerivAt_inversePhaseCorrection_at_crossing : ∀ {T t slope : ℝ}
  {u : SingularClosure.Velocity} (hu : MethbokeAddon.FDSNR3.LocalSchwartz T u) {β : ℝ → ℝ},
  ContDiff.{0, 0, 0} ℝ ∞ β →
    ∀ (ψ : SingularClosure.Vec → ℝ) (hψ : ContDiff.{0, 0, 0} ℝ ∞ ψ) (hcψ : HasCompactSupport.{0, 0} ψ)
      (ht : Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) t),
      HasDerivAt.{0, 0} β slope t →
        Eq.{1} (β t) 0 →
          ∀ (lam : ℝ) (x : SingularClosure.Vec),
            HasDerivAt.{0, 0} (fun r => MethbokeAddon.FDSNR3.inversePhaseCorrection β ψ lam u r x)
              (HSMul.hSMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} lam slope)
                ((MethbokeAddon.FDSNR3.spectralGenerator ψ hψ hcψ (hu.slice ⋯)) x))
              t
TYPE_END:MethbokeAddon.FDSNR3.LocalSchwartz.hasDerivAt_inversePhaseCorrection_at_crossing
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.LocalSchwartz.hasDerivAt_inversePhaseCorrection_at_crossing
'MethbokeAddon.FDSNR3.LocalSchwartz.hasDerivAt_inversePhaseCorrection_at_crossing' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.LocalSchwartz.hasDerivAt_inversePhaseCorrection_at_crossing
TYPE_BEGIN:MethbokeAddon.FDSNR3.LocalSchwartz.timeDerivative_inversePhaseCorrection_at_crossing
@MethbokeAddon.FDSNR3.LocalSchwartz.timeDerivative_inversePhaseCorrection_at_crossing : ∀ {T t slope : ℝ}
  {u : SingularClosure.Velocity} (hu : MethbokeAddon.FDSNR3.LocalSchwartz T u) {β : ℝ → ℝ},
  ContDiff.{0, 0, 0} ℝ ∞ β →
    ∀ (ψ : SingularClosure.Vec → ℝ) (hψ : ContDiff.{0, 0, 0} ℝ ∞ ψ) (hcψ : HasCompactSupport.{0, 0} ψ)
      (ht : Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) t),
      HasDerivAt.{0, 0} β slope t →
        Eq.{1} (β t) 0 →
          ∀ (lam : ℝ),
            Eq.{1} (SingularClosure.timeDerivative (MethbokeAddon.FDSNR3.inversePhaseCorrection β ψ lam u) t)
              (HSMul.hSMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} lam slope)
                ⇑(MethbokeAddon.FDSNR3.spectralGenerator ψ hψ hcψ (hu.slice ⋯)))
TYPE_END:MethbokeAddon.FDSNR3.LocalSchwartz.timeDerivative_inversePhaseCorrection_at_crossing
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.LocalSchwartz.timeDerivative_inversePhaseCorrection_at_crossing
'MethbokeAddon.FDSNR3.LocalSchwartz.timeDerivative_inversePhaseCorrection_at_crossing' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.LocalSchwartz.timeDerivative_inversePhaseCorrection_at_crossing
TYPE_BEGIN:MethbokeAddon.FDSNR3.physicalProjectedForceSeparation_inversePhaseCorrection
MethbokeAddon.FDSNR3.physicalProjectedForceSeparation_inversePhaseCorrection : ∀ (ν T ε tzero slope : ℝ)
  (u F : SingularClosure.Velocity),
  MethbokeAddon.FDSNR3.LocalSchwartz T u →
    ∀ {β : ℝ → ℝ},
      ContDiff.{0, 0, 0} ℝ ∞ β →
        ∀ (ψ : SingularClosure.Vec → ℝ),
          ContDiff.{0, 0, 0} ℝ ∞ ψ →
            HasCompactSupport.{0, 0} ψ →
              (∀ (ξ : SingularClosure.Vec), Eq.{1} (ψ (Neg.neg.{0} ξ)) (Neg.neg.{0} (ψ ξ))) →
                Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) tzero →
                  HasDerivAt.{0, 0} β slope tzero →
                    Eq.{1} (β tzero) 0 →
                      Ne.{1} slope 0 →
                        (∀ (x : SingularClosure.Vec), Eq.{1} (SingularClosure.divergence (u tzero) x) 0) →
                          ∀ {ξ : SingularClosure.Vec} {i : Fin 3},
                            Ne.{1} (ψ ξ) 0 →
                              Ne.{1} (WithLp.ofLp.{0} (MethbokeAddon.FDSNR3.fourierVelocity (u tzero) ξ) i) 0 →
                                MethbokeAddon.FDSNR3.PhysicalProjectedForceSeparation T ε fun lam =>
                                  MethbokeAddon.FDSN.residualForce ν u F
                                    (MethbokeAddon.FDSNR3.inversePhaseCorrection β ψ lam u)
TYPE_END:MethbokeAddon.FDSNR3.physicalProjectedForceSeparation_inversePhaseCorrection
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.physicalProjectedForceSeparation_inversePhaseCorrection
'MethbokeAddon.FDSNR3.physicalProjectedForceSeparation_inversePhaseCorrection' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.physicalProjectedForceSeparation_inversePhaseCorrection
