TYPE_BEGIN:MethbokeAddon.FDSN.coefficientLeray_component_normSq_le_envelope
MethbokeAddon.FDSN.coefficientLeray_component_normSq_le_envelope : ∀ (k : SingularClosure.Frequency) (v : Fin 3 → ℂ)
  (C : ℝ),
  (∀ (j : Fin 3),
      LE.le.{0} (Norm.norm.{0} (v j))
        (HMul.hMul.{0, 0, 0} C (HPow.hPow.{0, 0, 0} (Inv.inv.{0} (SingularClosure.torusSobolevWeight k)) 4))) →
    ∀ (i : Fin 3),
      LE.le.{0} (Complex.normSq (SingularClosure.coefficientLeray k v i))
        (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 3 (HPow.hPow.{0, 0, 0} C 2))
          (HPow.hPow.{0, 0, 0} (Inv.inv.{0} (SingularClosure.torusSobolevWeight k)) 8))
TYPE_END:MethbokeAddon.FDSN.coefficientLeray_component_normSq_le_envelope
