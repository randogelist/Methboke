TYPE_BEGIN:MethbokeAddon.FDSN.uniform_energy_bound_of_deriv_le
@MethbokeAddon.FDSN.uniform_energy_bound_of_deriv_le : ∀ {E : ℝ → ℝ} {a T A G ρ : ℝ},
  LE.le.{0} 0 A →
    LE.le.{0} 0 G →
      LE.le.{0} 0 ρ →
        (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ico.{0} a T) r → DifferentiableAt.{0, 0, 0} ℝ E r) →
          LE.le.{0} (E a) (HMul.hMul.{0, 0, 0} A ρ) →
            (∀ (r : ℝ),
                Membership.mem.{0, 0} (Set.Ico.{0} a T) r →
                  LE.le.{0} (deriv.{0, 0} E r) (HAdd.hAdd.{0, 0, 0} (E r) (HMul.hMul.{0, 0, 0} G ρ))) →
              ∀ (t : ℝ),
                Membership.mem.{0, 0} (Set.Ico.{0} a T) t →
                  LE.le.{0} (E t)
                    (HMul.hMul.{0, 0, 0}
                      (HMul.hMul.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} A G) (Real.exp (HSub.hSub.{0, 0, 0} T a))) ρ)
TYPE_END:MethbokeAddon.FDSN.uniform_energy_bound_of_deriv_le
AXIOMS_BEGIN:MethbokeAddon.FDSN.uniform_energy_bound_of_deriv_le
'MethbokeAddon.FDSN.uniform_energy_bound_of_deriv_le' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.uniform_energy_bound_of_deriv_le
TYPE_BEGIN:MethbokeAddon.FDSN.complex_normSq_le_of_weighted_norm_le
@MethbokeAddon.FDSN.complex_normSq_le_of_weighted_norm_le : ∀ {z : ℂ} {C r : ℝ},
  LE.le.{0} (Norm.norm.{0} z) (HMul.hMul.{0, 0, 0} C (HPow.hPow.{0, 0, 0} r 4)) →
    LE.le.{0} (Complex.normSq z) (HMul.hMul.{0, 0, 0} (HPow.hPow.{0, 0, 0} C 2) (HPow.hPow.{0, 0, 0} r 8))
TYPE_END:MethbokeAddon.FDSN.complex_normSq_le_of_weighted_norm_le
