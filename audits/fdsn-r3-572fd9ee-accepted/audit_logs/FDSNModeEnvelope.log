TYPE_BEGIN:MethbokeAddon.FDSN.weighted_norm_le_of_normSq_le
@MethbokeAddon.FDSN.weighted_norm_le_of_normSq_le : ∀ {z : ℂ} {B r : ℝ},
  LE.le.{0} 0 B →
    LE.le.{0} (Complex.normSq z) (HMul.hMul.{0, 0, 0} B (HPow.hPow.{0, 0, 0} r 8)) →
      LE.le.{0} (Norm.norm.{0} z) (HMul.hMul.{0, 0, 0} (√B) (HPow.hPow.{0, 0, 0} r 4))
TYPE_END:MethbokeAddon.FDSN.weighted_norm_le_of_normSq_le
