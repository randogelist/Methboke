TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.FINITE_ERROR_CROSS_ENSTROPHY_INEQUALITY
MethbokeAddon.EhrenfestObstruction.FINITE_ERROR_CROSS_ENSTROPHY_INEQUALITY : ∃ C,
  LT.lt.{0} 0 C ∧
    ∀ (ν : ℝ),
      LT.lt.{0} 0 ν →
        ∀ (M : ℝ),
          LE.le.{0} 0 M →
            ∀ (N : ℕ) (c : ℝ → SingularClosure.FourierCoeff) (v R : SingularClosure.Field),
              ContDiff.{0, 0, 0} ℝ ∞ v →
                Continuous.{0, 0} R →
                  (∀ (x : SingularClosure.Vec),
                      Membership.mem.{0, 0} SingularClosure.unitCube x → LE.le.{0} (Norm.norm.{0} (v x)) M) →
                    (∀ (x : SingularClosure.Vec),
                        Membership.mem.{0, 0} SingularClosure.unitCube x →
                          LE.le.{0} (Norm.norm.{0} (fderiv.{0, 0, 0} ℝ v x)) M) →
                      ∀ (s : Set.{0} ℝ) (t : ℝ),
                        (∀ k ∉ SingularClosure.cutoffModes N, ∀ (i : Fin 3), Eq.{1} (c t k i) 0) →
                          SingularClosure.SpectralReality (c t) →
                            SingularClosure.SpectralSolenoidal (c t) →
                              (∀ (k : SingularClosure.Frequency),
                                  Membership.mem.{0, 0} (SingularClosure.cutoffModes N) k →
                                    ∀ (i : Fin 3),
                                      HasDerivWithinAt.{0, 0} (fun r => c r k i)
                                        (HAdd.hAdd.{0, 0, 0} (SingularClosure.galerkinRhs ν N (c t) k i)
                                          (SingularClosure.cutoffCoeff N
                                            (fun l =>
                                              SingularClosure.coefficientLeray l
                                                (SingularClosure.datumFourierCoeff
                                                  (MethbokeAddon.EhrenfestObstruction.physicalErrorForcing v
                                                    (SingularClosure.finiteSynthesis N (c t)) R)
                                                  l))
                                            k i))
                                        s t) →
                                ∃ d,
                                  HasDerivWithinAt.{0, 0} (fun r => SingularClosure.coefficientDissipation N (c r)) d s
                                      t ∧
                                    LE.le.{0} d
                                      (HAdd.hAdd.{0, 0, 0}
                                        (HAdd.hAdd.{0, 0, 0}
                                          (HMul.hMul.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} C (HPow.hPow.{0, 0, 0} ν 3))
                                            (HPow.hPow.{0, 0, 0} (SingularClosure.coefficientDissipation N (c t)) 3))
                                          (HMul.hMul.{0, 0, 0}
                                            (HDiv.hDiv.{0, 0, 0} (HMul.hMul.{0, 0, 0} 24 (HPow.hPow.{0, 0, 0} M 2)) ν)
                                            (SingularClosure.coefficientDissipation N (c t))))
                                        (HMul.hMul.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} 6 ν)
                                          (∫ (x : SingularClosure.Vec) in SingularClosure.unitCube,
                                            HPow.hPow.{0, 0, 0} (Norm.norm.{0} (R x)) 2)))
TYPE_END:MethbokeAddon.EhrenfestObstruction.FINITE_ERROR_CROSS_ENSTROPHY_INEQUALITY
