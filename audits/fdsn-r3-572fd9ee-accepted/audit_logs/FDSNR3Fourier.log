  Eq.{1} (FourierTransform.fourier.{0, 0} f ξ)
    (∫ (x : SingularClosure.Vec),
      HMul.hMul.{0, 0, 0}
        (MethbokeAddon.FDSN.phase (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} (-2) Real.pi) (Inner.inner.{0, 0} ℝ x ξ)))
