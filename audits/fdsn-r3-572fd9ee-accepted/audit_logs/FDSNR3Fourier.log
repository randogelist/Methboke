TYPE_BEGIN:MethbokeAddon.FDSNR3.inverse_fourier_real_of_hermitian
MethbokeAddon.FDSNR3.inverse_fourier_real_of_hermitian : ∀
  (f : SchwartzMap.{0, 0} SingularClosure.Vec MethbokeAddon.FDSNR3.CVec),
  (∀ (ξ : SingularClosure.Vec) (i : Fin 3),
      Eq.{1} (WithLp.ofLp.{0} (f (Neg.neg.{0} ξ)) i) ((starRingEnd.{0} ((fun x => ℂ) i)) (WithLp.ofLp.{0} (f ξ) i))) →
    ∀ (x : SingularClosure.Vec),
      Eq.{1}
        (MethbokeAddon.FDSNR3.complexify (MethbokeAddon.FDSNR3.realify ((FourierTransformInv.fourierInv.{0, 0} f) x)))
        ((FourierTransformInv.fourierInv.{0, 0} f) x)
