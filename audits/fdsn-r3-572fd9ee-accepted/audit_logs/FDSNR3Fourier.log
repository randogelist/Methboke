MethbokeAddon.FDSNR3.scalar_fourierInv_fixedByConj : ∀ (f : SingularClosure.Vec → ℂ),
  (∀ (ξ : SingularClosure.Vec), Eq.{1} (f (Neg.neg.{0} ξ)) ((starRingEnd.{0} ℂ) (f ξ))) →
