              Membership.mem.{0, 0} (Set.Ioo.{0} 0 b) t →
                ∀ (x : SingularClosure.Vec),
                  LE.le.{0} (Norm.norm.{0} (SingularClosure.timeDerivative u t x))
                    (HMul.hMul.{0, 0, 0} C
                      (HPow.hPow.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} 1 (Norm.norm.{0} x)) (Neg.neg.{0} ↑N)))
TYPE_END:MethbokeAddon.FDSNR3.LocalSchwartz.uniform_timeDerivative_decay
