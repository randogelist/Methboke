          [inst_3 : NormedSpace.{0, u_2} ℝ F] →
            SchwartzMap.{u_1, u_2} (Prod.{0, u_1} ℝ E) F →
              (n : ℕ) → SchwartzMap.{u_1, max u_2 u_1} (Prod.{0, u_1} ℝ E) (E [×n]→L[ℝ] F)
