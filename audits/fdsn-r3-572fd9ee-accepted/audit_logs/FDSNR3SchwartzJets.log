TYPE_BEGIN:MethbokeAddon.FDSNR3.weightedSmoothSmallness_of_schwartz_corrections
MethbokeAddon.FDSNR3.weightedSmoothSmallness_of_schwartz_corrections : ∀ (ε : ℝ) (u F : SingularClosure.Velocity)
  (U G : ℝ → SingularClosure.Velocity)
  (H J : SchwartzMap.{0, 0} (Prod.{0, 0} ℝ (Prod.{0, 0} ℝ SingularClosure.Vec)) SingularClosure.Vec),
  (∀ (lam : ℝ) (z : Prod.{0, 0} ℝ SingularClosure.Vec),
      Eq.{1} (H (Prod.mk.{0, 0} lam z)) (HSub.hSub.{0, 0, 0} (U lam) u z.1 z.2)) →
    (∀ (lam : ℝ) (z : Prod.{0, 0} ℝ SingularClosure.Vec),
        Eq.{1} (J (Prod.mk.{0, 0} lam z)) (HSub.hSub.{0, 0, 0} (G lam) F z.1 z.2)) →
      (∀ (z : Prod.{0, 0} ℝ SingularClosure.Vec), Eq.{1} (H (Prod.mk.{0, 0} 0 z)) 0) →
        (∀ (z : Prod.{0, 0} ℝ SingularClosure.Vec), Eq.{1} (J (Prod.mk.{0, 0} 0 z)) 0) →
          MethbokeAddon.FDSNR3.WeightedSmoothSmallness ε u F U G
TYPE_END:MethbokeAddon.FDSNR3.weightedSmoothSmallness_of_schwartz_corrections
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.weightedSmoothSmallness_of_schwartz_corrections
