AXIOMS_END:MethbokeAddon.FDSNR3.schwartz_weighted_value_bound
TYPE_BEGIN:MethbokeAddon.FDSNR3.schwartz_weighted_value_linear_bound
@MethbokeAddon.FDSNR3.schwartz_weighted_value_linear_bound.{u_1,
    u_2} : ∀ {E : Type u_1} {F : Type u_2} [inst : NormedAddCommGroup.{u_1} E] [inst_1 : NormedSpace.{0, u_1} ℝ E]
  [inst_2 : NormedAddCommGroup.{u_2} F] [inst_3 : NormedSpace.{0, u_2} ℝ F]
  (G : SchwartzMap.{u_1, u_2} (Prod.{0, u_1} ℝ E) F),
  (∀ (z : E), Eq.{u_2 + 1} (G (Prod.mk.{0, u_1} 0 z)) 0) →
    ∀ (N : ℕ),
      ∃ C,
        LE.le.{0} 0 C ∧
          ∀ (lam : ℝ) (z : E),
            LE.le.{0}
              (HMul.hMul.{0, 0, 0} (HPow.hPow.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} 1 (Norm.norm.{u_1} z)) N)
                (Norm.norm.{u_2} (G (Prod.mk.{0, u_1} lam z))))
              (HMul.hMul.{0, 0, 0} C (abs.{0} lam))
TYPE_END:MethbokeAddon.FDSNR3.schwartz_weighted_value_linear_bound
