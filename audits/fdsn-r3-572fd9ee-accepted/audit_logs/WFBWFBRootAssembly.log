MethbokeAddon.WeakFouriermanB.maximal_classical_front_global_of_strict_cutoff : ∀ (ν : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure) (Tmax : ℝ≥0∞),
  LT.lt.{0} 0 ν →
    MethbokeAddon.WeakFouriermanB.MaximalClassicalFront ν a u p Tmax →
      LT.lt.{0} (ENNReal.ofReal (QuasiFeffermanB.cutoff (SingularClosure.criticalL2Representative.{0} a) ν)) Tmax →
        Eq.{1} Tmax ∞ ∧
          ∃ U P,
            SingularClosure.GlobalSmoothNSE ν a U P ∧
              ∀ (t : ℝ), LE.le.{0} 0 t → LT.lt.{0} (ENNReal.ofReal t) Tmax → Eq.{1} (U t) (u t) ∧ Eq.{1} (P t) (p t)
