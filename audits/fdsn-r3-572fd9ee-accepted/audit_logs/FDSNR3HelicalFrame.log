TYPE_BEGIN:MethbokeAddon.FDSNR3.helicalSymbol_eq_inner_smul_of_orthonormal_curl_frame
@MethbokeAddon.FDSNR3.helicalSymbol_eq_inner_smul_of_orthonormal_curl_frame : ∀ {ξ : SingularClosure.Vec},
  Ne.{1} ξ 0 →
    ∀ (b : OrthonormalBasis.{0, 0, 0} (Fin 3) ℂ MethbokeAddon.FDSNR3.CVec),
      (∀ (τ : Fin 2),
          Eq.{1} (HSMul.hSMul.{0, 0, 0} Complex.I (MethbokeAddon.FDSNR3.complexCross ξ (b τ.castSucc)))
            (HSMul.hSMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} ↑(MethbokeAddon.FDSNR3.helicitySign τ) ↑(Norm.norm.{0} ξ))
              (b τ.castSucc))) →
        Eq.{1} (b 2) (HSMul.hSMul.{0, 0, 0} (Inv.inv.{0} ↑(Norm.norm.{0} ξ)) (MethbokeAddon.FDSNR3.complexify ξ)) →
          ∀ (σ : Fin 2) (z : MethbokeAddon.FDSNR3.CVec),
            Eq.{1} (MethbokeAddon.FDSNR3.helicalSymbol σ ξ z)
              (HSMul.hSMul.{0, 0, 0} (Inner.inner.{0, 0} ℂ (b σ.castSucc) z) (b σ.castSucc))
TYPE_END:MethbokeAddon.FDSNR3.helicalSymbol_eq_inner_smul_of_orthonormal_curl_frame
