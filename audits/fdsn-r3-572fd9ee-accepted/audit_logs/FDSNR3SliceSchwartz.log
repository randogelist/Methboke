TYPE_BEGIN:MethbokeAddon.FDSNR3.Seed.exists_nonzero_fourier_ball_after
@MethbokeAddon.FDSNR3.Seed.exists_nonzero_fourier_ball_after : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSNR3.Seed ν T u p F →
    ∀ {s : ℝ},
      Membership.mem.{0, 0} (Set.Ico.{0} 0 T) s →
        ∃ t,
          Membership.mem.{0, 0} (Set.Ioo.{0} s T) t ∧
            ∃ i ξ₀ r,
              Ne.{1} ξ₀ 0 ∧
                LT.lt.{0} 0 r ∧
                  LT.lt.{0} r (Norm.norm.{0} ξ₀) ∧
                    ∀ (ξ : SingularClosure.Vec),
                      Membership.mem.{0, 0} (Metric.ball.{0} ξ₀ r) ξ →
                        Ne.{1} (WithLp.ofLp.{0} (MethbokeAddon.FDSNR3.fourierVelocity (u t) ξ) i) 0
TYPE_END:MethbokeAddon.FDSNR3.Seed.exists_nonzero_fourier_ball_after
