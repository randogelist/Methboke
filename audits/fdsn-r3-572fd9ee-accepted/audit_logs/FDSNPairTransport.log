TYPE_BEGIN:MethbokeAddon.FDSN.divergenceTransport_pair_left
MethbokeAddon.FDSN.divergenceTransport_pair_left : ∀ (h c : SingularClosure.TorusSobolev 0)
  (a : SingularClosure.Frequency) (i : Fin 3),
  SingularClosure.SpectralSolenoidal ↑h →
    MethbokeAddon.FDSN.PairSupported a ↑h → Eq.{1} (((SingularClosure.divergenceTransportCoefficient a i) h) c) 0
TYPE_END:MethbokeAddon.FDSN.divergenceTransport_pair_left
AXIOMS_BEGIN:MethbokeAddon.FDSN.divergenceTransport_pair_left
