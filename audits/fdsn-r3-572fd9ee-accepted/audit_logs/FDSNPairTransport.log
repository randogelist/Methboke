AXIOMS_END:MethbokeAddon.FDSN.divergenceTransport_pair_left
TYPE_BEGIN:MethbokeAddon.FDSN.divergenceTransport_pair_right
MethbokeAddon.FDSN.divergenceTransport_pair_right : ∀ (c h : SingularClosure.TorusSobolev 0)
  (a : SingularClosure.Frequency) (i : Fin 3),
  SingularClosure.SpectralSolenoidal ↑c →
    MethbokeAddon.FDSN.PairSupported a ↑h →
      Eq.{1} (((SingularClosure.divergenceTransportCoefficient a i) c) h)
        (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.meanTransportFactor (↑c) a) (↑h a i))
TYPE_END:MethbokeAddon.FDSN.divergenceTransport_pair_right
AXIOMS_BEGIN:MethbokeAddon.FDSN.divergenceTransport_pair_right
'MethbokeAddon.FDSN.divergenceTransport_pair_right' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.divergenceTransport_pair_right
TYPE_BEGIN:MethbokeAddon.FDSN.fullTransport_pair_difference
MethbokeAddon.FDSN.fullTransport_pair_difference : ∀ (c h : SingularClosure.TorusSobolev 0)
  (a : SingularClosure.Frequency) (i : Fin 3),
  SingularClosure.SpectralSolenoidal ↑c →
    SingularClosure.SpectralSolenoidal ↑h →
      MethbokeAddon.FDSN.PairSupported a ↑h →
        Eq.{1}
          (HSub.hSub.{0, 0, 0} (SingularClosure.fullTransportCoefficients (HAdd.hAdd.{0, 0, 0} c h) a i)
            (SingularClosure.fullTransportCoefficients c a i))
          (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.meanTransportFactor (↑c) a) (↑h a i))
TYPE_END:MethbokeAddon.FDSN.fullTransport_pair_difference
AXIOMS_BEGIN:MethbokeAddon.FDSN.fullTransport_pair_difference
'MethbokeAddon.FDSN.fullTransport_pair_difference' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.fullTransport_pair_difference
TYPE_BEGIN:MethbokeAddon.FDSN.fullTransport_pair_difference_real_transfer_zero
MethbokeAddon.FDSN.fullTransport_pair_difference_real_transfer_zero : ∀ (c h : SingularClosure.TorusSobolev 0)
  (a : SingularClosure.Frequency) (i : Fin 3),
  SingularClosure.SpectralReality ↑c →
    SingularClosure.SpectralSolenoidal ↑c →
      SingularClosure.SpectralSolenoidal ↑h →
        MethbokeAddon.FDSN.PairSupported a ↑h →
          Eq.{1}
            (HMul.hMul.{0, 0, 0} (Star.star.{0} (↑h a i))
                (HSub.hSub.{0, 0, 0} (SingularClosure.fullTransportCoefficients (HAdd.hAdd.{0, 0, 0} c h) a i)
                  (SingularClosure.fullTransportCoefficients c a i))).re
            0
TYPE_END:MethbokeAddon.FDSN.fullTransport_pair_difference_real_transfer_zero
AXIOMS_BEGIN:MethbokeAddon.FDSN.fullTransport_pair_difference_real_transfer_zero
'MethbokeAddon.FDSN.fullTransport_pair_difference_real_transfer_zero' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.fullTransport_pair_difference_real_transfer_zero
