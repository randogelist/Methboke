TYPE_BEGIN:MethbokeAddon.FDSN.mixedTransportModeTerm_factored
MethbokeAddon.FDSN.mixedTransportModeTerm_factored : ∀ (c d : SingularClosure.FourierCoeff)
  (k p : SingularClosure.Frequency) (i : Fin 3),
  Eq.{1} (MethbokeAddon.FDSN.mixedTransportModeTerm c d k p i)
    (HMul.hMul.{0, 0, 0} (∑ j, HMul.hMul.{0, 0, 0} (SingularClosure.derivativeSymbol j k) (c p j))
      (d (HSub.hSub.{0, 0, 0} k p) i))
TYPE_END:MethbokeAddon.FDSN.mixedTransportModeTerm_factored
AXIOMS_BEGIN:MethbokeAddon.FDSN.mixedTransportModeTerm_factored
'MethbokeAddon.FDSN.mixedTransportModeTerm_factored' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.mixedTransportModeTerm_factored
TYPE_BEGIN:MethbokeAddon.FDSN.divergenceTransportCoefficient_hasSum
MethbokeAddon.FDSN.divergenceTransportCoefficient_hasSum : ∀ (c d : SingularClosure.TorusSobolev 0)
  (k : SingularClosure.Frequency) (i : Fin 3),
  HasSum.{0, 0} (fun p => MethbokeAddon.FDSN.mixedTransportModeTerm (↑c) (↑d) k p i)
