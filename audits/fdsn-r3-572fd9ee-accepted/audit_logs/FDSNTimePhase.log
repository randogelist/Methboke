TYPE_BEGIN:MethbokeAddon.FDSN.timePhase_triad_separates
@MethbokeAddon.FDSN.timePhase_triad_separates : ∀ {β : ℝ → ℝ} {t : ℝ},
  Eq.{1} (β t) 1 →
    ∀ {a b c : ℂ},
      Ne.{1} (MethbokeAddon.FDSN.triadCorrelation a b c) 0 →
        ∀ {lambda eta : ℝ},
          LT.lt.{0} (abs.{0} lambda) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
            LT.lt.{0} (abs.{0} eta) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
              Ne.{1} lambda eta →
                Ne.{1}
                  (MethbokeAddon.FDSN.triadCorrelation a b
                    (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.timePhase β lambda t) c))
                  (MethbokeAddon.FDSN.triadCorrelation a b
                    (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.timePhase β eta t) c))
TYPE_END:MethbokeAddon.FDSN.timePhase_triad_separates
AXIOMS_BEGIN:MethbokeAddon.FDSN.timePhase_triad_separates
'MethbokeAddon.FDSN.timePhase_triad_separates' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.timePhase_triad_separates
TYPE_BEGIN:MethbokeAddon.FDSN.exists_localized_time_phase_family
@MethbokeAddon.FDSN.exists_localized_time_phase_family : ∀ {s t T : ℝ},
  LT.lt.{0} s t →
    LT.lt.{0} t T →
      ∃ β,
        ContDiff.{0, 0, 0} ℝ ∞ β ∧
          HasCompactSupport.{0, 0} β ∧
            tsupport.{0, 0} β ⊆ Set.Ioo.{0} s T ∧
              Eq.{1} (β t) 1 ∧
                (∀ (u : ℝ), LE.le.{0} 0 (β u) ∧ LE.le.{0} (β u) 1) ∧
                  (ContDiff.{0, 0, 0} ℝ ∞ fun q => MethbokeAddon.FDSN.timePhase β q.1 q.2) ∧
                    ∀ (lambda : ℝ),
                      HasCompactSupport.{0, 0} (MethbokeAddon.FDSN.timePhaseIncrement β lambda) ∧
                        tsupport.{0, 0} (MethbokeAddon.FDSN.timePhaseIncrement β lambda) ⊆ Set.Ioo.{0} s T ∧
                          tsupport.{0, 0} (deriv.{0, 0} (MethbokeAddon.FDSN.timePhaseIncrement β lambda)) ⊆
                              Set.Ioo.{0} s T ∧
                            ∀ (u : ℝ),
                              LE.le.{0} (Norm.norm.{0} (MethbokeAddon.FDSN.timePhaseIncrement β lambda u))
                                (Norm.norm.{0} lambda)
TYPE_END:MethbokeAddon.FDSN.exists_localized_time_phase_family
AXIOMS_BEGIN:MethbokeAddon.FDSN.exists_localized_time_phase_family
'MethbokeAddon.FDSN.exists_localized_time_phase_family' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.exists_localized_time_phase_family
