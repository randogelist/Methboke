TYPE_BEGIN:MethbokeAddon.FDSNR3.physicalLeray_eq_of_divergence_free_schwartz
MethbokeAddon.FDSNR3.physicalLeray_eq_of_divergence_free_schwartz : ∀
  (f : SchwartzMap.{0, 0} SingularClosure.Vec SingularClosure.Vec),
  (∀ (x : SingularClosure.Vec), Eq.{1} (SingularClosure.divergence (⇑f) x) 0) →
    Eq.{1} (MethbokeAddon.FDSNR3.physicalLeray ⇑f) ⇑f
TYPE_END:MethbokeAddon.FDSNR3.physicalLeray_eq_of_divergence_free_schwartz
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.physicalLeray_eq_of_divergence_free_schwartz
'MethbokeAddon.FDSNR3.physicalLeray_eq_of_divergence_free_schwartz' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.physicalLeray_eq_of_divergence_free_schwartz
TYPE_BEGIN:MethbokeAddon.FDSNR3.divergence_free_schwartz_const_smul
MethbokeAddon.FDSNR3.divergence_free_schwartz_const_smul : ∀ (c : ℝ)
  (f : SchwartzMap.{0, 0} SingularClosure.Vec SingularClosure.Vec),
  (∀ (x : SingularClosure.Vec), Eq.{1} (SingularClosure.divergence (⇑f) x) 0) →
    ∀ (x : SingularClosure.Vec), Eq.{1} (SingularClosure.divergence (⇑(HSMul.hSMul.{0, 0, 0} c f)) x) 0
TYPE_END:MethbokeAddon.FDSNR3.divergence_free_schwartz_const_smul
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.divergence_free_schwartz_const_smul
