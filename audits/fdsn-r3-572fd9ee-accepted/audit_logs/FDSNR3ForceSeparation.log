TYPE_BEGIN:MethbokeAddon.FDSNR3.residualForce_at_zero_slice
MethbokeAddon.FDSNR3.residualForce_at_zero_slice : ∀ (ν : ℝ) (U F h : SingularClosure.Velocity) (t : ℝ),
  Eq.{1} (h t) 0 →
    Eq.{1} (MethbokeAddon.FDSN.residualForce ν U F h t) (HAdd.hAdd.{0, 0, 0} (F t) (SingularClosure.timeDerivative h t))
TYPE_END:MethbokeAddon.FDSNR3.residualForce_at_zero_slice
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.residualForce_at_zero_slice
'MethbokeAddon.FDSNR3.residualForce_at_zero_slice' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.residualForce_at_zero_slice
TYPE_BEGIN:MethbokeAddon.FDSNR3.residualForce_sub_at_common_zero
MethbokeAddon.FDSNR3.residualForce_sub_at_common_zero : ∀ (ν : ℝ) (U F h k : SingularClosure.Velocity) (t : ℝ),
  Eq.{1} (h t) 0 →
    Eq.{1} (k t) 0 →
      Eq.{1}
        (HSub.hSub.{0, 0, 0} (MethbokeAddon.FDSN.residualForce ν U F h) (MethbokeAddon.FDSN.residualForce ν U F k) t)
        (HSub.hSub.{0, 0, 0} (SingularClosure.timeDerivative h t) (SingularClosure.timeDerivative k t))
TYPE_END:MethbokeAddon.FDSNR3.residualForce_sub_at_common_zero
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.residualForce_sub_at_common_zero
'MethbokeAddon.FDSNR3.residualForce_sub_at_common_zero' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.residualForce_sub_at_common_zero
TYPE_BEGIN:MethbokeAddon.FDSNR3.physicalLeray_residual_difference_at_crossing
MethbokeAddon.FDSNR3.physicalLeray_residual_difference_at_crossing : ∀ (ν : ℝ) (U F h k : SingularClosure.Velocity)
  (t c : ℝ) (w : SchwartzMap.{0, 0} SingularClosure.Vec SingularClosure.Vec),
  Eq.{1} (h t) 0 →
    Eq.{1} (k t) 0 →
      Eq.{1} (HSub.hSub.{0, 0, 0} (SingularClosure.timeDerivative h t) (SingularClosure.timeDerivative k t))
          (HSMul.hSMul.{0, 0, 0} c ⇑w) →
        (∀ (x : SingularClosure.Vec), Eq.{1} (SingularClosure.divergence (⇑w) x) 0) →
          Eq.{1}
            (MethbokeAddon.FDSNR3.physicalLeray
              (HSub.hSub.{0, 0, 0} (MethbokeAddon.FDSN.residualForce ν U F h) (MethbokeAddon.FDSN.residualForce ν U F k)
                t))
            (HSMul.hSMul.{0, 0, 0} c ⇑w)
TYPE_END:MethbokeAddon.FDSNR3.physicalLeray_residual_difference_at_crossing
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.physicalLeray_residual_difference_at_crossing
'MethbokeAddon.FDSNR3.physicalLeray_residual_difference_at_crossing' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.physicalLeray_residual_difference_at_crossing
TYPE_BEGIN:MethbokeAddon.FDSNR3.projected_residual_difference_ne_zero_at_crossing
MethbokeAddon.FDSNR3.projected_residual_difference_ne_zero_at_crossing : ∀ (ν : ℝ) (U F h k : SingularClosure.Velocity)
  (t c : ℝ) (w : SchwartzMap.{0, 0} SingularClosure.Vec SingularClosure.Vec),
  Eq.{1} (h t) 0 →
    Eq.{1} (k t) 0 →
      Eq.{1} (HSub.hSub.{0, 0, 0} (SingularClosure.timeDerivative h t) (SingularClosure.timeDerivative k t))
          (HSMul.hSMul.{0, 0, 0} c ⇑w) →
        (∀ (x : SingularClosure.Vec), Eq.{1} (SingularClosure.divergence (⇑w) x) 0) →
          Ne.{1} c 0 →
            Ne.{1} w 0 →
              ∃ x,
                Ne.{1}
                  (MethbokeAddon.FDSNR3.physicalLeray
                    (HSub.hSub.{0, 0, 0} (MethbokeAddon.FDSN.residualForce ν U F h)
                      (MethbokeAddon.FDSN.residualForce ν U F k) t)
                    x)
                  0
TYPE_END:MethbokeAddon.FDSNR3.projected_residual_difference_ne_zero_at_crossing
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.projected_residual_difference_ne_zero_at_crossing
'MethbokeAddon.FDSNR3.projected_residual_difference_ne_zero_at_crossing' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.projected_residual_difference_ne_zero_at_crossing
TYPE_BEGIN:MethbokeAddon.FDSNR3.physicalProjectedForceSeparation_of_common_crossing
MethbokeAddon.FDSNR3.physicalProjectedForceSeparation_of_common_crossing : ∀ (ν T ε tzero slope : ℝ)
  (U F : SingularClosure.Velocity) (h : ℝ → SingularClosure.Velocity)
  (w : SchwartzMap.{0, 0} SingularClosure.Vec SingularClosure.Vec),
  Membership.mem.{0, 0} (Set.Ico.{0} 0 T) tzero →
    Ne.{1} slope 0 →
      Ne.{1} w 0 →
        (∀ (x : SingularClosure.Vec), Eq.{1} (SingularClosure.divergence (⇑w) x) 0) →
          (∀ (lam : ℝ), LT.lt.{0} (abs.{0} lam) ε → Eq.{1} (h lam tzero) 0) →
            (∀ (lam : ℝ),
                LT.lt.{0} (abs.{0} lam) ε →
                  Eq.{1} (SingularClosure.timeDerivative (h lam) tzero)
                    (HSMul.hSMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} lam slope) ⇑w)) →
              MethbokeAddon.FDSNR3.PhysicalProjectedForceSeparation T ε fun lam =>
                MethbokeAddon.FDSN.residualForce ν U F (h lam)
TYPE_END:MethbokeAddon.FDSNR3.physicalProjectedForceSeparation_of_common_crossing
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.physicalProjectedForceSeparation_of_common_crossing
'MethbokeAddon.FDSNR3.physicalProjectedForceSeparation_of_common_crossing' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.physicalProjectedForceSeparation_of_common_crossing
TYPE_BEGIN:MethbokeAddon.FDSNR3.projected_residual_generator_difference_ne_zero
MethbokeAddon.FDSNR3.projected_residual_generator_difference_ne_zero : ∀ (ν : ℝ) (U F h k : SingularClosure.Velocity)
  (t c : ℝ) (ψ : SingularClosure.Vec → ℝ) (hψ : ContDiff.{0, 0, 0} ℝ ∞ ψ) (hcψ : HasCompactSupport.{0, 0} ψ),
  (∀ (ξ : SingularClosure.Vec), Eq.{1} (ψ (Neg.neg.{0} ξ)) (Neg.neg.{0} (ψ ξ))) →
    ∀ (f : SchwartzMap.{0, 0} SingularClosure.Vec SingularClosure.Vec),
      (∀ (x : SingularClosure.Vec), Eq.{1} (SingularClosure.divergence (⇑f) x) 0) →
        ∀ {ξ : SingularClosure.Vec} {i : Fin 3},
          Ne.{1} (ψ ξ) 0 →
            Ne.{1} (WithLp.ofLp.{0} (MethbokeAddon.FDSNR3.fourierVelocity (⇑f) ξ) i) 0 →
              Eq.{1} (h t) 0 →
                Eq.{1} (k t) 0 →
                  Ne.{1} c 0 →
                    Eq.{1}
                        (HSub.hSub.{0, 0, 0} (SingularClosure.timeDerivative h t) (SingularClosure.timeDerivative k t))
                        (HSMul.hSMul.{0, 0, 0} c ⇑(MethbokeAddon.FDSNR3.spectralGenerator ψ hψ hcψ f)) →
                      ∃ x,
                        Ne.{1}
                          (MethbokeAddon.FDSNR3.physicalLeray
                            (HSub.hSub.{0, 0, 0} (MethbokeAddon.FDSN.residualForce ν U F h)
                              (MethbokeAddon.FDSN.residualForce ν U F k) t)
                            x)
                          0
TYPE_END:MethbokeAddon.FDSNR3.projected_residual_generator_difference_ne_zero
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.projected_residual_generator_difference_ne_zero
'MethbokeAddon.FDSNR3.projected_residual_generator_difference_ne_zero' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.projected_residual_generator_difference_ne_zero
