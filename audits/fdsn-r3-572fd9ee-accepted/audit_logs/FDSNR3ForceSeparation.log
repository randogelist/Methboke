    Eq.{1} (MethbokeAddon.FDSNR3.physicalLeray (HSMul.hSMul.{0, 0, 0} c ⇑f)) (HSMul.hSMul.{0, 0, 0} c ⇑f)
TYPE_END:MethbokeAddon.FDSNR3.physicalLeray_const_smul_solenoidal_schwartz
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.physicalLeray_const_smul_solenoidal_schwartz
