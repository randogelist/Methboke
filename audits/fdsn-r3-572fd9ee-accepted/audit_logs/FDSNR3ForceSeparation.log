 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.divergence_free_schwartz_const_smul
TYPE_BEGIN:MethbokeAddon.FDSNR3.physicalLeray_const_smul_solenoidal_schwartz
MethbokeAddon.FDSNR3.physicalLeray_const_smul_solenoidal_schwartz : ∀ (c : ℝ)
  (f : SchwartzMap.{0, 0} SingularClosure.Vec SingularClosure.Vec),
