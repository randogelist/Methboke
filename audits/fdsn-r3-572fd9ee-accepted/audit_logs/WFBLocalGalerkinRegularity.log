TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.local_galerkin_high_order_accumulation
MethbokeAddon.WeakFouriermanB.local_galerkin_high_order_accumulation : ∀ (ν : ℝ),
  LT.lt.{0} 0 ν →
    ∀ (a : SingularClosure.Field),
      SingularClosure.SmoothSigmaZero a →
        ∀ (T : ℝ),
          LT.lt.{0} 0 T →
            ∀ (S : ℝ),
              LE.le.{0} 0 S →
                (∀ (N : ℕ),
                    LE.le.{0} 1 N →
                      ∀ (g : SingularClosure.GalerkinSolution ν a N),
                        LE.le.{0} (∫ (t : ℝ) in 0..T, HPow.hPow.{0, 0, 0} (Norm.norm.{0} (g.sobolevState 2 t)) 2) S) →
                  ∀ (m : ℕ),
                    ∃ B,
                      LE.le.{0} 0 B ∧
                        ∀ (N : ℕ),
                          LE.le.{0} 1 N →
                            ∀ (g : SingularClosure.GalerkinSolution ν a N) (t : ℝ),
                              Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                                LE.le.{0}
                                  (HAdd.hAdd.{0, 0, 0} (HPow.hPow.{0, 0, 0} (Norm.norm.{0} (g.sobolevState m t)) 2)
                                    (HMul.hMul.{0, 0, 0} ν
                                      (∫ (s : ℝ) in 0..t,
                                        HPow.hPow.{0, 0, 0} (Norm.norm.{0} (g.sobolevState (HAdd.hAdd.{0, 0, 0} m 1) s))
                                          2)))
                                  B
TYPE_END:MethbokeAddon.WeakFouriermanB.local_galerkin_high_order_accumulation
