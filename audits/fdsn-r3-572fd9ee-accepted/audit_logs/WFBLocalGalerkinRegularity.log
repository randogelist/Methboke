MethbokeAddon.WeakFouriermanB.local_galerkin_high_order_time_modulus : ∀ (ν : ℝ),
  LT.lt.{0} 0 ν →
    ∀ (a : SingularClosure.Field),
      SingularClosure.SmoothSigmaZero a →
        ∀ (T : ℝ),
          LT.lt.{0} 0 T →
            ∀ (S : ℝ),
              LE.le.{0} 0 S →
                (∀ (N : ℕ),
                    LE.le.{0} 1 N →
                      ∀ (g : SingularClosure.GalerkinSolution ν a N),
                        LE.le.{0} (∫ (t : ℝ) in 0..T, HPow.hPow.{0, 0, 0} (Norm.norm.{0} (g.sobolevState 2 t)) 2) S) →
                  ∀ (m : ℕ),
                    ∃ B,
                      LE.le.{0} 0 B ∧
                        ∀ (N : ℕ),
                          LE.le.{0} 1 N →
                            ∀ (g : SingularClosure.GalerkinSolution ν a N) (s : ℝ),
                              Membership.mem.{0, 0} (Set.Icc.{0} 0 T) s →
                                ∀ (t : ℝ),
                                  Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                                    LE.le.{0}
                                      (HPow.hPow.{0, 0, 0}
                                        (Norm.norm.{0} (HSub.hSub.{0, 0, 0} (g.sobolevState m t) (g.sobolevState m s)))
                                        2)
                                      (HMul.hMul.{0, 0, 0} B (abs.{0} (HSub.hSub.{0, 0, 0} t s)))
TYPE_END:MethbokeAddon.WeakFouriermanB.local_galerkin_high_order_time_modulus
