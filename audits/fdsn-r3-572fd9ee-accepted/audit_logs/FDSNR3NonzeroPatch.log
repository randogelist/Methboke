TYPE_BEGIN:MethbokeAddon.FDSNR3.continuous_exists_nonzero_point
@MethbokeAddon.FDSNR3.continuous_exists_nonzero_point : ∀ {g : SingularClosure.Vec → ℂ},
  Continuous.{0, 0} g → ∀ {x : SingularClosure.Vec}, Ne.{1} (g x) 0 → ∃ y, Ne.{1} y 0 ∧ Ne.{1} (g y) 0
TYPE_END:MethbokeAddon.FDSNR3.continuous_exists_nonzero_point
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.continuous_exists_nonzero_point
'MethbokeAddon.FDSNR3.continuous_exists_nonzero_point' depends on axioms: [propext,
