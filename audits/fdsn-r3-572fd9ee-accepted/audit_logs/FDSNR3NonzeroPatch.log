@MethbokeAddon.FDSNR3.physical_exists_nonzero_fourier_ball : ∀ {v : SingularClosure.Field}
  (f : SchwartzMap.{0, 0} SingularClosure.Vec SingularClosure.Vec),
  (∀ (x : SingularClosure.Vec), Eq.{1} (f x) (v x)) →
    (∃ x, Ne.{1} (v x) 0) →
      ∃ i ξ₀ r,
        Ne.{1} ξ₀ 0 ∧
          LT.lt.{0} 0 r ∧
            LT.lt.{0} r (Norm.norm.{0} ξ₀) ∧
              ∀ (ξ : SingularClosure.Vec),
                Membership.mem.{0, 0} (Metric.ball.{0} ξ₀ r) ξ →
                  Ne.{1} (WithLp.ofLp.{0} (MethbokeAddon.FDSNR3.fourierVelocity v ξ) i) 0
