 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.continuous_exists_nonzero_point
TYPE_BEGIN:MethbokeAddon.FDSNR3.continuous_exists_nonzero_ball
@MethbokeAddon.FDSNR3.continuous_exists_nonzero_ball : ∀ {g : SingularClosure.Vec → ℂ},
  Continuous.{0, 0} g →
    ∀ {x : SingularClosure.Vec},
      Ne.{1} (g x) 0 →
        ∃ ξ₀ r,
          Ne.{1} ξ₀ 0 ∧
            LT.lt.{0} 0 r ∧
              LT.lt.{0} r (Norm.norm.{0} ξ₀) ∧
                ∀ (ξ : SingularClosure.Vec), Membership.mem.{0, 0} (Metric.ball.{0} ξ₀ r) ξ → Ne.{1} (g ξ) 0
TYPE_END:MethbokeAddon.FDSNR3.continuous_exists_nonzero_ball
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.continuous_exists_nonzero_ball
'MethbokeAddon.FDSNR3.continuous_exists_nonzero_ball' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.continuous_exists_nonzero_ball
