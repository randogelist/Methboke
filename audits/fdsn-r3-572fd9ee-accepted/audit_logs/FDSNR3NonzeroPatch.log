  (f : SchwartzMap.{0, 0} SingularClosure.Vec MethbokeAddon.FDSNR3.CVec),
  Ne.{1} f 0 →
    ∃ i ξ₀ r,
      Ne.{1} ξ₀ 0 ∧
        LT.lt.{0} 0 r ∧
          LT.lt.{0} r (Norm.norm.{0} ξ₀) ∧
            ∀ (ξ : SingularClosure.Vec),
              Membership.mem.{0, 0} (Metric.ball.{0} ξ₀ r) ξ →
                Ne.{1} (WithLp.ofLp.{0} ((FourierTransform.fourier.{0, 0} f) ξ) i) 0
