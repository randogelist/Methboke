MethbokeAddon.WeakFouriermanB.initial_front_restrict : ∀ (ν T S : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    LE.le.{0} S T → MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν S a u p
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_front_restrict
