TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_congr
MethbokeAddon.WeakFouriermanB.initial_front_congr : ∀ (ν T : ℝ) (a : SingularClosure.Field)
  (u v : SingularClosure.Velocity) (p q : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    LT.lt.{0} 0 T →
      (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ico.{0} 0 T) r → Eq.{1} (v r) (u r)) →
        (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ico.{0} 0 T) r → Eq.{1} (q r) (p r)) →
          MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a v q
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_front_congr
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_congr
'MethbokeAddon.WeakFouriermanB.initial_front_congr' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.initial_front_congr
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_classical_front_unique
MethbokeAddon.WeakFouriermanB.initial_classical_front_unique : ∀ (ν T S : ℝ) (a : SingularClosure.Field)
  (u v : SingularClosure.Velocity) (p q : SingularClosure.Pressure),
  LT.lt.{0} 0 ν →
    LT.lt.{0} 0 T →
      LT.lt.{0} 0 S →
        MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
          MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν S a v q →
            ∀ (r : ℝ),
              Membership.mem.{0, 0} (Set.Ico.{0} 0 (Min.min.{0} T S)) r → Eq.{1} (u r) (v r) ∧ Eq.{1} (p r) (q r)
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_classical_front_unique
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.initial_classical_front_unique
'MethbokeAddon.WeakFouriermanB.initial_classical_front_unique' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.initial_classical_front_unique
