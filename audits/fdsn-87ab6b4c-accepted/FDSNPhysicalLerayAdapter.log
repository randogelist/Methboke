TYPE_BEGIN:MethbokeAddon.FDSN.physicalLerayProjection_helmholtz
@MethbokeAddon.FDSN.physicalLerayProjection_helmholtz : ∀ {v : SingularClosure.Field},
  ContDiff.{0, 0, 0} ℝ ∞ v →
    SingularClosure.SpatialPeriodic.{0} v →
      Eq.{1} (MethbokeAddon.FDSN.physicalLerayProjection v)
        (HAdd.hAdd.{0, 0, 0} v
          (SingularClosure.gradient (SingularClosure.infiniteTransportPressure (SingularClosure.datumFourierCoeff v))))
