TYPE_BEGIN:MethbokeAddon.FDSN.physicalLerayProjection_rapid
@MethbokeAddon.FDSN.physicalLerayProjection_rapid : ∀ {v : SingularClosure.Field},
  ContDiff.{0, 0, 0} ℝ ∞ v →
    SingularClosure.SpatialPeriodic.{0} v →
      ∀ (i : Fin 3),
        SingularClosure.RapidScalarFourier fun k =>
          SingularClosure.coefficientLeray k (SingularClosure.datumFourierCoeff v k) i
TYPE_END:MethbokeAddon.FDSN.physicalLerayProjection_rapid
