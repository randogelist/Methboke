TYPE_BEGIN:MethbokeAddon.FDSN.projectedForceSeparation_physical
@MethbokeAddon.FDSN.projectedForceSeparation_physical : ∀ {T ε : ℝ} {G : ℝ → SingularClosure.Velocity},
  (∀ (lambda : ℝ), LT.lt.{0} (abs.{0} lambda) ε → MethbokeAddon.FeffermanFamily.AdmissiblePeriodicForce (G lambda)) →
    MethbokeAddon.FDSN.ProjectedForceSeparation T ε G →
      ∀ (lambda eta : ℝ),
        LT.lt.{0} (abs.{0} lambda) ε →
          LT.lt.{0} (abs.{0} eta) ε →
            Ne.{1} lambda eta →
              ∃ t,
                Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t ∧
                  ∃ x,
                    Ne.{1} (MethbokeAddon.FDSN.physicalLerayProjection (HSub.hSub.{0, 0, 0} (G lambda) (G eta) t) x) 0
TYPE_END:MethbokeAddon.FDSN.projectedForceSeparation_physical
AXIOMS_BEGIN:MethbokeAddon.FDSN.projectedForceSeparation_physical
'MethbokeAddon.FDSN.projectedForceSeparation_physical' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.projectedForceSeparation_physical
