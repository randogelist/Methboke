TYPE_BEGIN:MethbokeAddon.FDSN.physicalLerayProjection_ne_zero_of_coefficient_ne_zero
@MethbokeAddon.FDSN.physicalLerayProjection_ne_zero_of_coefficient_ne_zero : ∀ {v : SingularClosure.Field},
  ContDiff.{0, 0, 0} ℝ ∞ v →
    SingularClosure.SpatialPeriodic.{0} v →
      ∀ {k : SingularClosure.Frequency} {i : Fin 3},
        Ne.{1} (SingularClosure.coefficientLeray k (SingularClosure.datumFourierCoeff v k) i) 0 →
          Ne.{1} (MethbokeAddon.FDSN.physicalLerayProjection v) 0
TYPE_END:MethbokeAddon.FDSN.physicalLerayProjection_ne_zero_of_coefficient_ne_zero
