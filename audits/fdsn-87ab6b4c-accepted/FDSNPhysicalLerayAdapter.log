TYPE_BEGIN:MethbokeAddon.FDSN.datumFourierCoeff_sub_continuous
MethbokeAddon.FDSN.datumFourierCoeff_sub_continuous : ∀ (v w : SingularClosure.Field),
  Continuous.{0, 0} v →
    Continuous.{0, 0} w →
      Eq.{1} (SingularClosure.datumFourierCoeff (HSub.hSub.{0, 0, 0} v w))
        (HSub.hSub.{0, 0, 0} (SingularClosure.datumFourierCoeff v) (SingularClosure.datumFourierCoeff w))
