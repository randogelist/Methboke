TYPE_BEGIN:MethbokeAddon.FDSN.real_star_mul_imaginary
MethbokeAddon.FDSN.real_star_mul_imaginary : ∀ (z a : ℂ),
  Eq.{1} a.re 0 → Eq.{1} (HMul.hMul.{0, 0, 0} (Star.star.{0} z) (HMul.hMul.{0, 0, 0} a z)).re 0
TYPE_END:MethbokeAddon.FDSN.real_star_mul_imaginary
AXIOMS_BEGIN:MethbokeAddon.FDSN.real_star_mul_imaginary
'MethbokeAddon.FDSN.real_star_mul_imaginary' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.real_star_mul_imaginary
TYPE_BEGIN:MethbokeAddon.FDSN.triad_free_modal_transfer_zero
MethbokeAddon.FDSN.triad_free_modal_transfer_zero : ∀ (c : SingularClosure.TorusSobolev 0),
  SingularClosure.SpectralReality ↑c →
    SingularClosure.SpectralSolenoidal ↑c →
      ¬MethbokeAddon.FDSN.HasActiveNoncollinearTriad ↑c →
        ∀ (k : SingularClosure.Frequency) (i : Fin 3),
          Eq.{1} (HMul.hMul.{0, 0, 0} (Star.star.{0} (↑c k i)) (SingularClosure.fullTransportCoefficients c k i)).re 0
TYPE_END:MethbokeAddon.FDSN.triad_free_modal_transfer_zero
AXIOMS_BEGIN:MethbokeAddon.FDSN.triad_free_modal_transfer_zero
'MethbokeAddon.FDSN.triad_free_modal_transfer_zero' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.triad_free_modal_transfer_zero
TYPE_BEGIN:MethbokeAddon.FDSN.triad_free_finite_weighted_transfer_zero
MethbokeAddon.FDSN.triad_free_finite_weighted_transfer_zero : ∀ (c : SingularClosure.TorusSobolev 0),
  SingularClosure.SpectralReality ↑c →
    SingularClosure.SpectralSolenoidal ↑c →
      ¬MethbokeAddon.FDSN.HasActiveNoncollinearTriad ↑c →
        ∀ (S : Finset.{0} SingularClosure.Frequency) (w : SingularClosure.Frequency → ℝ),
          Eq.{1}
            (∑ k ∈ S,
              HMul.hMul.{0, 0, 0} (w k)
                (∑ i,
                  (HMul.hMul.{0, 0, 0} (Star.star.{0} (↑c k i)) (SingularClosure.fullTransportCoefficients c k i)).re))
            0
TYPE_END:MethbokeAddon.FDSN.triad_free_finite_weighted_transfer_zero
AXIOMS_BEGIN:MethbokeAddon.FDSN.triad_free_finite_weighted_transfer_zero
'MethbokeAddon.FDSN.triad_free_finite_weighted_transfer_zero' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.triad_free_finite_weighted_transfer_zero
