TYPE_BEGIN:MethbokeAddon.FDSN.transportModeTerm_factored
MethbokeAddon.FDSN.transportModeTerm_factored : ∀ (c : SingularClosure.FourierCoeff) (k p : SingularClosure.Frequency)
  (i : Fin 3),
  Eq.{1} (MethbokeAddon.FDSN.transportModeTerm c k p i)
    (HMul.hMul.{0, 0, 0} (∑ j, HMul.hMul.{0, 0, 0} (SingularClosure.derivativeSymbol j k) (c p j))
      (c (HSub.hSub.{0, 0, 0} k p) i))
TYPE_END:MethbokeAddon.FDSN.transportModeTerm_factored
AXIOMS_BEGIN:MethbokeAddon.FDSN.transportModeTerm_factored
'MethbokeAddon.FDSN.transportModeTerm_factored' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.transportModeTerm_factored
