 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.transportModeTerm_nonzero_input_zero
TYPE_BEGIN:MethbokeAddon.FDSN.fullTransportCoefficients_hasSum
MethbokeAddon.FDSN.fullTransportCoefficients_hasSum : ∀ (c : SingularClosure.TorusSobolev 0)
  (k : SingularClosure.Frequency) (i : Fin 3),
  HasSum.{0, 0} (fun p => MethbokeAddon.FDSN.transportModeTerm (↑c) k p i)
    (SingularClosure.fullTransportCoefficients c k i)
TYPE_END:MethbokeAddon.FDSN.fullTransportCoefficients_hasSum
AXIOMS_BEGIN:MethbokeAddon.FDSN.fullTransportCoefficients_hasSum
'MethbokeAddon.FDSN.fullTransportCoefficients_hasSum' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.fullTransportCoefficients_hasSum
TYPE_BEGIN:MethbokeAddon.FDSN.fullTransportCoefficients_eq_mean
MethbokeAddon.FDSN.fullTransportCoefficients_eq_mean : ∀ (c : SingularClosure.TorusSobolev 0),
  SingularClosure.SpectralSolenoidal ↑c →
    ¬MethbokeAddon.FDSN.HasActiveNoncollinearTriad ↑c →
      ∀ (k : SingularClosure.Frequency) (i : Fin 3),
        Ne.{1} (↑c k) 0 →
          Eq.{1} (SingularClosure.fullTransportCoefficients c k i)
            (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.meanTransportFactor (↑c) k) (↑c k i))
TYPE_END:MethbokeAddon.FDSN.fullTransportCoefficients_eq_mean
AXIOMS_BEGIN:MethbokeAddon.FDSN.fullTransportCoefficients_eq_mean
'MethbokeAddon.FDSN.fullTransportCoefficients_eq_mean' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.fullTransportCoefficients_eq_mean
