TYPE_BEGIN:MethbokeAddon.FDSN.transportModeTerm_mean
MethbokeAddon.FDSN.transportModeTerm_mean : ∀ (c : SingularClosure.FourierCoeff) (k : SingularClosure.Frequency)
  (i : Fin 3),
  Eq.{1} (MethbokeAddon.FDSN.transportModeTerm c k 0 i)
    (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.meanTransportFactor c k) (c k i))
