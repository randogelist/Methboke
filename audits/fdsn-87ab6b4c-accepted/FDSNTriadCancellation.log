AXIOMS_END:MethbokeAddon.FDSN.transportModeTerm_mean
TYPE_BEGIN:MethbokeAddon.FDSN.collinear_derivativeSum_zero
MethbokeAddon.FDSN.collinear_derivativeSum_zero : ∀ (c : SingularClosure.FourierCoeff),
  SingularClosure.SpectralSolenoidal c →
    ∀ (p q : SingularClosure.Frequency),
      MethbokeAddon.FDSN.FrequencyParallel p q →
        Eq.{1} (∑ j, HMul.hMul.{0, 0, 0} (SingularClosure.derivativeSymbol j (HAdd.hAdd.{0, 0, 0} p q)) (c p j)) 0
TYPE_END:MethbokeAddon.FDSN.collinear_derivativeSum_zero
AXIOMS_BEGIN:MethbokeAddon.FDSN.collinear_derivativeSum_zero
'MethbokeAddon.FDSN.collinear_derivativeSum_zero' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.collinear_derivativeSum_zero
TYPE_BEGIN:MethbokeAddon.FDSN.transportModeTerm_nonzero_input_zero
MethbokeAddon.FDSN.transportModeTerm_nonzero_input_zero : ∀ (c : SingularClosure.FourierCoeff),
  SingularClosure.SpectralSolenoidal c →
    ¬MethbokeAddon.FDSN.HasActiveNoncollinearTriad c →
      ∀ (k p : SingularClosure.Frequency) (i : Fin 3),
        Ne.{1} (c k) 0 → Ne.{1} p 0 → Eq.{1} (MethbokeAddon.FDSN.transportModeTerm c k p i) 0
TYPE_END:MethbokeAddon.FDSN.transportModeTerm_nonzero_input_zero
AXIOMS_BEGIN:MethbokeAddon.FDSN.transportModeTerm_nonzero_input_zero
