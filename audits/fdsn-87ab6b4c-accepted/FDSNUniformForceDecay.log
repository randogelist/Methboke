TYPE_BEGIN:MethbokeAddon.FDSN.admissibleForce_uniform_fourier_weight_bound
@MethbokeAddon.FDSN.admissibleForce_uniform_fourier_weight_bound : ∀ {F : SingularClosure.Velocity},
  MethbokeAddon.FeffermanFamily.AdmissiblePeriodicForce F →
    ∀ (T : ℝ) (s : ℕ),
      ∃ C,
        LE.le.{0} 0 C ∧
          ∀ (t : ℝ),
            Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
              ∀ (k : SingularClosure.Frequency) (i : Fin 3),
                LE.le.{0}
                  (HMul.hMul.{0, 0, 0}
                    (HPow.hPow.{0, 0, 0} (SingularClosure.torusSobolevWeight k) (HAdd.hAdd.{0, 0, 0} s 2))
                    (Norm.norm.{0} (SingularClosure.datumFourierCoeff (F t) k i)))
                  C
TYPE_END:MethbokeAddon.FDSN.admissibleForce_uniform_fourier_weight_bound
AXIOMS_BEGIN:MethbokeAddon.FDSN.admissibleForce_uniform_fourier_weight_bound
'MethbokeAddon.FDSN.admissibleForce_uniform_fourier_weight_bound' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.admissibleForce_uniform_fourier_weight_bound
TYPE_BEGIN:MethbokeAddon.FDSN.admissibleForce_uniform_fourier_envelope
@MethbokeAddon.FDSN.admissibleForce_uniform_fourier_envelope : ∀ {F : SingularClosure.Velocity},
  MethbokeAddon.FeffermanFamily.AdmissiblePeriodicForce F →
    ∀ (T : ℝ),
      ∃ C,
        LE.le.{0} 0 C ∧
          ∀ (t : ℝ),
            Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
              ∀ (k : SingularClosure.Frequency) (i : Fin 3),
                LE.le.{0} (Norm.norm.{0} (SingularClosure.datumFourierCoeff (F t) k i))
                  (HMul.hMul.{0, 0, 0} C (HPow.hPow.{0, 0, 0} (Inv.inv.{0} (SingularClosure.torusSobolevWeight k)) 4))
TYPE_END:MethbokeAddon.FDSN.admissibleForce_uniform_fourier_envelope
