AXIOMS_END:MethbokeAddon.FDSN.triadCorrelation_translation
TYPE_BEGIN:MethbokeAddon.FDSN.triadCorrelation_phase_separates
@MethbokeAddon.FDSN.triadCorrelation_phase_separates : ∀ {a b c : ℂ},
  Ne.{1} (MethbokeAddon.FDSN.triadCorrelation a b c) 0 →
    ∀ {lambda eta : ℝ},
      LT.lt.{0} (abs.{0} lambda) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
        LT.lt.{0} (abs.{0} eta) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
          Ne.{1} lambda eta →
            Ne.{1} (MethbokeAddon.FDSN.triadCorrelation a b (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.phase lambda) c))
              (MethbokeAddon.FDSN.triadCorrelation a b (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.phase eta) c))
TYPE_END:MethbokeAddon.FDSN.triadCorrelation_phase_separates
AXIOMS_BEGIN:MethbokeAddon.FDSN.triadCorrelation_phase_separates
'MethbokeAddon.FDSN.triadCorrelation_phase_separates' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.triadCorrelation_phase_separates
TYPE_BEGIN:MethbokeAddon.FDSN.triad_phase_not_translation
@MethbokeAddon.FDSN.triad_phase_not_translation : ∀ {a b c : ℂ},
  Ne.{1} (MethbokeAddon.FDSN.triadCorrelation a b c) 0 →
    ∀ {lambda eta : ℝ},
      LT.lt.{0} (abs.{0} lambda) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
        LT.lt.{0} (abs.{0} eta) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
          Ne.{1} lambda eta →
            ∀ (alpha beta : ℝ),
              ¬(Eq.{1} (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.phase alpha) a) a ∧
                  Eq.{1} (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.phase beta) b) b ∧
                    Eq.{1}
                      (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.phase (HAdd.hAdd.{0, 0, 0} alpha beta))
                        (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.phase lambda) c))
                      (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.phase eta) c))
TYPE_END:MethbokeAddon.FDSN.triad_phase_not_translation
AXIOMS_BEGIN:MethbokeAddon.FDSN.triad_phase_not_translation
'MethbokeAddon.FDSN.triad_phase_not_translation' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.triad_phase_not_translation
