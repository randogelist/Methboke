TYPE_BEGIN:MethbokeAddon.FDSN.PreterminalNSE.fourier_balance
@MethbokeAddon.FDSN.PreterminalNSE.fourier_balance : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure} (H : MethbokeAddon.FDSN.PreterminalNSE ν T u p F) (t : ℝ)
  (ht : Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) t),
  Continuous.{0, 0} (F t) →
    ∀ (k : SingularClosure.Frequency),
      Eq.{1}
        (HAdd.hAdd.{0, 0, 0}
          (HAdd.hAdd.{0, 0, 0} (SingularClosure.datumFourierCoeff (SingularClosure.timeDerivative u t) k)
            (SingularClosure.fullTransportCoefficients (H.sobolevSlice t ht) k))
          fun i =>
          HMul.hMul.{0, 0, 0} (SingularClosure.derivativeSymbol i k)
            (MethbokeAddon.EhrenfestObstruction.scalarPressureFourierCoeff (p t) k))
        (HAdd.hAdd.{0, 0, 0}
          (HSMul.hSMul.{0, 0, 0} (↑ν)
            (SingularClosure.laplacianCoefficient (SingularClosure.datumFourierCoeff (u t)) k))
          (SingularClosure.datumFourierCoeff (F t) k))
TYPE_END:MethbokeAddon.FDSN.PreterminalNSE.fourier_balance
AXIOMS_BEGIN:MethbokeAddon.FDSN.PreterminalNSE.fourier_balance
'MethbokeAddon.FDSN.PreterminalNSE.fourier_balance' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.PreterminalNSE.fourier_balance
TYPE_BEGIN:MethbokeAddon.FDSN.PreterminalNSE.projected_fourier_balance
@MethbokeAddon.FDSN.PreterminalNSE.projected_fourier_balance : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure} (H : MethbokeAddon.FDSN.PreterminalNSE ν T u p F) (t : ℝ)
  (ht : Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) t),
  Continuous.{0, 0} (F t) →
    ∀ (k : SingularClosure.Frequency),
      Eq.{1}
        (HAdd.hAdd.{0, 0, 0} (SingularClosure.datumFourierCoeff (SingularClosure.timeDerivative u t) k)
          (SingularClosure.coefficientLeray k (SingularClosure.fullTransportCoefficients (H.sobolevSlice t ht) k)))
        (HAdd.hAdd.{0, 0, 0}
          (HSMul.hSMul.{0, 0, 0} (↑ν)
            (SingularClosure.laplacianCoefficient (SingularClosure.datumFourierCoeff (u t)) k))
          (SingularClosure.coefficientLeray k (SingularClosure.datumFourierCoeff (F t) k)))
TYPE_END:MethbokeAddon.FDSN.PreterminalNSE.projected_fourier_balance
AXIOMS_BEGIN:MethbokeAddon.FDSN.PreterminalNSE.projected_fourier_balance
'MethbokeAddon.FDSN.PreterminalNSE.projected_fourier_balance' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.PreterminalNSE.projected_fourier_balance
TYPE_BEGIN:MethbokeAddon.FDSN.PreterminalNSE.projected_fourier_hasDerivAt
@MethbokeAddon.FDSN.PreterminalNSE.projected_fourier_hasDerivAt : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure} (H : MethbokeAddon.FDSN.PreterminalNSE ν T u p F) (t : ℝ)
  (ht : Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) t),
  Continuous.{0, 0} (F t) →
    ∀ (k : SingularClosure.Frequency) (i : Fin 3),
      HasDerivAt.{0, 0} (fun r => SingularClosure.datumFourierCoeff (u r) k i)
        (HAdd.hAdd.{0, 0, 0}
          (HSub.hSub.{0, 0, 0}
            (HMul.hMul.{0, 0, 0} (Neg.neg.{0} ↑(HMul.hMul.{0, 0, 0} ν (SingularClosure.laplacianFrequency k)))
              (SingularClosure.datumFourierCoeff (u t) k i))
            (SingularClosure.coefficientLeray k (SingularClosure.fullTransportCoefficients (H.sobolevSlice t ht) k) i))
          (SingularClosure.coefficientLeray k (SingularClosure.datumFourierCoeff (F t) k) i))
        t
TYPE_END:MethbokeAddon.FDSN.PreterminalNSE.projected_fourier_hasDerivAt
AXIOMS_BEGIN:MethbokeAddon.FDSN.PreterminalNSE.projected_fourier_hasDerivAt
'MethbokeAddon.FDSN.PreterminalNSE.projected_fourier_hasDerivAt' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.PreterminalNSE.projected_fourier_hasDerivAt
TYPE_BEGIN:MethbokeAddon.FDSN.triad_free_projected_modal_transfer_zero
MethbokeAddon.FDSN.triad_free_projected_modal_transfer_zero : ∀ (c : SingularClosure.TorusSobolev 0),
  SingularClosure.SpectralReality ↑c →
    SingularClosure.SpectralSolenoidal ↑c →
      ¬MethbokeAddon.FDSN.HasActiveNoncollinearTriad ↑c →
        ∀ (k : SingularClosure.Frequency) (i : Fin 3),
          Eq.{1}
            (HMul.hMul.{0, 0, 0} (Star.star.{0} (↑c k i))
                (SingularClosure.coefficientLeray k (SingularClosure.fullTransportCoefficients c k) i)).re
            0
TYPE_END:MethbokeAddon.FDSN.triad_free_projected_modal_transfer_zero
AXIOMS_BEGIN:MethbokeAddon.FDSN.triad_free_projected_modal_transfer_zero
'MethbokeAddon.FDSN.triad_free_projected_modal_transfer_zero' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.triad_free_projected_modal_transfer_zero
