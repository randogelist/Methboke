TYPE_BEGIN:MethbokeAddon.FDSN.PreterminalNSE.triad_free_mode_energy_bound
@MethbokeAddon.FDSN.PreterminalNSE.triad_free_mode_energy_bound : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSN.PreterminalNSE ν T u p F →
    LE.le.{0} 0 ν →
      ∀ (t : ℝ),
        Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) t →
          Continuous.{0, 0} (F t) →
            ¬MethbokeAddon.FDSN.HasActiveNoncollinearTriad (SingularClosure.datumFourierCoeff (u t)) →
              ∀ (k : SingularClosure.Frequency) (i : Fin 3),
                LE.le.{0} (deriv.{0, 0} (fun r => Complex.normSq (SingularClosure.datumFourierCoeff (u r) k i)) t)
                  (HAdd.hAdd.{0, 0, 0} (Complex.normSq (SingularClosure.datumFourierCoeff (u t) k i))
                    (Complex.normSq (SingularClosure.coefficientLeray k (SingularClosure.datumFourierCoeff (F t) k) i)))
TYPE_END:MethbokeAddon.FDSN.PreterminalNSE.triad_free_mode_energy_bound
AXIOMS_BEGIN:MethbokeAddon.FDSN.PreterminalNSE.triad_free_mode_energy_bound
'MethbokeAddon.FDSN.PreterminalNSE.triad_free_mode_energy_bound' depends on axioms: [propext,
