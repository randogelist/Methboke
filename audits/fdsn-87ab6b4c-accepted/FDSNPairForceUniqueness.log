TYPE_BEGIN:MethbokeAddon.FDSN.coefficientLeray_sub_arg
MethbokeAddon.FDSN.coefficientLeray_sub_arg : ∀ (k : SingularClosure.Frequency) (v w : Fin 3 → ℂ),
  Eq.{1} (SingularClosure.coefficientLeray k (HSub.hSub.{0, 0, 0} v w))
    (HSub.hSub.{0, 0, 0} (SingularClosure.coefficientLeray k v) (SingularClosure.coefficientLeray k w))
