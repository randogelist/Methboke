TYPE_BEGIN:MethbokeAddon.FDSN.triadCorrelation_native_character
MethbokeAddon.FDSN.triadCorrelation_native_character : ∀ (k1 k2 k3 : SingularClosure.Frequency),
  Eq.{1} (HAdd.hAdd.{0, 0, 0} k1 k2) k3 →
    ∀ (x : SingularClosure.Vec) (a b c : ℂ),
      Eq.{1}
        (MethbokeAddon.FDSN.triadCorrelation (HMul.hMul.{0, 0, 0} (SingularClosure.fourierCharacter k1 x) a)
          (HMul.hMul.{0, 0, 0} (SingularClosure.fourierCharacter k2 x) b)
          (HMul.hMul.{0, 0, 0} (SingularClosure.fourierCharacter k3 x) c))
        (MethbokeAddon.FDSN.triadCorrelation a b c)
TYPE_END:MethbokeAddon.FDSN.triadCorrelation_native_character
AXIOMS_BEGIN:MethbokeAddon.FDSN.triadCorrelation_native_character
'MethbokeAddon.FDSN.triadCorrelation_native_character' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.triadCorrelation_native_character
TYPE_BEGIN:MethbokeAddon.FDSN.triad_phase_not_character_translation
MethbokeAddon.FDSN.triad_phase_not_character_translation : ∀ (k1 k2 k3 : SingularClosure.Frequency),
  Eq.{1} (HAdd.hAdd.{0, 0, 0} k1 k2) k3 →
    ∀ {a b c : ℂ},
      Ne.{1} (MethbokeAddon.FDSN.triadCorrelation a b c) 0 →
        ∀ {lambda eta : ℝ},
          LT.lt.{0} (abs.{0} lambda) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
            LT.lt.{0} (abs.{0} eta) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
              Ne.{1} lambda eta →
                ∀ (x : SingularClosure.Vec),
                  ¬(Eq.{1} (HMul.hMul.{0, 0, 0} (SingularClosure.fourierCharacter k1 x) a) a ∧
                      Eq.{1} (HMul.hMul.{0, 0, 0} (SingularClosure.fourierCharacter k2 x) b) b ∧
                        Eq.{1}
                          (HMul.hMul.{0, 0, 0} (SingularClosure.fourierCharacter k3 x)
                            (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.phase lambda) c))
                          (HMul.hMul.{0, 0, 0} (MethbokeAddon.FDSN.phase eta) c))
TYPE_END:MethbokeAddon.FDSN.triad_phase_not_character_translation
AXIOMS_BEGIN:MethbokeAddon.FDSN.triad_phase_not_character_translation
'MethbokeAddon.FDSN.triad_phase_not_character_translation' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.triad_phase_not_character_translation
