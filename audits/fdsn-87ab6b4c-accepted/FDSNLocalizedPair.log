TYPE_BEGIN:MethbokeAddon.FDSN.LOCALIZED_PAIR_VELOCITY_PRESERVES_SPECTRAL_DATA
@MethbokeAddon.FDSN.LOCALIZED_PAIR_VELOCITY_PRESERVES_SPECTRAL_DATA : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSN.Seed ν T u p F →
    ∀ {a : SingularClosure.Frequency},
      Ne.{1} a 0 →
        ∀ (β : ℝ → ℝ) (lambda t : ℝ),
          Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
            ContDiff.{0, 0, 0} ℝ ∞ (MethbokeAddon.FDSN.localizedPairVelocity a β u lambda t) ∧
              SingularClosure.SpatialPeriodic.{0} (MethbokeAddon.FDSN.localizedPairVelocity a β u lambda t) ∧
                (∀ (x : SingularClosure.Vec),
                    Eq.{1} (SingularClosure.divergence (MethbokeAddon.FDSN.localizedPairVelocity a β u lambda t) x) 0) ∧
                  Eq.{1} (SingularClosure.spatialMean (MethbokeAddon.FDSN.localizedPairVelocity a β u lambda t))
                      (SingularClosure.spatialMean (u t)) ∧
                    ∀ (k : SingularClosure.Frequency) (L : LinearMap.{0, 0, 0, 0} (RingHom.id.{0} ℂ) (Fin 3 → ℂ) ℂ),
                      Eq.{1}
                        (Norm.norm.{0}
                          (L
                            (SingularClosure.datumFourierCoeff (MethbokeAddon.FDSN.localizedPairVelocity a β u lambda t)
                              k)))
                        (Norm.norm.{0} (L (SingularClosure.datumFourierCoeff (u t) k)))
TYPE_END:MethbokeAddon.FDSN.LOCALIZED_PAIR_VELOCITY_PRESERVES_SPECTRAL_DATA
AXIOMS_BEGIN:MethbokeAddon.FDSN.LOCALIZED_PAIR_VELOCITY_PRESERVES_SPECTRAL_DATA
'MethbokeAddon.FDSN.LOCALIZED_PAIR_VELOCITY_PRESERVES_SPECTRAL_DATA' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.LOCALIZED_PAIR_VELOCITY_PRESERVES_SPECTRAL_DATA
