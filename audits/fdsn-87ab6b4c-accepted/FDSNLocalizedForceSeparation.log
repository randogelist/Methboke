TYPE_BEGIN:MethbokeAddon.FDSN.localizedPairForce_projected_separates
@MethbokeAddon.FDSN.localizedPairForce_projected_separates : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSN.Seed ν T u p F →
    ∀ {a : SingularClosure.Frequency},
      Ne.{1} a 0 →
        ∀ {β : ℝ → ℝ},
          ContDiff.{0, 0, 0} ℝ ∞ β →
            HasCompactSupport.{0, 0} β →
              tsupport.{0, 0} β ⊆ Set.Ioo.{0} 0 T →
                ∀ (s t : ℝ),
                  LT.lt.{0} 0 s →
                    LE.le.{0} s t →
                      LT.lt.{0} t T →
                        s ∉ tsupport.{0, 0} β →
                          Eq.{1} (β t) 1 →
                            ∀ (i : Fin 3),
                              Ne.{1} (SingularClosure.datumFourierCoeff (u t) a i) 0 →
                                ∀ {lambda eta : ℝ},
                                  LT.lt.{0} (abs.{0} lambda) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
                                    LT.lt.{0} (abs.{0} eta) (HDiv.hDiv.{0, 0, 0} Real.pi 4) →
                                      Ne.{1} lambda eta →
                                        ∃ r,
                                          Membership.mem.{0, 0} (Set.Ioo.{0} s t) r ∧
                                            Ne.{1}
                                              (SingularClosure.coefficientLeray a
                                                (SingularClosure.datumFourierCoeff
                                                  (MethbokeAddon.FDSN.localizedPairForce ν a β u F lambda r) a)
                                                i)
                                              (SingularClosure.coefficientLeray a
                                                (SingularClosure.datumFourierCoeff
                                                  (MethbokeAddon.FDSN.localizedPairForce ν a β u F eta r) a)
                                                i)
TYPE_END:MethbokeAddon.FDSN.localizedPairForce_projected_separates
AXIOMS_BEGIN:MethbokeAddon.FDSN.localizedPairForce_projected_separates
'MethbokeAddon.FDSN.localizedPairForce_projected_separates' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.localizedPairForce_projected_separates
TYPE_BEGIN:MethbokeAddon.FDSN.localizedPairForce_projectedSeparation
@MethbokeAddon.FDSN.localizedPairForce_projectedSeparation : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSN.Seed ν T u p F →
    ∀ {a : SingularClosure.Frequency},
      Ne.{1} a 0 →
        ∀ {β : ℝ → ℝ},
          ContDiff.{0, 0, 0} ℝ ∞ β →
            HasCompactSupport.{0, 0} β →
              tsupport.{0, 0} β ⊆ Set.Ioo.{0} 0 T →
                ∀ (s t : ℝ),
                  LT.lt.{0} 0 s →
                    LE.le.{0} s t →
                      LT.lt.{0} t T →
                        s ∉ tsupport.{0, 0} β →
                          Eq.{1} (β t) 1 →
                            ∀ (i : Fin 3),
                              Ne.{1} (SingularClosure.datumFourierCoeff (u t) a i) 0 →
                                MethbokeAddon.FDSN.ProjectedForceSeparation T (HDiv.hDiv.{0, 0, 0} Real.pi 4)
                                  (MethbokeAddon.FDSN.localizedPairForce ν a β u F)
TYPE_END:MethbokeAddon.FDSN.localizedPairForce_projectedSeparation
AXIOMS_BEGIN:MethbokeAddon.FDSN.localizedPairForce_projectedSeparation
'MethbokeAddon.FDSN.localizedPairForce_projectedSeparation' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.localizedPairForce_projectedSeparation
