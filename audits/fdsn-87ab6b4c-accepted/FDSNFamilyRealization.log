TYPE_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_terminal_blowup
@MethbokeAddon.FDSN.localizedPairVelocity_terminal_blowup : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSN.Seed ν T u p F →
    ∀ (k : SingularClosure.Frequency) {β : ℝ → ℝ} (a b : ℝ),
      LT.lt.{0} b T →
        tsupport.{0, 0} β ⊆ Set.Ioo.{0} a b →
          ∀ (lambda : ℝ),
            MethbokeAddon.FDSN.CofinalVelocityBlowup T (MethbokeAddon.FDSN.localizedPairVelocity k β u lambda)
TYPE_END:MethbokeAddon.FDSN.localizedPairVelocity_terminal_blowup
