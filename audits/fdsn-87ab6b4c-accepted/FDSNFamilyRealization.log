TYPE_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_compactCorrection
@MethbokeAddon.FDSN.localizedPairVelocity_compactCorrection : ∀ {ν T : ℝ} {u F : SingularClosure.Velocity}
  {p : SingularClosure.Pressure},
  MethbokeAddon.FDSN.Seed ν T u p F →
    ∀ (k : SingularClosure.Frequency) {β : ℝ → ℝ},
      ContDiff.{0, 0, 0} ℝ ∞ β →
        HasCompactSupport.{0, 0} β →
          tsupport.{0, 0} β ⊆ Set.Ioo.{0} 0 T →
            ∀ (a b : ℝ),
              tsupport.{0, 0} β ⊆ Set.Ioo.{0} a b →
                ∀ (lambda : ℝ),
                  MethbokeAddon.FDSN.CompactTemporalCorrection a b
                    (HSub.hSub.{0, 0, 0} (MethbokeAddon.FDSN.localizedPairVelocity k β u lambda) u)
TYPE_END:MethbokeAddon.FDSN.localizedPairVelocity_compactCorrection
AXIOMS_BEGIN:MethbokeAddon.FDSN.localizedPairVelocity_compactCorrection
'MethbokeAddon.FDSN.localizedPairVelocity_compactCorrection' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSN.localizedPairVelocity_compactCorrection
