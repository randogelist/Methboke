TYPE_BEGIN:MethbokeAddon.FDSN.scalarFourierSeries_pairRotate
@MethbokeAddon.FDSN.scalarFourierSeries_pairRotate : ∀ {a : SingularClosure.Frequency},
  Ne.{1} a 0 →
    ∀ (z : ℂ) (c : SingularClosure.FourierCoeff) (i : Fin 3),
      (Summable.{0, 0} fun k => Norm.norm.{0} (c k i)) →
        ∀ (x : SingularClosure.Vec),
          Eq.{1} (SingularClosure.scalarFourierSeries (fun k => MethbokeAddon.FDSN.pairRotate a z c k i) x)
            (HAdd.hAdd.{0, 0, 0}
              (HAdd.hAdd.{0, 0, 0} (SingularClosure.scalarFourierSeries (fun k => c k i) x)
                (HMul.hMul.{0, 0, 0} (SingularClosure.fourierCharacter a x)
                  (HMul.hMul.{0, 0, 0} (HSub.hSub.{0, 0, 0} z 1) (c a i))))
              (HMul.hMul.{0, 0, 0} (SingularClosure.fourierCharacter (Neg.neg.{0} a) x)
                (HMul.hMul.{0, 0, 0} (HSub.hSub.{0, 0, 0} (Star.star.{0} z) 1) (c (Neg.neg.{0} a) i))))
TYPE_END:MethbokeAddon.FDSN.scalarFourierSeries_pairRotate
