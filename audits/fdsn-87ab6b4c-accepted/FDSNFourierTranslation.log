TYPE_BEGIN:MethbokeAddon.FDSN.fieldTriadCorrelation_translation
MethbokeAddon.FDSN.fieldTriadCorrelation_translation : ∀ (k1 k2 k3 : SingularClosure.Frequency),
  Eq.{1} (HAdd.hAdd.{0, 0, 0} k1 k2) k3 →
    ∀ (L1 L2 L3 : LinearMap.{0, 0, 0, 0} (RingHom.id.{0} ℂ) (Fin 3 → ℂ) ℂ) (v : SingularClosure.Field),
      ContDiff.{0, 0, 0} ℝ ∞ v →
