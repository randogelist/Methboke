TYPE_BEGIN:MethbokeAddon.FDSN.fourierCharacter_add_argument
MethbokeAddon.FDSN.fourierCharacter_add_argument : ∀ (k : SingularClosure.Frequency) (x a : SingularClosure.Vec),
  Eq.{1} (SingularClosure.fourierCharacter k (HAdd.hAdd.{0, 0, 0} x a))
    (HMul.hMul.{0, 0, 0} (SingularClosure.fourierCharacter k x) (SingularClosure.fourierCharacter k a))
