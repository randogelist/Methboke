  Eq.{1} (HAdd.hAdd.{0, 0, 0} k1 k2) k3 →
    ∀ (L1 L2 L3 : LinearMap.{0, 0, 0, 0} (RingHom.id.{0} ℂ) (Fin 3 → ℂ) ℂ) (u v : SingularClosure.Field),
      ContDiff.{0, 0, 0} ℝ ∞ u →
        SingularClosure.SpatialPeriodic.{0} u →
