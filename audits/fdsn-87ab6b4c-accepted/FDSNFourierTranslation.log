          ∀ (a : SingularClosure.Vec),
            Eq.{1} (MethbokeAddon.FDSN.fieldTriadCorrelation k1 k2 k3 L1 L2 L3 fun x => v (HAdd.hAdd.{0, 0, 0} x a))
              (MethbokeAddon.FDSN.fieldTriadCorrelation k1 k2 k3 L1 L2 L3 v)
