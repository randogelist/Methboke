TYPE_BEGIN:MethbokeAddon.FDSN.modalObservation_translation
MethbokeAddon.FDSN.modalObservation_translation : ∀ (L : LinearMap.{0, 0, 0, 0} (RingHom.id.{0} ℂ) (Fin 3 → ℂ) ℂ)
  (v : SingularClosure.Field),
  ContDiff.{0, 0, 0} ℝ ∞ v →
    SingularClosure.SpatialPeriodic.{0} v →
      ∀ (a : SingularClosure.Vec) (k : SingularClosure.Frequency),
        Eq.{1} (MethbokeAddon.FDSN.modalObservation L (fun x => v (HAdd.hAdd.{0, 0, 0} x a)) k)
          (HMul.hMul.{0, 0, 0} (SingularClosure.fourierCharacter k a) (MethbokeAddon.FDSN.modalObservation L v k))
