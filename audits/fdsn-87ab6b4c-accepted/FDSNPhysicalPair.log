TYPE_BEGIN:MethbokeAddon.FDSN.PHYSICAL_PAIR_ROTATION_PRESERVES_PERIODIC_SPECTRAL_DATA
@MethbokeAddon.FDSN.PHYSICAL_PAIR_ROTATION_PRESERVES_PERIODIC_SPECTRAL_DATA : ∀ {a : SingularClosure.Frequency},
  Ne.{1} a 0 →
    ∀ {z : ℂ},
      Eq.{1} (Norm.norm.{0} z) 1 →
        ∀ {v : SingularClosure.Field},
          ContDiff.{0, 0, 0} ℝ ∞ v →
            SingularClosure.SpatialPeriodic.{0} v →
              (∀ (x : SingularClosure.Vec), Eq.{1} (SingularClosure.divergence v x) 0) →
                ContDiff.{0, 0, 0} ℝ ∞ (MethbokeAddon.FDSN.physicalPairRotation a z v) ∧
                  SingularClosure.SpatialPeriodic.{0} (MethbokeAddon.FDSN.physicalPairRotation a z v) ∧
                    (∀ (x : SingularClosure.Vec),
                        Eq.{1} (SingularClosure.divergence (MethbokeAddon.FDSN.physicalPairRotation a z v) x) 0) ∧
                      Eq.{1} (SingularClosure.spatialMean (MethbokeAddon.FDSN.physicalPairRotation a z v))
                          (SingularClosure.spatialMean v) ∧
                        ∀ (k : SingularClosure.Frequency) (L : LinearMap.{0, 0, 0, 0} (RingHom.id.{0} ℂ) (Fin 3 → ℂ) ℂ),
                          Eq.{1}
                            (Norm.norm.{0}
                              (L (SingularClosure.datumFourierCoeff (MethbokeAddon.FDSN.physicalPairRotation a z v) k)))
                            (Norm.norm.{0} (L (SingularClosure.datumFourierCoeff v k)))
TYPE_END:MethbokeAddon.FDSN.PHYSICAL_PAIR_ROTATION_PRESERVES_PERIODIC_SPECTRAL_DATA
