MethbokeAddon.FDSN.smooth_corrections_imply_smallness : ∀ (a b ε : ℝ),
  LE.le.{0} a b →
    ∀ (u F : SingularClosure.Velocity) (U G : ℝ → SingularClosure.Velocity),
      (ContDiff.{0, 0, 0} ℝ ∞ fun q => HSub.hSub.{0, 0, 0} (U q.1) u q.2.1 q.2.2) →
        (ContDiff.{0, 0, 0} ℝ ∞ fun q => HSub.hSub.{0, 0, 0} (G q.1) F q.2.1 q.2.2) →
          Eq.{1} (U 0) u → Eq.{1} (G 0) F → MethbokeAddon.FDSN.SmoothSmallness a b ε u F U G
TYPE_END:MethbokeAddon.FDSN.smooth_corrections_imply_smallness
