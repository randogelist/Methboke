    ∀ {tstar tzero : ℝ},
      Ne.{1} tzero tstar →
        Ne.{1} (ρ tzero) 0 → Ne.{1} (deriv.{0, 0} (MethbokeAddon.FDSNR3.crossingTimePhase ρ tstar tzero) tzero) 0
TYPE_END:MethbokeAddon.FDSNR3.crossingTimePhase_deriv_ne_zero
