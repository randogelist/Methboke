TYPE_BEGIN:MethbokeAddon.FDSNR3.exists_nearby_nonzero_crossing_time
@MethbokeAddon.FDSNR3.exists_nearby_nonzero_crossing_time : ∀ {a b tstar : ℝ},
  LT.lt.{0} a tstar →
    LT.lt.{0} tstar b →
      ∀ {ρ : ℝ → ℝ},
        ContinuousAt.{0, 0} ρ tstar →
          Eq.{1} (ρ tstar) 1 →
            ∀ {c : ℝ → ℂ},
              ContinuousAt.{0, 0} c tstar →
                Ne.{1} (c tstar) 0 →
                  ∃ tzero,
                    Membership.mem.{0, 0} (Set.Ioo.{0} a b) tzero ∧
                      Ne.{1} tzero tstar ∧ Ne.{1} (ρ tzero) 0 ∧ Ne.{1} (c tzero) 0
TYPE_END:MethbokeAddon.FDSNR3.exists_nearby_nonzero_crossing_time
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.exists_nearby_nonzero_crossing_time
'MethbokeAddon.FDSNR3.exists_nearby_nonzero_crossing_time' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.exists_nearby_nonzero_crossing_time
TYPE_BEGIN:MethbokeAddon.FDSNR3.exists_signed_crossing_time_phase
@MethbokeAddon.FDSNR3.exists_signed_crossing_time_phase : ∀ {a b tstar : ℝ},
  LT.lt.{0} a tstar →
    LT.lt.{0} tstar b →
      ∀ {c : ℝ → ℂ},
        ContinuousAt.{0, 0} c tstar →
          Ne.{1} (c tstar) 0 →
            ∃ tzero β slope,
              Membership.mem.{0, 0} (Set.Ioo.{0} a b) tzero ∧
                Ne.{1} tzero tstar ∧
                  Ne.{1} (c tzero) 0 ∧
                    ContDiff.{0, 0, 0} ℝ ∞ β ∧
                      HasCompactSupport.{0, 0} β ∧
                        tsupport.{0, 0} β ⊆ Set.Ioo.{0} a b ∧
                          Eq.{1} (β tstar) 1 ∧ Eq.{1} (β tzero) 0 ∧ HasDerivAt.{0, 0} β slope tzero ∧ Ne.{1} slope 0
TYPE_END:MethbokeAddon.FDSNR3.exists_signed_crossing_time_phase
AXIOMS_BEGIN:MethbokeAddon.FDSNR3.exists_signed_crossing_time_phase
'MethbokeAddon.FDSNR3.exists_signed_crossing_time_phase' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.FDSNR3.exists_signed_crossing_time_phase
