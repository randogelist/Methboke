TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.physical_inner_young
MethbokeAddon.EhrenfestObstruction.physical_inner_young : ∀ (δ : ℝ),
  LT.lt.{0} 0 δ →
    ∀ (a b : SingularClosure.Vec),
      LE.le.{0} (HMul.hMul.{0, 0, 0} (-2) (Inner.inner.{0, 0} ℝ a b))
        (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} δ (HPow.hPow.{0, 0, 0} (Norm.norm.{0} a) 2))
          (HDiv.hDiv.{0, 0, 0} (HPow.hPow.{0, 0, 0} (Norm.norm.{0} b) 2) δ))
TYPE_END:MethbokeAddon.EhrenfestObstruction.physical_inner_young
