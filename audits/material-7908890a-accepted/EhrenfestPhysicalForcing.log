TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.FINITE_ERROR_ABSORPTION_FROM_PHYSICAL
MethbokeAddon.EhrenfestObstruction.FINITE_ERROR_ABSORPTION_FROM_PHYSICAL : ∃ C,
  LT.lt.{0} 0 C ∧
    ∀ (ν : ℝ),
      LT.lt.{0} 0 ν →
        ∀ (N : ℕ) (c : SingularClosure.FourierCoeff),
          (∀ k ∉ SingularClosure.cutoffModes N, ∀ (i : Fin 3), Eq.{1} (c k i) 0) →
            SingularClosure.SpectralReality c →
              SingularClosure.SpectralSolenoidal c →
                LE.le.{0} (HMul.hMul.{0, 0, 0} (-2) (SingularClosure.coefficientEnstrophyNonlinearPower N c))
                  (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} ν (SingularClosure.coefficientLaplacianSquare N c))
                    (HMul.hMul.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} C (HPow.hPow.{0, 0, 0} ν 3))
                      (HPow.hPow.{0, 0, 0} (SingularClosure.coefficientDissipation N c) 3)))
TYPE_END:MethbokeAddon.EhrenfestObstruction.FINITE_ERROR_ABSORPTION_FROM_PHYSICAL
AXIOMS_BEGIN:MethbokeAddon.EhrenfestObstruction.FINITE_ERROR_ABSORPTION_FROM_PHYSICAL
