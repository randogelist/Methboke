TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.PHYSICAL_FORCED_ERROR_ENSTROPHY_INEQUALITY
MethbokeAddon.EhrenfestObstruction.PHYSICAL_FORCED_ERROR_ENSTROPHY_INEQUALITY : ∃ C,
  LT.lt.{0} 0 C ∧
    ∀ (ν : ℝ),
      LT.lt.{0} 0 ν →
        ∀ (N : ℕ) (c : ℝ → SingularClosure.FourierCoeff) (F : SingularClosure.Field),
          Continuous.{0, 0} F →
            ∀ (s : Set.{0} ℝ) (t : ℝ),
              (∀ k ∉ SingularClosure.cutoffModes N, ∀ (i : Fin 3), Eq.{1} (c t k i) 0) →
                SingularClosure.SpectralReality (c t) →
                  SingularClosure.SpectralSolenoidal (c t) →
                    (∀ (k : SingularClosure.Frequency),
                        Membership.mem.{0, 0} (SingularClosure.cutoffModes N) k →
                          ∀ (i : Fin 3),
                            HasDerivWithinAt.{0, 0} (fun r => c r k i)
                              (HAdd.hAdd.{0, 0, 0} (SingularClosure.galerkinRhs ν N (c t) k i)
                                (SingularClosure.cutoffCoeff N
                                  (fun l => SingularClosure.coefficientLeray l (SingularClosure.datumFourierCoeff F l))
                                  k i))
                              s t) →
                      ∃ d,
                        HasDerivWithinAt.{0, 0} (fun r => SingularClosure.coefficientDissipation N (c r)) d s t ∧
                          LE.le.{0}
                            (HAdd.hAdd.{0, 0, 0} d
                              (HMul.hMul.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} ν 2)
                                (SingularClosure.coefficientLaplacianSquare N (c t))))
                            (HAdd.hAdd.{0, 0, 0}
                              (HMul.hMul.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} C (HPow.hPow.{0, 0, 0} ν 3))
                                (HPow.hPow.{0, 0, 0} (SingularClosure.coefficientDissipation N (c t)) 3))
                              (HMul.hMul.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} 2 ν)
                                (∫ (x : SingularClosure.Vec) in SingularClosure.unitCube,
                                  HPow.hPow.{0, 0, 0} (Norm.norm.{0} (F x)) 2)))
TYPE_END:MethbokeAddon.EhrenfestObstruction.PHYSICAL_FORCED_ERROR_ENSTROPHY_INEQUALITY
AXIOMS_BEGIN:MethbokeAddon.EhrenfestObstruction.PHYSICAL_FORCED_ERROR_ENSTROPHY_INEQUALITY
'MethbokeAddon.EhrenfestObstruction.PHYSICAL_FORCED_ERROR_ENSTROPHY_INEQUALITY' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.EhrenfestObstruction.PHYSICAL_FORCED_ERROR_ENSTROPHY_INEQUALITY
