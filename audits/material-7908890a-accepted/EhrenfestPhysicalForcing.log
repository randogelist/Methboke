TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.dissipationRatePairing_fourier_eq_physical
MethbokeAddon.EhrenfestObstruction.dissipationRatePairing_fourier_eq_physical : ∀ (N : ℕ)
  (c : SingularClosure.FourierCoeff) (F : SingularClosure.Field),
  Continuous.{0, 0} F →
    Eq.{1} (MethbokeAddon.EhrenfestObstruction.dissipationRatePairing N c (SingularClosure.datumFourierCoeff F))
      (HMul.hMul.{0, 0, 0} (-2)
        (∫ (x : SingularClosure.Vec) in SingularClosure.unitCube,
          Inner.inner.{0, 0} ℝ (SingularClosure.laplacian (SingularClosure.finiteSynthesis N c) x) (F x)))
