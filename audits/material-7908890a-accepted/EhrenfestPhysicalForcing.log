TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.dissipationRatePairing_projected_forcing_le
MethbokeAddon.EhrenfestObstruction.dissipationRatePairing_projected_forcing_le : ∀ (δ : ℝ),
  LT.lt.{0} 0 δ →
    ∀ (N : ℕ) (c : SingularClosure.FourierCoeff),
      SingularClosure.SpectralReality c →
        SingularClosure.SpectralSolenoidal c →
          ∀ (F : SingularClosure.Field),
            Continuous.{0, 0} F →
              LE.le.{0}
                (MethbokeAddon.EhrenfestObstruction.dissipationRatePairing N c
                  (SingularClosure.cutoffCoeff N fun k =>
                    SingularClosure.coefficientLeray k (SingularClosure.datumFourierCoeff F k)))
                (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} δ (SingularClosure.coefficientLaplacianSquare N c))
                  (HDiv.hDiv.{0, 0, 0}
                    (∫ (x : SingularClosure.Vec) in SingularClosure.unitCube,
                      HPow.hPow.{0, 0, 0} (Norm.norm.{0} (F x)) 2)
                    δ))
TYPE_END:MethbokeAddon.EhrenfestObstruction.dissipationRatePairing_projected_forcing_le
