MethbokeAddon.EhrenfestObstruction.physical_integral_inner_young : ∀ (δ : ℝ),
  LT.lt.{0} 0 δ →
    ∀ (a b : SingularClosure.Field),
      Continuous.{0, 0} a →
        Continuous.{0, 0} b →
          LE.le.{0}
            (HMul.hMul.{0, 0, 0} (-2)
              (∫ (x : SingularClosure.Vec) in SingularClosure.unitCube, Inner.inner.{0, 0} ℝ (a x) (b x)))
            (HAdd.hAdd.{0, 0, 0}
              (HMul.hMul.{0, 0, 0} δ
                (∫ (x : SingularClosure.Vec) in SingularClosure.unitCube, HPow.hPow.{0, 0, 0} (Norm.norm.{0} (a x)) 2))
              (HDiv.hDiv.{0, 0, 0}
                (∫ (x : SingularClosure.Vec) in SingularClosure.unitCube, HPow.hPow.{0, 0, 0} (Norm.norm.{0} (b x)) 2)
                δ))
TYPE_END:MethbokeAddon.EhrenfestObstruction.physical_integral_inner_young
