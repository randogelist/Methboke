        (Real.exp (HMul.hMul.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 C) 1) s)))
    (HMul.hMul.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 C) 1)
      (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 epsilon)
        (Real.exp (HMul.hMul.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 C) 1) t))))
    t
