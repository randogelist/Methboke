@MethbokeAddon.EhrenfestObstruction.guarded_cubic_small_forcing_bound : ∀ {D d : ℝ → ℝ} {C epsilon T : ℝ},
  LE.le.{0} 0 C →
    LT.lt.{0} 0 epsilon →
      LE.le.{0}
          (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 epsilon)
            (Real.exp (HMul.hMul.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 C) 1) T)))
          1 →
        ContinuousOn.{0, 0} D (Set.Icc.{0} 0 T) →
          LE.le.{0} (D 0) 0 →
            (∀ (t : ℝ), Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t → HasDerivWithinAt.{0, 0} D (d t) (Set.Ici.{0} 0) t) →
              (∀ (t : ℝ),
                  Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
                    LE.le.{0} (D t) 1 →
                      LE.le.{0} (d t)
                        (HAdd.hAdd.{0, 0, 0}
                          (HMul.hMul.{0, 0, 0} C (HAdd.hAdd.{0, 0, 0} (D t) (HPow.hPow.{0, 0, 0} (D t) 3))) epsilon)) →
                ∀ (t : ℝ),
                  Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                    LE.le.{0} (D t)
                        (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 epsilon)
                          (Real.exp (HMul.hMul.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 C) 1) t))) ∧
                      LE.le.{0} (D t) 1
