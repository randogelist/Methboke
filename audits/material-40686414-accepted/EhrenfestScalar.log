TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.terminal_le_of_rate_le
MethbokeAddon.EhrenfestObstruction.terminal_le_of_rate_le : ∀ (v rate : ℝ → ℝ) (T gamma : ℝ),
  LT.lt.{0} 0 T →
    ContinuousOn.{0, 0} v (Set.Icc.{0} 0 T) →
      (∀ (t : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) t → HasDerivAt.{0, 0} v (rate t) t) →
        (∀ (t : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) t → LE.le.{0} (rate t) (Neg.neg.{0} gamma)) →
          LE.le.{0} (v T) (HSub.hSub.{0, 0, 0} (v 0) (HMul.hMul.{0, 0, 0} gamma T))
TYPE_END:MethbokeAddon.EhrenfestObstruction.terminal_le_of_rate_le
