TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.stopped_scalar_le_by_deadline
MethbokeAddon.EhrenfestObstruction.stopped_scalar_le_by_deadline : ∀ (v rate : ℝ → ℝ) (gamma r : ℝ),
  LT.lt.{0} 0 gamma →
    LT.lt.{0} 0 r →
      LT.lt.{0} r (v 0) →
        LE.le.{0} (v 0) 1 →
          ContinuousOn.{0, 0} v (Set.Icc.{0} 0 (HDiv.hDiv.{0, 0, 0} 1 gamma)) →
            (∀ (t : ℝ),
                LE.le.{0} 0 t →
                  LT.lt.{0} t (HDiv.hDiv.{0, 0, 0} 1 gamma) →
                    (∀ (s : ℝ), LE.le.{0} 0 s → LE.le.{0} s t → LT.lt.{0} r (v s)) →
                      HasDerivWithinAt.{0, 0} v (rate t) (Set.Ici.{0} 0) t ∧ LE.le.{0} (rate t) (Neg.neg.{0} gamma)) →
              ∃ t,
                Membership.mem.{0, 0} (Set.Icc.{0} 0 (HDiv.hDiv.{0, 0, 0} (HSub.hSub.{0, 0, 0} (v 0) r) gamma)) t ∧
                  LE.le.{0} (v t) r
TYPE_END:MethbokeAddon.EhrenfestObstruction.stopped_scalar_le_by_deadline
