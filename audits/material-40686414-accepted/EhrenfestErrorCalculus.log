TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.dissipationRatePairing_galerkinRhs
MethbokeAddon.EhrenfestObstruction.dissipationRatePairing_galerkinRhs : ∀ (ν : ℝ) (N : ℕ)
  (c : SingularClosure.FourierCoeff),
  Eq.{1} (MethbokeAddon.EhrenfestObstruction.dissipationRatePairing N c (SingularClosure.galerkinRhs ν N c))
    (HSub.hSub.{0, 0, 0}
      (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} (-2) ν) (SingularClosure.coefficientLaplacianSquare N c))
      (HMul.hMul.{0, 0, 0} 2 (SingularClosure.coefficientEnstrophyNonlinearPower N c)))
TYPE_END:MethbokeAddon.EhrenfestObstruction.dissipationRatePairing_galerkinRhs
