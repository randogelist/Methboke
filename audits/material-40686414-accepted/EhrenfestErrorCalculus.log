TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.forced_coefficient_dissipation_identity
MethbokeAddon.EhrenfestObstruction.forced_coefficient_dissipation_identity : ∀ (ν : ℝ) (N : ℕ)
  (c : ℝ → SingularClosure.FourierCoeff) (f : SingularClosure.FourierCoeff) {s : Set.{0} ℝ} {t : ℝ},
  (∀ (k : SingularClosure.Frequency),
      Membership.mem.{0, 0} (SingularClosure.cutoffModes N) k →
        ∀ (i : Fin 3),
          HasDerivWithinAt.{0, 0} (fun r => c r k i)
            (HAdd.hAdd.{0, 0, 0} (SingularClosure.galerkinRhs ν N (c t) k i) (f k i)) s t) →
    HasDerivWithinAt.{0, 0} (fun r => SingularClosure.coefficientDissipation N (c r))
      (HAdd.hAdd.{0, 0, 0}
        (HSub.hSub.{0, 0, 0}
          (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} (-2) ν) (SingularClosure.coefficientLaplacianSquare N (c t)))
          (HMul.hMul.{0, 0, 0} 2 (SingularClosure.coefficientEnstrophyNonlinearPower N (c t))))
        (MethbokeAddon.EhrenfestObstruction.dissipationRatePairing N (c t) f))
      s t
TYPE_END:MethbokeAddon.EhrenfestObstruction.forced_coefficient_dissipation_identity
