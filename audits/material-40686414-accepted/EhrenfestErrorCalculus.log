TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.coefficient_dissipation_hasDerivWithinAt
MethbokeAddon.EhrenfestObstruction.coefficient_dissipation_hasDerivWithinAt : ∀ (N : ℕ)
  (c : ℝ → SingularClosure.FourierCoeff) (d : SingularClosure.FourierCoeff) {s : Set.{0} ℝ} {t : ℝ},
  (∀ (k : SingularClosure.Frequency),
      Membership.mem.{0, 0} (SingularClosure.cutoffModes N) k →
        ∀ (i : Fin 3), HasDerivWithinAt.{0, 0} (fun r => c r k i) (d k i) s t) →
    HasDerivWithinAt.{0, 0} (fun r => SingularClosure.coefficientDissipation N (c r))
      (MethbokeAddon.EhrenfestObstruction.dissipationRatePairing N (c t) d) s t
TYPE_END:MethbokeAddon.EhrenfestObstruction.coefficient_dissipation_hasDerivWithinAt
AXIOMS_BEGIN:MethbokeAddon.EhrenfestObstruction.coefficient_dissipation_hasDerivWithinAt
'MethbokeAddon.EhrenfestObstruction.coefficient_dissipation_hasDerivWithinAt' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.EhrenfestObstruction.coefficient_dissipation_hasDerivWithinAt
TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.coefficient_error_dissipation_hasDerivWithinAt
MethbokeAddon.EhrenfestObstruction.coefficient_error_dissipation_hasDerivWithinAt : ∀ (N : ℕ)
  (c v : ℝ → SingularClosure.FourierCoeff) (dc dv : SingularClosure.FourierCoeff) {s : Set.{0} ℝ} {t : ℝ},
  (∀ (k : SingularClosure.Frequency),
      Membership.mem.{0, 0} (SingularClosure.cutoffModes N) k →
        ∀ (i : Fin 3), HasDerivWithinAt.{0, 0} (fun r => c r k i) (dc k i) s t) →
    (∀ (k : SingularClosure.Frequency),
        Membership.mem.{0, 0} (SingularClosure.cutoffModes N) k →
          ∀ (i : Fin 3), HasDerivWithinAt.{0, 0} (fun r => v r k i) (dv k i) s t) →
      HasDerivWithinAt.{0, 0} (fun r => SingularClosure.coefficientDissipation N (HSub.hSub.{0, 0, 0} (c r) (v r)))
        (MethbokeAddon.EhrenfestObstruction.dissipationRatePairing N (HSub.hSub.{0, 0, 0} (c t) (v t))
          (HSub.hSub.{0, 0, 0} dc dv))
        s t
TYPE_END:MethbokeAddon.EhrenfestObstruction.coefficient_error_dissipation_hasDerivWithinAt
