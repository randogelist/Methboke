 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.local_front_exists_global_test_on_compact
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.local_test_timeDerivative_eq_of_eventuallyEq
@MethbokeAddon.WeakFouriermanB.local_test_timeDerivative_eq_of_eventuallyEq : ∀ {φ u : SingularClosure.Velocity}
  {r : ℝ},
  Filter.EventuallyEq.{0, 0} (nhds.{0} r) φ u →
    ∀ (x : SingularClosure.Vec), Eq.{1} (SingularClosure.timeDerivative φ r x) (SingularClosure.timeDerivative u r x)
TYPE_END:MethbokeAddon.WeakFouriermanB.local_test_timeDerivative_eq_of_eventuallyEq
