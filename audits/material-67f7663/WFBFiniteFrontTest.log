AXIOMS_END:MethbokeAddon.WeakFouriermanB.finiteFrontTimeClamp_mem_Ioo
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.local_front_exists_global_test_through
MethbokeAddon.WeakFouriermanB.local_front_exists_global_test_through : ∀ (ν T : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.LocalPhysicalNSEFront ν T a u p →
    ∀ (t : ℝ),
      LT.lt.{0} 0 t →
        LT.lt.{0} t T →
          ∃ φ,
            SingularClosure.CriticalPositiveSolenoidalTest φ ∧
              (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioc.{0} 0 t) r → Filter.EventuallyEq.{0, 0} (nhds.{0} r) φ u) ∧
                Filter.EventuallyEq.{0, 0} (nhds.{0} 0) φ u
TYPE_END:MethbokeAddon.WeakFouriermanB.local_front_exists_global_test_through
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.local_front_exists_global_test_through
'MethbokeAddon.WeakFouriermanB.local_front_exists_global_test_through' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.local_front_exists_global_test_through
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.local_front_exists_global_test_on_compact
MethbokeAddon.WeakFouriermanB.local_front_exists_global_test_on_compact : ∀ (ν T : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.LocalPhysicalNSEFront ν T a u p →
    ∀ (s t : ℝ),
      LT.lt.{0} 0 s →
        LE.le.{0} s t →
          LT.lt.{0} t T →
            ∃ φ,
              SingularClosure.CriticalPositiveSolenoidalTest φ ∧
                ∀ (r : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} s t) r → Filter.EventuallyEq.{0, 0} (nhds.{0} r) φ u
TYPE_END:MethbokeAddon.WeakFouriermanB.local_front_exists_global_test_on_compact
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.local_front_exists_global_test_on_compact
