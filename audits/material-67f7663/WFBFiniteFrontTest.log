TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.finiteFrontTimeClamp_mem_Ioo
@MethbokeAddon.WeakFouriermanB.finiteFrontTimeClamp_mem_Ioo : ∀ {c T : ℝ} (b : ContDiffBump.{0} 0),
  Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) c →
    LT.lt.{0} (ContDiffBump.rOut.{0} b) T →
      ∀ (r : ℝ),
        LT.lt.{0} 0 r →
          Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) (MethbokeAddon.WeakFouriermanB.finiteFrontTimeClamp c b r)
TYPE_END:MethbokeAddon.WeakFouriermanB.finiteFrontTimeClamp_mem_Ioo
