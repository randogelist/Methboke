TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.continuous_periodic_field_eq_of_cube_ae
@MethbokeAddon.WeakFouriermanB.continuous_periodic_field_eq_of_cube_ae : ∀ {u v : SingularClosure.Field},
  Continuous.{0, 0} u →
    Continuous.{0, 0} v →
      SingularClosure.SpatialPeriodic.{0} u →
        SingularClosure.SpatialPeriodic.{0} v →
          u =ᵐ[MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0} SingularClosure.unitCube] v →
            Eq.{1} u v
TYPE_END:MethbokeAddon.WeakFouriermanB.continuous_periodic_field_eq_of_cube_ae
