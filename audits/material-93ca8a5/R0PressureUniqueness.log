@MethbokeAddon.WeakFouriermanB.normalized_pressure_eq_of_gradient_eq : ∀ {p q : SingularClosure.Vec → ℝ},
  ContDiff.{0, 0, 0} ℝ ∞ p →
    ContDiff.{0, 0, 0} ℝ ∞ q →
      SingularClosure.PressureMeanZero p →
