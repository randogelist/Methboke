@MethbokeAddon.WeakFouriermanB.timeDerivative_eq_on_open_velocity_overlap : ∀ {u v : SingularClosure.Velocity}
  {I : Set.{0} ℝ},
  IsOpen.{0} I →
    (∀ (t : ℝ), Membership.mem.{0, 0} I t → Eq.{1} (u t) (v t)) →
