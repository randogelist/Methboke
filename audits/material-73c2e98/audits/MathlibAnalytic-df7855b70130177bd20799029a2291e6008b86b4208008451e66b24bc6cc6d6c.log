TYPE_BEGIN:HasFPowerSeriesOnBall.uniform_geometric_approx
@HasFPowerSeriesOnBall.uniform_geometric_approx.{u_1, u_2,
    u_3} : ∀ {𝕜 : Type u_1} {E : Type u_2} {F : Type u_3} [inst : NontriviallyNormedField.{u_1} 𝕜]
  [inst_1 : NormedAddCommGroup.{u_2} E] [inst_2 : NormedSpace.{u_1, u_2} 𝕜 E] [inst_3 : NormedAddCommGroup.{u_3} F]
  [inst_4 : NormedSpace.{u_1, u_3} 𝕜 F] {f : E → F} {p : FormalMultilinearSeries.{u_1, u_2, u_3} 𝕜 E F} {x : E}
  {r : ENNReal} {r' : NNReal},
  HasFPowerSeriesOnBall.{u_1, u_2, u_3} f p x r →
    LT.lt.{0} (↑r') r →
      ∃ a,
        Membership.mem.{0, 0} (Set.Ioo.{0} 0 1) a ∧
          ∃ C,
            GT.gt.{0} C 0 ∧
              ∀ (y : E),
                Membership.mem.{u_2, u_2} (Metric.ball.{u_2} 0 ↑r') y →
                  ∀ (n : ℕ),
                    LE.le.{0}
                      (norm.{u_3}
                        (HSub.hSub.{u_3, u_3, u_3} (f (HAdd.hAdd.{u_2, u_2, u_2} x y))
                          (FormalMultilinearSeries.partialSum.{u_1, u_2, u_3} p n y)))
                      (HMul.hMul.{0, 0, 0} C (HPow.hPow.{0, 0, 0} a n))
TYPE_END:HasFPowerSeriesOnBall.uniform_geometric_approx
