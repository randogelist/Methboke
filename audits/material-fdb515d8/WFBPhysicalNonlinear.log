 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_REAL_BOUND
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_ABSORPTION
MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_ABSORPTION : ∃ C,
  LT.lt.{0} 0 C ∧
    ∀ (ν : ℝ),
      LT.lt.{0} 0 ν →
        ∀ (v : SingularClosure.Field),
          ContDiff.{0, 0, 0} ℝ ∞ v →
            SingularClosure.SpatialPeriodic.{0} v →
              SingularClosure.MeanZero v →
                LE.le.{0}
                  (HMul.hMul.{0, 0, 0} 2
                    (∫ (x : SingularClosure.Vec) in SingularClosure.unitCube,
                      Inner.inner.{0, 0} ℝ (SingularClosure.convection v x) (SingularClosure.laplacian v x)))
                  (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} ν (MethbokeAddon.WeakFouriermanB.physicalLaplacianSquare v))
                    (HMul.hMul.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} C (HPow.hPow.{0, 0, 0} ν 3))
                      (HPow.hPow.{0, 0, 0} (SingularClosure.physicalDissipation v) 3)))
TYPE_END:MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_ABSORPTION
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_ABSORPTION
'MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_ABSORPTION' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_ABSORPTION
