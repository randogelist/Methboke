TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_THREE_QUARTER_BOUND
MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_THREE_QUARTER_BOUND : ∃ C,
  LT.lt.{0} C ∞ ∧
    ∀ (v : SingularClosure.Field),
      ContDiff.{0, 0, 0} ℝ ∞ v →
        SingularClosure.SpatialPeriodic.{0} v →
          SingularClosure.MeanZero v →
            LE.le.{0}
              (ENNReal.ofReal
                (abs.{0}
                  (∫ (x : SingularClosure.Vec) in SingularClosure.unitCube,
                    Inner.inner.{0, 0} ℝ (SingularClosure.convection v x) (SingularClosure.laplacian v x))))
              (HMul.hMul.{0, 0, 0}
                (HMul.hMul.{0, 0, 0} C
                  (HPow.hPow.{0, 0, 0} (ENNReal.ofReal (SingularClosure.physicalDissipation v)) (3 / 4)))
                (HPow.hPow.{0, 0, 0} (ENNReal.ofReal (MethbokeAddon.WeakFouriermanB.physicalLaplacianSquare v))
                  (3 / 4)))
TYPE_END:MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_THREE_QUARTER_BOUND
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_THREE_QUARTER_BOUND
'MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_THREE_QUARTER_BOUND' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_THREE_QUARTER_BOUND
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_REAL_BOUND
MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_REAL_BOUND : ∃ K,
  LE.le.{0} 0 K ∧
    ∀ (v : SingularClosure.Field),
      ContDiff.{0, 0, 0} ℝ ∞ v →
        SingularClosure.SpatialPeriodic.{0} v →
          SingularClosure.MeanZero v →
            LE.le.{0}
              (abs.{0}
                (∫ (x : SingularClosure.Vec) in SingularClosure.unitCube,
                  Inner.inner.{0, 0} ℝ (SingularClosure.convection v x) (SingularClosure.laplacian v x)))
              (HMul.hMul.{0, 0, 0}
                (HMul.hMul.{0, 0, 0} K (HPow.hPow.{0, 0, 0} (SingularClosure.physicalDissipation v) (3 / 4)))
                (HPow.hPow.{0, 0, 0} (MethbokeAddon.WeakFouriermanB.physicalLaplacianSquare v) (3 / 4)))
TYPE_END:MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_REAL_BOUND
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.PHYSICAL_NONLINEAR_REAL_BOUND
