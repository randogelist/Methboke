TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.local_sobolevScale_contDiffOn_nat
MethbokeAddon.WeakFouriermanB.local_sobolevScale_contDiffOn_nat : ∀ (T : ℝ),
  LT.lt.{0} 0 T →
    ∀ (U : (m : ℕ) → ℝ → SingularClosure.TorusSobolev m)
      (F : (m : ℕ) → SingularClosure.TorusSobolev (HAdd.hAdd.{0, 0, 0} m 2) → SingularClosure.TorusSobolev m),
      (∀ (m : ℕ), ContinuousOn.{0, 0} (U m) (Set.Icc.{0} 0 T)) →
        (∀ (m : ℕ), ContDiff.{0, 0, 0} ℝ ∞ (F m)) →
          (∀ (m : ℕ) (t : ℝ),
              Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                HasDerivWithinAt.{0, 0} (U m) (F m (U (HAdd.hAdd.{0, 0, 0} m 2) t)) (Set.Icc.{0} 0 T) t) →
            ∀ (n m : ℕ), ContDiffOn.{0, 0, 0} ℝ (↑n) (U m) (Set.Icc.{0} 0 T)
TYPE_END:MethbokeAddon.WeakFouriermanB.local_sobolevScale_contDiffOn_nat
