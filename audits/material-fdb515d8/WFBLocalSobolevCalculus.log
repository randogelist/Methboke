TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.local_sobolev_hasDerivWithinAt_of_coefficient_integral
MethbokeAddon.WeakFouriermanB.local_sobolev_hasDerivWithinAt_of_coefficient_integral : ∀ (s : ℕ) (T : ℝ),
  LE.le.{0} 0 T →
    ∀ (u r : ℝ → SingularClosure.TorusSobolev s),
      ContinuousOn.{0, 0} r (Set.Icc.{0} 0 T) →
        (∀ (t : ℝ),
            Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
              ∀ (k : SingularClosure.Frequency) (i : Fin 3),
                Eq.{1} (↑(u t) k i) (HAdd.hAdd.{0, 0, 0} (↑(u 0) k i) (∫ (z : ℝ) in 0..t, ↑(r z) k i))) →
          ∀ (t : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t → HasDerivWithinAt.{0, 0} u (r t) (Set.Icc.{0} 0 T) t
TYPE_END:MethbokeAddon.WeakFouriermanB.local_sobolev_hasDerivWithinAt_of_coefficient_integral
