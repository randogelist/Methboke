TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_time_hasDerivAt
MethbokeAddon.WeakFouriermanB.initial_front_time_hasDerivAt : ∀ (ν T : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    ∀ (t : ℝ),
      Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) t →
        ∀ (x : SingularClosure.Vec), HasDerivAt.{0, 0} (fun r => u r x) (SingularClosure.timeDerivative u t x) t
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_front_time_hasDerivAt
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_time_hasDerivAt
'MethbokeAddon.WeakFouriermanB.initial_front_time_hasDerivAt' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.initial_front_time_hasDerivAt
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_timeDerivative_translate
MethbokeAddon.WeakFouriermanB.initial_front_timeDerivative_translate : ∀ (ν T s : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    LE.le.{0} 0 s →
      ∀ (t : ℝ),
        Membership.mem.{0, 0} (Set.Ico.{0} 0 (HSub.hSub.{0, 0, 0} T s)) t →
          ∀ (x : SingularClosure.Vec),
            Eq.{1} (SingularClosure.timeDerivative (fun r => u (HAdd.hAdd.{0, 0, 0} s r)) t x)
              (SingularClosure.timeDerivative u (HAdd.hAdd.{0, 0, 0} s t) x)
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_front_timeDerivative_translate
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_timeDerivative_translate
'MethbokeAddon.WeakFouriermanB.initial_front_timeDerivative_translate' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.initial_front_timeDerivative_translate
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_time_translate
MethbokeAddon.WeakFouriermanB.initial_front_time_translate : ∀ (ν T s : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    LE.le.{0} 0 s →
      MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν (HSub.hSub.{0, 0, 0} T s) (u s)
        (fun t => u (HAdd.hAdd.{0, 0, 0} s t)) fun t => p (HAdd.hAdd.{0, 0, 0} s t)
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_front_time_translate
