TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.initial_front_shift_back_equation
MethbokeAddon.WeakFouriermanB.initial_front_shift_back_equation : ∀ (ν T s : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν T a u p →
    LE.le.{0} 0 s →
      ∀ (t : ℝ),
        Membership.mem.{0, 0} (Set.Ioo.{0} s (HAdd.hAdd.{0, 0, 0} s T)) t →
          ∀ (x : SingularClosure.Vec),
            Eq.{1}
              (HAdd.hAdd.{0, 0, 0}
                (HAdd.hAdd.{0, 0, 0} (SingularClosure.timeDerivative (fun r => u (HSub.hSub.{0, 0, 0} r s)) t x)
                  (SingularClosure.convection (u (HSub.hSub.{0, 0, 0} t s)) x))
                (SingularClosure.gradient (p (HSub.hSub.{0, 0, 0} t s)) x))
              (HSMul.hSMul.{0, 0, 0} ν (SingularClosure.laplacian (u (HSub.hSub.{0, 0, 0} t s)) x))
TYPE_END:MethbokeAddon.WeakFouriermanB.initial_front_shift_back_equation
