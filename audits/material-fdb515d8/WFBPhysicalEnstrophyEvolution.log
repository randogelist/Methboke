MethbokeAddon.WeakFouriermanB.local_physicalDissipation_hasDerivAt : ∀ (u : SingularClosure.Velocity) (T : ℝ),
  ContDiffOn.{0, 0, 0} ℝ ∞ (fun z => u z.1 z.2) (MethbokeAddon.WeakFouriermanB.localFrontSpacetime T) →
    (∀ (r : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) r → SingularClosure.SpatialPeriodic.{0} (u r)) →
      ∀ (t : ℝ),
        Membership.mem.{0, 0} (Set.Ioo.{0} 0 T) t →
          HasDerivAt.{0, 0} (fun r => SingularClosure.physicalDissipation (u r))
            (HMul.hMul.{0, 0, 0} (-2)
              (SingularClosure.physicalFieldInner (SingularClosure.timeDerivative u t)
                (SingularClosure.laplacian (u t))))
            t
