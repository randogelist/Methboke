TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.localCubicTime_pos
@MethbokeAddon.WeakFouriermanB.localCubicTime_pos : ∀ {κ R : ℝ},
  LE.le.{0} 0 κ → LE.le.{0} 0 R → LT.lt.{0} 0 (MethbokeAddon.WeakFouriermanB.localCubicTime κ R)
TYPE_END:MethbokeAddon.WeakFouriermanB.localCubicTime_pos
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.localCubicTime_pos
'MethbokeAddon.WeakFouriermanB.localCubicTime_pos' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.localCubicTime_pos
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.cubic_short_time_barrier
@MethbokeAddon.WeakFouriermanB.cubic_short_time_barrier : ∀ {y d : ℝ → ℝ} {κ R T : ℝ},
  LE.le.{0} 0 κ →
    LE.le.{0} 0 R →
      LE.le.{0} 0 T →
        LE.le.{0} T (MethbokeAddon.WeakFouriermanB.localCubicTime κ R) →
          ContinuousOn.{0, 0} y (Set.Icc.{0} 0 T) →
            LE.le.{0} (y 0) R →
              (∀ (t : ℝ),
                  Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t → HasDerivWithinAt.{0, 0} y (d t) (Set.Ici.{0} 0) t) →
                (∀ (t : ℝ),
                    Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
                      LE.le.{0} (d t) (HMul.hMul.{0, 0, 0} κ (HPow.hPow.{0, 0, 0} (y t) 3))) →
                  ∀ (t : ℝ),
                    Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                      LE.le.{0} (y t) (HMul.hMul.{0, 0, 0} 2 (HAdd.hAdd.{0, 0, 0} R 1))
TYPE_END:MethbokeAddon.WeakFouriermanB.cubic_short_time_barrier
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.cubic_short_time_barrier
'MethbokeAddon.WeakFouriermanB.cubic_short_time_barrier' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.cubic_short_time_barrier
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.cubic_short_time_square_budget
@MethbokeAddon.WeakFouriermanB.cubic_short_time_square_budget : ∀ {y d : ℝ → ℝ} {κ R T : ℝ},
  LE.le.{0} 0 κ →
    LE.le.{0} 0 R →
      LE.le.{0} 0 T →
        LE.le.{0} T (MethbokeAddon.WeakFouriermanB.localCubicTime κ R) →
          ContinuousOn.{0, 0} y (Set.Icc.{0} 0 T) →
            (∀ (t : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t → LE.le.{0} 0 (y t)) →
              LE.le.{0} (y 0) R →
                (∀ (t : ℝ),
                    Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t → HasDerivWithinAt.{0, 0} y (d t) (Set.Ici.{0} 0) t) →
                  (∀ (t : ℝ),
                      Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
                        LE.le.{0} (d t) (HMul.hMul.{0, 0, 0} κ (HPow.hPow.{0, 0, 0} (y t) 3))) →
                    LE.le.{0} (∫ (t : ℝ) in 0..T, HPow.hPow.{0, 0, 0} (y t) 2)
                      (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 4 (HPow.hPow.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} R 1) 2)) T)
TYPE_END:MethbokeAddon.WeakFouriermanB.cubic_short_time_square_budget
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.cubic_short_time_square_budget
'MethbokeAddon.WeakFouriermanB.cubic_short_time_square_budget' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.cubic_short_time_square_budget
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.cubic_short_time_accumulation
@MethbokeAddon.WeakFouriermanB.cubic_short_time_accumulation : ∀ {y z d : ℝ → ℝ} {ν κ R T : ℝ},
  LT.lt.{0} 0 ν →
    LE.le.{0} 0 κ →
      LE.le.{0} 0 R →
        LE.le.{0} 0 T →
          LE.le.{0} T (MethbokeAddon.WeakFouriermanB.localCubicTime κ R) →
            ContinuousOn.{0, 0} y (Set.Icc.{0} 0 T) →
              ContinuousOn.{0, 0} z (Set.Icc.{0} 0 T) →
                ContinuousOn.{0, 0} d (Set.Icc.{0} 0 T) →
                  (∀ (t : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t → LE.le.{0} 0 (y t)) →
                    LE.le.{0} (y 0) R →
                      (∀ (t : ℝ),
                          Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
                            HasDerivWithinAt.{0, 0} y (d t) (Set.Ici.{0} 0) t) →
                        (∀ (t : ℝ),
                            Membership.mem.{0, 0} (Set.Ico.{0} 0 T) t →
                              LE.le.{0}
                                (HAdd.hAdd.{0, 0, 0} (d t) (HMul.hMul.{0, 0, 0} ν (HPow.hPow.{0, 0, 0} (z t) 2)))
                                (HMul.hMul.{0, 0, 0} κ (HPow.hPow.{0, 0, 0} (y t) 3))) →
                          ∀ (t : ℝ),
                            Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                              LE.le.{0}
                                (HAdd.hAdd.{0, 0, 0} (y t)
                                  (HMul.hMul.{0, 0, 0} ν (∫ (s : ℝ) in 0..t, HPow.hPow.{0, 0, 0} (z s) 2)))
                                (HMul.hMul.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} R 1)
                                  (Real.exp
                                    (HMul.hMul.{0, 0, 0} κ
                                      (HMul.hMul.{0, 0, 0}
                                        (HMul.hMul.{0, 0, 0} 4 (HPow.hPow.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} R 1) 2)) T))))
TYPE_END:MethbokeAddon.WeakFouriermanB.cubic_short_time_accumulation
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.cubic_short_time_accumulation
'MethbokeAddon.WeakFouriermanB.cubic_short_time_accumulation' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.cubic_short_time_accumulation
