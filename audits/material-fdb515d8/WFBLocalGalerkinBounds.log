TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_enstrophy_accumulation
MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_enstrophy_accumulation : ∀ (ν R : ℝ),
  LT.lt.{0} 0 ν →
    LE.le.{0} 0 R →
      ∀ (a : SingularClosure.Field),
        SingularClosure.SmoothSigmaZero a →
          LE.le.{0} (SingularClosure.physicalDissipation a) R →
            ∀ (N : ℕ) (g : SingularClosure.GalerkinSolution ν a N) (t : ℝ),
              Membership.mem.{0, 0} (Set.Icc.{0} 0 (MethbokeAddon.WeakFouriermanB.localGalerkinTime ν R)) t →
                LE.le.{0} (SingularClosure.coefficientDissipation N (g.coeff t))
                    (HMul.hMul.{0, 0, 0} 2 (HAdd.hAdd.{0, 0, 0} R 1)) ∧
                  LE.le.{0}
                    (HAdd.hAdd.{0, 0, 0} (SingularClosure.coefficientDissipation N (g.coeff t))
                      (HMul.hMul.{0, 0, 0} ν
                        (∫ (s : ℝ) in 0..t, SingularClosure.coefficientLaplacianSquare N (g.coeff s))))
                    (MethbokeAddon.WeakFouriermanB.localGalerkinAccumulationBound ν R)
TYPE_END:MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_enstrophy_accumulation
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_enstrophy_accumulation
'MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_enstrophy_accumulation' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_enstrophy_accumulation
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_physical_accumulation
MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_physical_accumulation : ∀ (ν R : ℝ),
  LT.lt.{0} 0 ν →
    LE.le.{0} 0 R →
      ∀ (a : SingularClosure.Field),
        SingularClosure.SmoothSigmaZero a →
          LE.le.{0} (SingularClosure.physicalDissipation a) R →
            ∀ (N : ℕ) (g : SingularClosure.GalerkinSolution ν a N) (t : ℝ),
              Membership.mem.{0, 0} (Set.Icc.{0} 0 (MethbokeAddon.WeakFouriermanB.localGalerkinTime ν R)) t →
                LE.le.{0} (SingularClosure.physicalDissipation (g.velocity t))
                    (HMul.hMul.{0, 0, 0} 2 (HAdd.hAdd.{0, 0, 0} R 1)) ∧
                  LE.le.{0}
                    (HAdd.hAdd.{0, 0, 0} (SingularClosure.physicalDissipation (g.velocity t))
                      (HMul.hMul.{0, 0, 0} ν
                        (∫ (s : ℝ) in 0..t,
                          ∫ (x : SingularClosure.Vec) in SingularClosure.unitCube,
                            HPow.hPow.{0, 0, 0} (Norm.norm.{0} (SingularClosure.laplacian (g.velocity s) x)) 2)))
                    (MethbokeAddon.WeakFouriermanB.localGalerkinAccumulationBound ν R)
TYPE_END:MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_physical_accumulation
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_physical_accumulation
'MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_physical_accumulation' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_physical_accumulation
TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_sobolev_bounds
MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_sobolev_bounds : ∀ (ν R : ℝ),
  LT.lt.{0} 0 ν →
    LE.le.{0} 0 R →
      ∀ (a : SingularClosure.Field),
        SingularClosure.SmoothSigmaZero a →
          LE.le.{0} (SingularClosure.physicalDissipation a) R →
            ∀ (N : ℕ) (g : SingularClosure.GalerkinSolution ν a N),
              (∀ (t : ℝ),
                  Membership.mem.{0, 0} (Set.Icc.{0} 0 (MethbokeAddon.WeakFouriermanB.localGalerkinTime ν R)) t →
                    LE.le.{0} (HPow.hPow.{0, 0, 0} (Norm.norm.{0} (g.sobolevState 1 t)) 2)
                      (HMul.hMul.{0, 0, 0} 4 (HAdd.hAdd.{0, 0, 0} R 1))) ∧
                IntervalIntegrable.{0} (fun t => HPow.hPow.{0, 0, 0} (Norm.norm.{0} (g.sobolevState 2 t)) 2)
                    MeasureTheory.MeasureSpace.volume.{0} 0 (MethbokeAddon.WeakFouriermanB.localGalerkinTime ν R) ∧
                  LE.le.{0}
                    (∫ (t : ℝ) in 0..MethbokeAddon.WeakFouriermanB.localGalerkinTime ν R,
                      HPow.hPow.{0, 0, 0} (Norm.norm.{0} (g.sobolevState 2 t)) 2)
                    (HAdd.hAdd.{0, 0, 0}
                      (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 6 (HAdd.hAdd.{0, 0, 0} R 1))
                        (MethbokeAddon.WeakFouriermanB.localGalerkinTime ν R))
                      (HDiv.hDiv.{0, 0, 0} (MethbokeAddon.WeakFouriermanB.localGalerkinAccumulationBound ν R) ν))
TYPE_END:MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_sobolev_bounds
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_sobolev_bounds
'MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_sobolev_bounds' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.galerkin_uniform_local_sobolev_bounds
