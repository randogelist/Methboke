TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.galerkinEnstrophyConstant_bound
MethbokeAddon.WeakFouriermanB.galerkinEnstrophyConstant_bound : ∀ (ν : ℝ),
  LT.lt.{0} 0 ν →
    ∀ (a : SingularClosure.Field) (N : ℕ) (g : SingularClosure.GalerkinSolution ν a N) (t : ℝ),
      LE.le.{0} 0 t →
        ∃ d,
          HasDerivWithinAt.{0, 0} (fun r => SingularClosure.coefficientDissipation N (g.coeff r)) d (Set.Ici.{0} 0) t ∧
            LE.le.{0}
              (HAdd.hAdd.{0, 0, 0} d (HMul.hMul.{0, 0, 0} ν (SingularClosure.coefficientLaplacianSquare N (g.coeff t))))
              (HMul.hMul.{0, 0, 0}
                (HDiv.hDiv.{0, 0, 0} MethbokeAddon.WeakFouriermanB.galerkinEnstrophyConstant (HPow.hPow.{0, 0, 0} ν 3))
                (HPow.hPow.{0, 0, 0} (SingularClosure.coefficientDissipation N (g.coeff t)) 3))
TYPE_END:MethbokeAddon.WeakFouriermanB.galerkinEnstrophyConstant_bound
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.galerkinEnstrophyConstant_bound
'MethbokeAddon.WeakFouriermanB.galerkinEnstrophyConstant_bound' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.WeakFouriermanB.galerkinEnstrophyConstant_bound
