TYPE_BEGIN:MethbokeAddon.WeakFouriermanB.galerkin_local_cubic_inequality
MethbokeAddon.WeakFouriermanB.galerkin_local_cubic_inequality : ∀ (ν : ℝ),
  LT.lt.{0} 0 ν →
    ∀ (a : SingularClosure.Field) (N : ℕ) (g : SingularClosure.GalerkinSolution ν a N) (t : ℝ),
      LE.le.{0} 0 t →
        LE.le.{0}
          (HAdd.hAdd.{0, 0, 0} (SingularClosure.coefficientEnstrophyRate ν N (g.coeff t))
            (HMul.hMul.{0, 0, 0} ν (SingularClosure.coefficientLaplacianSquare N (g.coeff t))))
          (HMul.hMul.{0, 0, 0}
            (HDiv.hDiv.{0, 0, 0} MethbokeAddon.WeakFouriermanB.galerkinEnstrophyConstant (HPow.hPow.{0, 0, 0} ν 3))
            (HPow.hPow.{0, 0, 0} (SingularClosure.coefficientDissipation N (g.coeff t)) 3))
TYPE_END:MethbokeAddon.WeakFouriermanB.galerkin_local_cubic_inequality
AXIOMS_BEGIN:MethbokeAddon.WeakFouriermanB.galerkin_local_cubic_inequality
