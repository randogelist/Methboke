MethbokeAddon.EhrenfestObstruction.finiteReferenceErrorForcing_eq_convection : ∀ (N : ℕ) (U : SingularClosure.Field)
  (c b w : SingularClosure.FourierCoeff),
  ContDiff.{0, 0, 0} ℝ (↑Top.top.{0}) U →
    Eq.{1} c (HAdd.hAdd.{0, 0, 0} w b) →
      Eq.{1} (MethbokeAddon.EhrenfestObstruction.finiteReferenceErrorForcing N U b w)
