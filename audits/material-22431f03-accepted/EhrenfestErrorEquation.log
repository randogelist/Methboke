TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.finiteReferenceErrorForcing_fourier
MethbokeAddon.EhrenfestObstruction.finiteReferenceErrorForcing_fourier : ∀ (N : ℕ) (U : SingularClosure.Field)
  (c b w : SingularClosure.FourierCoeff),
  ContDiff.{0, 0, 0} ℝ (↑Top.top.{0}) U →
    Eq.{1} c (HAdd.hAdd.{0, 0, 0} w b) →
      (∀ k ∉ SingularClosure.cutoffModes N, ∀ (i : Fin 3), Eq.{1} (c k i) 0) →
        SingularClosure.SpectralReality c →
          (∀ k ∉ SingularClosure.cutoffModes N, ∀ (i : Fin 3), Eq.{1} (w k i) 0) →
            SingularClosure.SpectralReality w →
              Eq.{1}
                (SingularClosure.datumFourierCoeff
                  (MethbokeAddon.EhrenfestObstruction.finiteReferenceErrorForcing N U b w))
                (HAdd.hAdd.{0, 0, 0}
                  (HSub.hSub.{0, 0, 0} (SingularClosure.datumFourierCoeff (SingularClosure.convection U))
                    (SingularClosure.coefficientTransport N c))
                  (SingularClosure.coefficientTransport N w))
TYPE_END:MethbokeAddon.EhrenfestObstruction.finiteReferenceErrorForcing_fourier
