TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.finite_error_rhs_identity
MethbokeAddon.EhrenfestObstruction.finite_error_rhs_identity : ∀ (ν : ℝ) (N : ℕ) (U : SingularClosure.Field)
  (c b w : SingularClosure.FourierCoeff),
  ContDiff.{0, 0, 0} ℝ (↑Top.top.{0}) U →
    Eq.{1} c (HAdd.hAdd.{0, 0, 0} w b) →
      (∀ k ∉ SingularClosure.cutoffModes N, ∀ (i : Fin 3), Eq.{1} (c k i) 0) →
        SingularClosure.SpectralReality c →
          (∀ k ∉ SingularClosure.cutoffModes N, ∀ (i : Fin 3), Eq.{1} (w k i) 0) →
            SingularClosure.SpectralReality w →
              ∀ (k : SingularClosure.Frequency),
                Membership.mem.{0, 0} (SingularClosure.cutoffModes N) k →
                  ∀ (i : Fin 3),
                    Eq.{1}
                      (HSub.hSub.{0, 0, 0} (SingularClosure.galerkinRhs ν N c k i)
                        (HSub.hSub.{0, 0, 0}
                          (HMul.hMul.{0, 0, 0}
                            (Neg.neg.{0}
                              ↑(HMul.hMul.{0, 0, 0}
                                  (HMul.hMul.{0, 0, 0} ν (HPow.hPow.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 Real.pi) 2))
                                  ↑(SingularClosure.galerkinFreqSq k)))
                            (b k i))
                          (SingularClosure.coefficientLeray k
                            (SingularClosure.datumFourierCoeff (SingularClosure.convection U) k) i)))
                      (HAdd.hAdd.{0, 0, 0} (SingularClosure.galerkinRhs ν N w k i)
                        (SingularClosure.cutoffCoeff N
                          (fun l =>
                            SingularClosure.coefficientLeray l
                              (SingularClosure.datumFourierCoeff
                                (MethbokeAddon.EhrenfestObstruction.finiteReferenceErrorForcing N U b w) l))
                          k i))
TYPE_END:MethbokeAddon.EhrenfestObstruction.finite_error_rhs_identity
AXIOMS_BEGIN:MethbokeAddon.EhrenfestObstruction.finite_error_rhs_identity
'MethbokeAddon.EhrenfestObstruction.finite_error_rhs_identity' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.EhrenfestObstruction.finite_error_rhs_identity
TYPE_BEGIN:MethbokeAddon.EhrenfestObstruction.initial_front_galerkin_error_hasDerivAt
MethbokeAddon.EhrenfestObstruction.initial_front_galerkin_error_hasDerivAt : ∀ (ν S : ℝ) (a : SingularClosure.Field)
  (u : SingularClosure.Velocity) (p : SingularClosure.Pressure),
  MethbokeAddon.WeakFouriermanB.InitialClassicalFront ν S a u p →
    ∀ (N : ℕ) (g : SingularClosure.GalerkinSolution ν a N) (t : ℝ),
      Membership.mem.{0, 0} (Set.Ioo.{0} 0 S) t →
        ∀ (k : SingularClosure.Frequency),
          Membership.mem.{0, 0} (SingularClosure.cutoffModes N) k →
            ∀ (i : Fin 3),
              HasDerivAt.{0, 0}
                (fun r =>
                  HSub.hSub.{0, 0, 0} (g.coeff r)
                    (SingularClosure.cutoffCoeff N (SingularClosure.datumFourierCoeff (u r))) k i)
                (HAdd.hAdd.{0, 0, 0}
                  (SingularClosure.galerkinRhs ν N
                    (HSub.hSub.{0, 0, 0} (g.coeff t)
                      (SingularClosure.cutoffCoeff N (SingularClosure.datumFourierCoeff (u t))))
                    k i)
                  (SingularClosure.cutoffCoeff N
                    (fun l =>
                      SingularClosure.coefficientLeray l
                        (SingularClosure.datumFourierCoeff
                          (MethbokeAddon.EhrenfestObstruction.finiteReferenceErrorForcing N (u t)
                            (SingularClosure.cutoffCoeff N (SingularClosure.datumFourierCoeff (u t)))
                            (HSub.hSub.{0, 0, 0} (g.coeff t)
                              (SingularClosure.cutoffCoeff N (SingularClosure.datumFourierCoeff (u t)))))
                          l))
                    k i))
                t
TYPE_END:MethbokeAddon.EhrenfestObstruction.initial_front_galerkin_error_hasDerivAt
AXIOMS_BEGIN:MethbokeAddon.EhrenfestObstruction.initial_front_galerkin_error_hasDerivAt
'MethbokeAddon.EhrenfestObstruction.initial_front_galerkin_error_hasDerivAt' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
AXIOMS_END:MethbokeAddon.EhrenfestObstruction.initial_front_galerkin_error_hasDerivAt
